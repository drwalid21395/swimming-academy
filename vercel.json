{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "views/**/*;public/**/*;lib/**/*;routes/**/*;db/**/*;src/**/*"
    }
  },
  "headers": [
    {
      "source": "/css/:path*",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/css/:path*",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }]
    },
    {
      "source": "/js/:path*",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/js/:path*",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }]
    },
    {
      "source": "/vendor/:path*",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/vendor/:path*",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }]
    },
    {
      "source": "/webfonts/:path*",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/webfonts/:path*",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }]
    },
    {
      "source": "/fonts/:path*",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/:path*",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }]
    },
    {
      "source": "/images/:path*",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/:path*",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/expiry-reminders", "schedule": "0 6 * * *" }
  ]
}
