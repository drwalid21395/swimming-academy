{
  "functions": {
    "api/index.js": {
      "includeFiles": "views/**/*;public/**/*;lib/**/*;routes/**/*;db/**/*;src/**/*"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/expiry-reminders", "schedule": "0 6 * * *" }
  ]
}
