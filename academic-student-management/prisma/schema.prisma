generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROFESSOR
  STUDENT
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

/// Granular capabilities an administrator grants to a professor individually.
/// Absence of a row means the capability is denied.
enum ProfessorPermissionKey {
  ATTENDANCE_RECORD
  SUBJECTS_MANAGE
  QUESTIONS_MANAGE
  EXAMS_MANAGE
  RESULTS_VIEW
  ANNOUNCEMENTS_PUBLISH
}

/// Separates the main teaching staff from the assistants working under them.
///
/// An assistant is the same account type on purpose: it reuses the professor
/// portal, the subject scope and the grant table, so the only thing that differs
/// is how much of it the administrator switched on.
enum ProfessorKind {
  PROFESSOR
  ASSISTANT
}

model User {
  id                 String                @id @default(cuid())
  email              String                @unique
  passwordHash       String
  fullName           String
  role               UserRole
  isActive           Boolean               @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  student            Student?
  professor          Professor?
  notifications      Notification[]
  files              File[]                @relation("FileUploader")
  announcements      Announcement[]        @relation("AnnouncementAuthor")
  auditLogs          AuditLog[]
  grantedPermissions ProfessorPermission[] @relation("ProfessorPermissionGrants")
}

model Department {
  id              String           @id @default(cuid())
  name            String           @unique
  code            String           @unique
  description     String?
  headId          String?          @unique
  head            Professor?       @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  students        Student[]
  professors      Professor[]
  subjects        Subject[]
  specializations Specialization[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// A track inside a department. Fourth-year students are allocated to one of
/// these; it stays optional so lower years can leave it empty.
model Specialization {
  id           String     @id @default(cuid())
  name         String
  code         String
  description  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students     Student[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, name])
  @@unique([departmentId, code])
  @@index([departmentId])
}

model Student {
  id               String          @id @default(cuid())
  userId           String          @unique
  universityId     String
  /// The number written in the `رقم المسلسل` column of the uploaded file. Kept
  /// nullable and non-unique on purpose: the column is optional in the template,
  /// and a real roster can repeat or leave it blank, which must not fail an import.
  serial           String?
  phone            String?
  academicYear     Int
  departmentId     String
  specializationId String?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       Department      @relation(fields: [departmentId], references: [id])
  specialization   Specialization? @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  attendance       AttendanceRecord[]
  examAttempts     ExamAttempt[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([departmentId, academicYear])
  @@index([specializationId])
  @@index([universityId])
  @@index([serial])
}

model Professor {
  id           String                @id @default(cuid())
  userId       String                @unique
  employeeCode String                @unique
  phone        String?
  departmentId String
  /// `ASSISTANT` marks a member of the assisting staff working under a supervisor.
  kind         ProfessorKind         @default(PROFESSOR)
  /// The professor an assistant is attached to. Null for the main teaching staff.
  supervisorId String?
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department            @relation(fields: [departmentId], references: [id])
  headOf       Department?           @relation("DepartmentHead")
  subjects     SubjectProfessor[]
  attendance   AttendanceSession[]   @relation("AttendanceCreatedBy")
  exams        Exam[]                @relation("ExamCreatedBy")
  questions    Question[]            @relation("QuestionCreatedBy")
  permissions  ProfessorPermission[] @relation("ProfessorPermissionOwner")
  /// An assistant can never hold a subject its supervisor does not hold, so the
  /// supervisor link is what every scope change is checked against.
  supervisor   Professor?            @relation("ProfessorSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  assistants   Professor[]           @relation("ProfessorSupervisor")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([departmentId])
  @@index([supervisorId])
}

/// One row per granted capability. Revoking deletes the row.
model ProfessorPermission {
  id          String                 @id @default(cuid())
  professorId String
  permission  ProfessorPermissionKey
  grantedById String?
  grantedAt   DateTime               @default(now())
  professor   Professor              @relation("ProfessorPermissionOwner", fields: [professorId], references: [id], onDelete: Cascade)
  grantedBy   User?                  @relation("ProfessorPermissionGrants", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([professorId, permission])
  @@index([professorId])
}

model AcademicTerm {
  id        String    @id @default(cuid())
  name      String    @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean   @default(false)
  subjects  Subject[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Single-row platform identity settings (site name + logo). Row id is always 1.
model SiteSetting {
  id        Int      @id @default(1)
  siteName  String   @default("منصة دكتور وليد عبد الرحمن المجانية")
  siteLogo  String?
  updatedAt DateTime @updatedAt
}

model Subject {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  description     String?
  creditHours     Int                 @default(3)
  attendanceLimit Float               @default(75)
  departmentId    String
  academicTermId  String
  department      Department          @relation(fields: [departmentId], references: [id])
  academicTerm    AcademicTerm        @relation(fields: [academicTermId], references: [id])
  professors      SubjectProfessor[]
  enrollments     Enrollment[]
  attendance      AttendanceSession[]
  exams           Exam[]
  categories      QuestionCategory[]
  questions       Question[]
  announcements   Announcement[]
  files           File[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([departmentId, academicTermId])
}

model SubjectProfessor {
  subjectId   String
  professorId String
  isPrimary   Boolean   @default(false)
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@id([subjectId, professorId])
}

model Enrollment {
  id         String           @id @default(cuid())
  studentId  String
  subjectId  String
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@index([subjectId, status])
}

model AttendanceSession {
  id          String             @id @default(cuid())
  subjectId   String
  createdById String
  date        DateTime           @db.Date
  title       String?
  notes       String?
  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy   Professor          @relation("AttendanceCreatedBy", fields: [createdById], references: [id])
  records     AttendanceRecord[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([subjectId, date])
  @@index([subjectId, date])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus
  reason    String?
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId, status])
}

model Exam {
  id          String         @id @default(cuid())
  subjectId   String
  createdById String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  durationMin Int
  totalScore  Float
  status      ExamStatus     @default(DRAFT)
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy   Professor      @relation("ExamCreatedBy", fields: [createdById], references: [id])
  questions   ExamQuestion[]
  attempts    ExamAttempt[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([subjectId, status, startsAt])
}

model QuestionCategory {
  id        String     @id @default(cuid())
  subjectId String
  name      String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([subjectId, name])
}

model Question {
  id            String            @id @default(cuid())
  subjectId     String
  categoryId    String?
  createdById   String
  text          String
  type          QuestionType
  difficulty    DifficultyLevel   @default(MEDIUM)
  unit          String?
  chapter       String?
  correctAnswer String?
  explanation   String?
  subject       Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  category      QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy     Professor         @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  options       QuestionOption[]
  examQuestions ExamQuestion[]
  answers       ExamAnswer[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([subjectId, type, difficulty])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  position   Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
}

model ExamQuestion {
  examId     String
  questionId String
  position   Int
  score      Float
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([examId, questionId])
  @@unique([examId, position])
}

model ExamAttempt {
  id          String        @id @default(cuid())
  examId      String
  studentId   String
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  score       Float?
  feedback    String?
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     ExamAnswer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([examId, studentId])
  @@index([studentId, status])
}

model ExamAnswer {
  id         String      @id @default(cuid())
  attemptId  String
  questionId String
  answer     String?
  score      Float?
  feedback   String?
  isCorrect  Boolean?
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([attemptId, questionId])
}

model Announcement {
  id          String    @id @default(cuid())
  subjectId   String
  authorId    String
  title       String
  content     String
  isPinned    Boolean   @default(false)
  publishedAt DateTime?
  scheduledAt DateTime?
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  author      User      @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  files       File[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([subjectId, publishedAt])
}

model File {
  id             String        @id @default(cuid())
  subjectId      String?
  announcementId String?
  uploadedById   String
  fileName       String
  storageKey     String        @unique
  mimeType       String
  size           Int
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  uploadedBy     User          @relation("FileUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime      @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  content   String
  link      String?
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
}
