<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= siteName %></title>
  <link rel="stylesheet" href="/vendor/fa-all.min.css">
  <link rel="stylesheet" href="/css/style.css?v=24">
  <link rel="icon" type="image/png" sizes="192x192" href="/images/icon-192.png?v=2">
  <style>
    body { background: var(--bg); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 16px; }
    .pp-wrap { width: 100%; max-width: 720px; }
    .pp-card { background: var(--card); border: 1px solid var(--card-border); border-radius: 18px; padding: 22px; box-shadow: var(--shadow); }
    .pp-title { text-align: center; font-size: 22px; font-weight: 800; margin-bottom: 6px; color: var(--text); }
    .pp-sub { text-align: center; font-size: 13px; color: var(--text-muted); margin-bottom: 18px; }
    .pp-stage { position: relative; background: #0f172a; border-radius: 14px; overflow: hidden; aspect-ratio: 4/3; margin-bottom: 14px; }
    .pp-stage video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pp-idle { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: #fff; text-align: center; padding: 20px; }
    .pp-idle small { opacity: 0.8; max-width: 280px; }
    .pp-frame-wrap { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
    .pp-frame { position: relative; width: 86%; max-width: 460px; aspect-ratio: 2.6 / 1; border-radius: 14px; box-shadow: 0 0 0 100vmax rgba(15,23,42,0.55); border: 2px solid rgba(125,211,252,0.85); }
    .pp-frame::before, .pp-frame::after { content: ''; position: absolute; width: 18px; height: 18px; border: 3px solid #38bdf8; }
    .pp-frame::before { top: -3px; right: -3px; border-left: 0; border-bottom: 0; border-top-right-radius: 10px; }
    .pp-frame::after { bottom: -3px; left: -3px; border-right: 0; border-top: 0; border-bottom-left-radius: 10px; }
    .pp-scan-status { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); background: rgba(15,23,42,0.75); color: #fff; padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; display: flex; align-items: center; gap: 8px; backdrop-filter: blur(4px); white-space: nowrap; z-index: 5; }
    .pp-scan-status::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; animation: pulse-dot 1.2s infinite; }
    @keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.7)} }
    .pp-tools { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 14px; }
    [hidden] { display: none !important; }
    .pp-form { display: flex; gap: 8px; margin-bottom: 14px; }
    .pp-form input { flex: 1; }
    .pp-result { display: none; }
    .pp-section { background: var(--bg-soft); border-radius: 12px; padding: 14px; margin-bottom: 12px; }
    .pp-section h3 { font-size: 14px; color: var(--primary); margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
    .pp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
    .pp-item { background: var(--card); border: 1px solid var(--card-border); border-radius: 10px; padding: 10px 12px; }
    .pp-item .k { font-size: 11px; color: var(--text-muted); margin-bottom: 3px; }
    .pp-item .v { font-size: 15px; font-weight: 700; color: var(--text); }
    .pp-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .pp-stat { text-align: center; background: var(--card); border: 1px solid var(--card-border); border-radius: 10px; padding: 10px; }
    .pp-stat b { display: block; font-size: 18px; }
    .pp-stat span { font-size: 11px; color: var(--text-muted); }
    .pp-empty { text-align: center; color: var(--text-muted); padding: 20px; font-size: 13px; }
    .pp-actions { display: flex; gap: 8px; justify-content: center; margin-top: 16px; flex-wrap: wrap; }
    .pp-score-list { display: flex; flex-direction: column; gap: 8px; }
    .pp-score-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--card); border: 1px solid var(--card-border); border-radius: 10px; padding: 10px 12px; }
    .pp-score-name { font-size: 14px; color: var(--text); }
    .pp-score-val { font-size: 15px; font-weight: 800; color: var(--primary); background: var(--primary-soft); padding: 4px 12px; border-radius: 8px; min-width: 46px; text-align: center; }
    .pp-progress-head { display: flex; align-items: stretch; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
    .pp-progress-box { flex: 1 1 120px; background: var(--card); border: 1px solid var(--card-border); border-radius: 12px; padding: 10px 12px; text-align: center; }
    .pp-progress-box .k { font-size: 11px; color: var(--text-muted); margin-bottom: 4px; }
    .pp-progress-box .v { font-size: 22px; font-weight: 800; line-height: 1.2; }
    .pp-progress-box .d { font-size: 10.5px; color: var(--text-muted); margin-top: 3px; }
    .pp-progress-arrow { align-self: center; color: var(--text-muted); font-size: 18px; }
    .pp-delta { color: #10b981; }
    .pp-delta.down { color: #ef4444; }
    .pp-delta.flat { color: var(--text-muted); }
    .pp-chart-wrap { background: var(--card); border: 1px solid var(--card-border); border-radius: 12px; padding: 8px 6px 2px; }
    .pp-chart { width: 100%; height: auto; display: block; }
    .pp-compare-list { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }
    .pp-compare-row { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 8px; background: var(--card); border: 1px solid var(--card-border); border-radius: 10px; padding: 8px 12px; }
    .pp-compare-name { font-size: 13px; color: var(--text); }
    .pp-compare-nums { display: flex; align-items: center; gap: 6px; font-size: 13px; white-space: nowrap; }
    .pp-compare-nums .first { color: var(--text-muted); }
    .pp-compare-nums .cur { font-weight: 800; color: var(--primary); }
    .pp-compare-delta { font-size: 12px; font-weight: 800; min-width: 42px; text-align: center; padding: 3px 8px; border-radius: 999px; background: rgba(16,185,129,.12); color: #10b981; }
    .pp-compare-delta.down { background: rgba(239,68,68,.12); color: #ef4444; }
    .pp-compare-delta.flat { background: var(--bg-soft); color: var(--text-muted); }
    .pp-note { font-size: 12px; color: var(--text-muted); margin-top: 8px; }
    .pp-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 12px; border: 1px solid var(--card-border); }
    .pp-table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 420px; }
    .pp-table th, .pp-table td { padding: 8px; border-bottom: 1px solid var(--card-border); text-align: right; }
    .pp-table th { color: var(--text-muted); font-weight: 600; background: var(--bg-soft); }
    @media (max-width: 640px) {
      body { padding: 8px; align-items: flex-start; }
      .pp-card { padding: 14px; border-radius: 14px; }
      .pp-title { font-size: 18px; }
      .pp-sub { font-size: 12px; }
      .pp-stage { aspect-ratio: 3/4; }
      .pp-idle { padding: 14px; }
      .pp-idle small { max-width: 240px; }
      .pp-tools { gap: 6px; }
      .pp-form { flex-direction: column; }
      .pp-form button { width: 100%; }
      .pp-grid { grid-template-columns: 1fr; gap: 8px; }
      .pp-stats { grid-template-columns: repeat(2, 1fr); }
      .pp-item { padding: 8px 10px; }
      .pp-item .v { font-size: 14px; }
      .pp-actions .btn { flex: 1 1 100%; }
      .pp-score-row { padding: 8px 10px; }
      .pp-score-name { font-size: 13px; }
      .pp-score-val { font-size: 14px; }
      .pp-progress-head { gap: 6px; }
      .pp-progress-box { flex: 1 1 30%; padding: 8px 6px; }
      .pp-progress-box .v { font-size: 18px; }
      .pp-progress-arrow { font-size: 14px; }
      .pp-compare-row { padding: 7px 9px; gap: 6px; }
      .pp-compare-name { font-size: 12px; }
      .pp-compare-nums { font-size: 12px; }
      .pp-compare-delta { font-size: 11px; min-width: 36px; }
    }
  </style>
</head>
<body>
<div class="pp-wrap">
  <div class="pp-card">
    <div class="pp-title"><i class="fas fa-id-card"></i> بطاقتي</div>
    <div class="pp-sub">امسح باركود بطاقة العضوية لعرض بياناتك والاشتراك والحضور والتقييم</div>

    <div class="pp-stage" id="stage">
      <video id="cam" playsinline autoplay muted></video>
      <div class="pp-frame-wrap" id="frameWrap" hidden>
        <div class="pp-frame" id="frame"></div>
      </div>
      <div class="pp-scan-status" id="scanStatus" hidden>جارٍ المسح... ضع الباركود داخل الإطار</div>
      <div class="pp-idle" id="idle">
        <i class="fas fa-camera-retro fa-2x"></i>
        <p>الكاميرا متوقفة</p>
        <small>اضغط الزر لتشغيل الكاميرا ومسح الباركود، أو أدخل رقم العضوية يدوياً.</small>
        <button type="button" class="btn btn-primary" id="startCam"><i class="fas fa-play"></i> تشغيل الكاميرا</button>
      </div>
    </div>

    <div class="pp-tools">
      <button type="button" class="btn btn-outline" id="stopCam"><i class="fas fa-stop"></i> إيقاف</button>
      <button type="button" class="btn btn-outline" id="capture"><i class="fas fa-camera"></i> لقطة</button>
    </div>

    <form class="pp-form" id="manualForm">
      <input type="text" id="manualCode" class="form-control" placeholder="رقم العضوية (مثال: SW-0001)" autocomplete="off">
      <button type="submit" class="btn btn-primary"><i class="fas fa-magnifying-glass"></i> بحث</button>
    </form>

    <div id="message"></div>

    <div class="pp-result" id="result">
      <div class="pp-actions">
        <a href="#" class="btn btn-primary" id="pdfLink" download><i class="fas fa-file-pdf"></i> تحميل التقرير PDF</a>
        <button type="button" class="btn btn-success" id="shareWa" data-academy="<%= academyName %>"><i class="fab fa-whatsapp"></i> مشاركة البطاقة</button>
        <button type="button" class="btn btn-outline" id="reset"><i class="fas fa-rotate-right"></i> بحث جديد</button>
      </div>
      <canvas id="cardCanvas" hidden></canvas>
      <div id="resultBody"></div>
    </div>
  </div>
</div>

<script src="/vendor/zxing.min.js"></script>
<script>
(function () {
  'use strict';
  var video = document.getElementById('cam');
  var frame = document.getElementById('frame');
  var frameWrap = document.getElementById('frameWrap');
  var scanStatus = document.getElementById('scanStatus');
  var idle = document.getElementById('idle');
  var startBtn = document.getElementById('startCam');
  var stopBtn = document.getElementById('stopCam');
  var captureBtn = document.getElementById('capture');
  var manualForm = document.getElementById('manualForm');
  var manualCode = document.getElementById('manualCode');
  var message = document.getElementById('message');
  var result = document.getElementById('result');
  var resultBody = document.getElementById('resultBody');
  var pdfLink = document.getElementById('pdfLink');
  var resetBtn = document.getElementById('reset');

  var scanning = false;
  var reader = null;
  var stream = null;
  var snapReader = null;
  var snapCanvas = null;
  var currentSwimmer = null;

  function showMsg(html, type) {
    message.innerHTML = '<div class="alert alert-' + (type || 'info') + '">' + html + '</div>';
  }
  function clearMsg() { message.innerHTML = ''; }

  function statusLabel(st) {
    return { present: 'حاضر', absent: 'غائب', excused: 'معتذر', late: 'متأخر' }[st] || st;
  }

  function renderReport(data) {
    var s = data.swimmer;
    currentSwimmer = s || null;
    var r = data.report;
    var html = '';

    html += '<div class="pp-section"><h3><i class="fas fa-user"></i> البيانات الشخصية</h3><div class="pp-grid">';
    html += item('الاسم', s.full_name);
    html += item('رقم العضوية', s.membership_no);
    html += item('تاريخ الميلاد', s.birth_date || '—');
    html += item('النوع', s.gender || '—');
    html += item('البرنامج', s.program_name || '—');
    html += item('المجموعة', s.group_name || '—');
    html += item('الكابتن', s.coach_name || '—');
    html += item('المستوى', s.level_name || '—');
    html += item('حالة اللاعب', s.status || '—');
    if (s.guardian_name) html += item('ولي الأمر', s.guardian_name + (s.guardian_relation ? ' (' + s.guardian_relation + ')' : ''));
    html += '</div></div>';

    html += '<div class="pp-section"><h3><i class="fas fa-user-check"></i> الحضور والغياب</h3>';
    html += '<div class="pp-stats">';
    html += stat(r.stats.present, 'حاضر', 'green');
    html += stat(r.stats.absent, 'غائب', 'red');
    html += stat(r.stats.excused, 'معتذر', 'orange');
    html += stat(r.stats.late, 'متأخر', 'blue');
    html += '</div>';
    if (r.recentAttendance && r.recentAttendance.length) {
      html += '<div class="pp-table-wrap" style="margin-top:10px"><table class="pp-table"><thead><tr><th>التاريخ</th><th>الحصة</th><th>الحالة</th></tr></thead><tbody>';
      r.recentAttendance.forEach(function (a) {
        html += '<tr><td>' + (a.date || '—') + '</td><td>' + (a.title || '—') + '</td><td>' + statusLabel(a.status) + '</td></tr>';
      });
      html += '</tbody></table></div>';
    }
    html += '</div>';

    if (r.subscription) {
      var sub = r.subscription;
      var remainingSessions = (sub.sessions_total || 0) - (sub.sessions_used || 0);
      html += '<div class="pp-section"><h3><i class="fas fa-calendar-check"></i> الاشتراك</h3><div class="pp-grid">';
      html += item('حالة الاشتراك', sub.status || '—');
      html += item('تاريخ البداية', sub.start_date || '—');
      html += item('تاريخ النهاية', sub.end_date || '—');
      html += item('الحصص الكلية', sub.sessions_total || 0);
      html += item('الحصص المستخدمة', sub.sessions_used || 0);
      html += item('الحصص المتبقية', remainingSessions);
      html += item('المبلغ الكلي', formatMoney(sub.total || 0));
      html += item('المسدد', formatMoney(sub.paid_amount || 0));
      html += item('المتبقي', formatMoney(sub.remaining || 0));
      html += '</div></div>';
    }

    if (r.payments && r.payments.length) {
      html += '<div class="pp-section"><h3><i class="fas fa-money-bill-wave"></i> المدفوعات</h3><div class="pp-table-wrap"><table class="pp-table"><thead><tr><th>التاريخ</th><th>المبلغ</th><th>الطريقة</th><th>الإيصال</th></tr></thead><tbody>';
      r.payments.forEach(function (p) {
        html += '<tr><td>' + (p.paid_date || '—') + '</td><td>' + formatMoney(p.amount || 0) + '</td><td>' + (p.method || '—') + '</td><td>' + (p.receipt_no || '—') + '</td></tr>';
      });
      html += '</tbody></table></div></div>';
    }

    if (r.progress && r.progress.first && r.progress.current) {
      var pr = r.progress;
      var deltaCls = pr.delta > 0 ? '' : pr.delta < 0 ? ' down' : ' flat';
      var deltaLabel = pr.delta > 0 ? 'تحسن' : pr.delta < 0 ? 'تراجع' : 'ثابت';
      html += '<div class="pp-section"><h3><i class="fas fa-chart-line"></i> خط التقدم الفني</h3>';
      html += '<div class="pp-progress-head">';
      html += '<div class="pp-progress-box"><div class="k">أول تقييم</div><div class="v">' + (pr.first.percent || 0) + '%</div><div class="d">' + esc(pr.first.date || '—') + (pr.first.level ? ' · ' + esc(pr.first.level) : '') + '</div></div>';
      html += '<div class="pp-progress-arrow"><i class="fas fa-arrow-left-long"></i></div>';
      html += '<div class="pp-progress-box"><div class="k">الوضع الحالي</div><div class="v" style="color:var(--primary)">' + (pr.current.percent || 0) + '%</div><div class="d">' + esc(pr.current.date || '—') + (pr.current.level ? ' · ' + esc(pr.current.level) : '') + '</div></div>';
      html += '<div class="pp-progress-box"><div class="k">الفرق</div><div class="v pp-delta' + deltaCls + '">' + (pr.delta > 0 ? '+' : '') + pr.delta + '%</div><div class="d">' + deltaLabel + '</div></div>';
      html += '</div>';
      html += progressChart(pr.history);
      if ((pr.count || 1) < 2) html += '<div class="pp-note"><i class="fas fa-circle-info"></i> يوجد تقييم واحد فقط حتى الآن — سيظهر خط التقدم بعد إضافة تقييم جديد.</div>';
      if (pr.skills && pr.skills.length) {
        html += '<div class="pp-compare-list">';
        pr.skills.forEach(function (sk) {
          var d = sk.delta;
          var cls = d === null ? ' flat' : d > 0 ? '' : d < 0 ? ' down' : ' flat';
          var txt = d === null ? '—' : (d > 0 ? '+' : '') + d;
          html += '<div class="pp-compare-row"><span class="pp-compare-name">' + esc(sk.name) + '</span>';
          html += '<span class="pp-compare-nums"><span class="first">' + (sk.first === null ? '—' : sk.first) + '</span><i class="fas fa-arrow-left" style="font-size:11px;color:var(--text-muted)"></i><span class="cur">' + (sk.current === null ? '—' : sk.current) + '</span></span>';
          html += '<span class="pp-compare-delta' + cls + '">' + txt + '</span></div>';
        });
        html += '</div>';
        html += '<div class="pp-note">المقارنة بين درجات أول تقييم وآخر تقييم لكل مهارة (من 100).</div>';
      }
      html += '</div>';
    }

    if (r.assessment) {
      var a = r.assessment;
      html += '<div class="pp-section"><h3><i class="fas fa-chart-line"></i> آخر تقييم فني</h3><div class="pp-grid">';
      html += item('التاريخ', a.date || '—');
      html += item('المستوى', a.level_name || '—');
      html += item('الكابتن المقيّم', a.coach_name || '—');
      html += item('النسبة النهائية', (a.overall_percent || 0) + '%');
      html += item('متوسط الدرجات', (a.levelPercent || 0) + '%');
      html += item('مجموع الدرجات', (a.levelTotal || 0) + ' / ' + ((a.levelCount || 0) * 100));
      html += item('جاهز للترقية', a.ready_to_advance ? 'نعم' : 'لا');
      html += item('نقاط القوة', a.strengths || '—');
      html += item('نقاط الضعف', a.weaknesses || '—');
      html += item('التوصيات', a.recommendations || '—');
      if (a.notes) html += item('ملاحظات', a.notes);
      html += '</div></div>';
      if (a.criteriaScores && a.criteriaScores.length) {
        html += '<div class="pp-section"><h3><i class="fas fa-gauge-high"></i> درجات المعايير</h3><div class="pp-score-list">';
        a.criteriaScores.forEach(function (c) {
          html += '<div class="pp-score-row"><span class="pp-score-name">' + esc(c.name) + '</span><span class="pp-score-val">' + (c.score || 0) + '</span></div>';
        });
        html += '</div></div>';
      }
    }

    var hasTech = r.technical && ((r.technical.levels && r.technical.levels.length) || (r.technical.general && r.technical.general.skills && r.technical.general.skills.length));
    if (hasTech) {
      var tech = r.technical;
      html += '<div class="pp-section"><h3><i class="fas fa-clipboard-check"></i> التقرير الفني الشامل</h3>';
      html += '<div class="pp-grid">';
      html += item('المستويات المقيّمة', tech.totalLevels || 0);
      html += item('إجمالي المهارات', tech.allSkills || 0);
      html += item('المتوسط العام', (tech.grandAvg || 0) + '%');
      html += '</div>';
      tech.levels.forEach(function (lvl) {
        html += '<div style="margin-top:12px"><b style="color:var(--primary);font-size:14px"><i class="fas fa-layer-group"></i> ' + esc(lvl.level.name || 'مستوى') + '</b>';
        html += '<div class="pp-grid" style="margin-top:6px">';
        html += item('التاريخ', (lvl.assessment && lvl.assessment.date) || '—');
        html += item('الكابتن', (lvl.assessment && lvl.assessment.coach_name) || '—');
        html += item('نسبة المستوى', (lvl.percent || 0) + '%');
        html += item('المتوسط', (lvl.avg || 0) + '%');
        html += '</div>';
        if (lvl.skills && lvl.skills.length) {
          html += '<div class="pp-score-list" style="margin-top:8px">';
          lvl.skills.forEach(function (sk) {
            html += '<div class="pp-score-row"><span class="pp-score-name">' + esc(sk.name) + ' <small style="color:var(--text-muted)">(' + (sk.isGeneral ? 'عام' : 'مهارة') + ')</small></span><span class="pp-score-val">' + (sk.score || 0) + '</span></div>';
          });
          html += '</div>';
        }
        html += '</div>';
      });
      if (tech.general && tech.general.skills && tech.general.skills.length) {
        html += '<div style="margin-top:12px"><b style="color:var(--primary);font-size:14px"><i class="fas fa-star"></i> المعايير العامة</b>';
        html += '<div class="pp-score-list" style="margin-top:8px">';
        tech.general.skills.forEach(function (sk) {
          html += '<div class="pp-score-row"><span class="pp-score-name">' + esc(sk.name) + '</span><span class="pp-score-val">' + (sk.score || 0) + '</span></div>';
        });
        html += '</div></div>';
      }
      html += '</div>';
    } else if (r.assessment && r.assessment.criteriaScores && r.assessment.criteriaScores.length) {
      html += '<div class="pp-section"><h3><i class="fas fa-clipboard-check"></i> التقرير الفني الشامل</h3>';
      html += '<div class="pp-score-list">';
      r.assessment.criteriaScores.forEach(function (c) {
        html += '<div class="pp-score-row"><span class="pp-score-name">' + esc(c.name) + '</span><span class="pp-score-val">' + (c.score || 0) + '</span></div>';
      });
      html += '</div></div>';
    }

    if (r.test) {
      var t = r.test;
      html += '<div class="pp-section"><h3><i class="fas fa-stopwatch"></i> آخر اختبار</h3><div class="pp-grid">';
      html += item('التاريخ', t.date || '—');
      html += item('النوع', t.type || '—');
      html += item('المسافة', (t.distance_m || 0) + ' م');
      html += item('الزمن', t.time_seconds ? (t.time_seconds + ' ث') : '—');
      html += item('النتيجة', t.result_note || '—');
      html += '</div></div>';
    }

    resultBody.innerHTML = html;
    pdfLink.href = '/my-card/' + s.id + '/pdf';
    result.style.display = 'block';
    window.scrollTo({ top: result.offsetTop - 20, behavior: 'smooth' });
  }

  function item(k, v) { return '<div class="pp-item"><div class="k">' + esc(k) + '</div><div class="v">' + esc(v) + '</div></div>'; }
  function stat(n, l, c) { return '<div class="pp-stat"><b class="text-' + c + '">' + n + '</b><span>' + l + '</span></div>'; }
  function esc(t) { return String(t == null ? '—' : t).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&apos;' }[c]; }); }
  function formatMoney(n) { return Number(n || 0).toFixed(2) + ' ج.م'; }

  function shortDate(d) {
    var s = String(d || '');
    var m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
    return m ? m[3] + '/' + m[2] : s;
  }

  /* خط تقدم SVG خفيف يعمل بدون أي مكتبات خارجية */
  function progressChart(history) {
    if (!history || !history.length) return '';
    var W = 660, H = 220, padL = 36, padR = 14, padT = 18, padB = 34;
    var vals = history.map(function (h) { return Number(h.percent) || 0; });
    var lo = Math.min.apply(null, vals);
    var hi = Math.max.apply(null, vals);
    var min = Math.max(0, Math.floor((lo - 8) / 10) * 10);
    var max = Math.min(100, Math.ceil((hi + 8) / 10) * 10);
    if (max - min < 20) {
      max = Math.min(100, min + 20);
      if (max - min < 20) min = Math.max(0, max - 20);
    }
    var n = history.length;
    function px(i) { return n === 1 ? padL + (W - padL - padR) / 2 : padL + i * (W - padL - padR) / (n - 1); }
    function py(v) { return padT + (max - v) * (H - padT - padB) / (max - min); }
    var pts = vals.map(function (v, i) { return { x: px(i), y: py(v), v: v, d: history[i].date }; });
    var linePath = pts.map(function (p, i) { return (i ? 'L' : 'M') + p.x.toFixed(1) + ' ' + p.y.toFixed(1); }).join(' ');
    var areaPath = linePath + ' L ' + pts[pts.length - 1].x.toFixed(1) + ' ' + (H - padB) + ' L ' + pts[0].x.toFixed(1) + ' ' + (H - padB) + ' Z';

    var grid = '';
    for (var g = 0; g <= 4; g++) {
      var gv = min + (max - min) * g / 4;
      var gy = py(gv);
      grid += '<line x1="' + padL + '" y1="' + gy.toFixed(1) + '" x2="' + (W - padR) + '" y2="' + gy.toFixed(1) + '" stroke="rgba(148,163,184,.25)" stroke-width="1" />';
      grid += '<text x="' + (padL - 8) + '" y="' + (gy + 4).toFixed(1) + '" text-anchor="end" font-size="10" fill="var(--text-muted)">' + Math.round(gv) + '</text>';
    }
    var dots = pts.map(function (p, i) {
      var showLabel = n <= 8 || i === 0 || i === n - 1;
      var label = showLabel ? '<text x="' + p.x.toFixed(1) + '" y="' + (H - padB + 16) + '" text-anchor="middle" font-size="9" fill="var(--text-muted)">' + esc(shortDate(p.d)) + '</text>' : '';
      return '<circle cx="' + p.x.toFixed(1) + '" cy="' + p.y.toFixed(1) + '" r="' + (i === 0 || i === n - 1 ? 5.5 : 4) + '" fill="' + (i === 0 ? '#94a3b8' : i === n - 1 ? 'var(--primary)' : '#38bdf8') + '" stroke="#fff" stroke-width="2"><title>' + esc((p.d || '') + ' — ' + p.v + '%') + '</title></circle>' + label;
    }).join('');

    return '<div class="pp-chart-wrap"><svg class="pp-chart" viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="xMidYMid meet" role="img" aria-label="خط التقدم الفني">'
      + '<defs><linearGradient id="ppArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--primary)" stop-opacity=".28"/><stop offset="100%" stop-color="var(--primary)" stop-opacity="0"/></linearGradient></defs>'
      + grid
      + '<path d="' + areaPath + '" fill="url(#ppArea)" />'
      + '<path d="' + linePath + '" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />'
      + dots + '</svg></div>';
  }

  function waNumber(phone) {
    var d = String(phone || '').replace(/\D/g, '');
    if (d.indexOf('00') === 0) d = d.slice(2);
    if (d.indexOf('0') === 0) d = d.slice(1);
    if (d.length <= 10) d = '20' + d;
    return d;
  }

  function drawCard(s, cb) {
    var canvas = document.getElementById('cardCanvas');
    var w = 900, h = 540;
    canvas.width = w; canvas.height = h;
    var ctx = canvas.getContext('2d');
    // خلفية متدرجة
    var grd = ctx.createLinearGradient(0, 0, w, h);
    grd.addColorStop(0, '#0c4a6e');
    grd.addColorStop(0.5, '#075985');
    grd.addColorStop(1, '#0369a1');
    ctx.fillStyle = grd;
    ctx.fillRect(0, 0, w, h);
    // زخرفة
    ctx.save();
    ctx.strokeStyle = 'rgba(255,255,255,.18)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(w - 80, -40, 180, 0, Math.PI * 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(-60, h - 60, 160, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();
    // شعار
    var academy = document.getElementById('shareWa').getAttribute('data-academy') || 'أكاديمية السباحة';
    var logo = new Image();
    logo.crossOrigin = 'anonymous';
    logo.onload = function () {
      var lw = 80, lh = 80;
      ctx.save();
      ctx.beginPath();
      ctx.arc(80, 70, lw / 2, 0, Math.PI * 2);
      ctx.closePath();
      ctx.clip();
      ctx.drawImage(logo, 80 - lw / 2, 70 - lh / 2, lw, lh);
      ctx.restore();
      drawText();
      cb();
    };
    logo.onerror = function () { drawText(); cb(); };
    function drawText() {
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'right';
      ctx.textBaseline = 'top';
      ctx.font = 'bold 34px "Segoe UI", Tahoma, sans-serif';
      ctx.fillText(academy, w - 40, 34);
      ctx.font = '20px "Segoe UI", Tahoma, sans-serif';
      ctx.fillStyle = 'rgba(255,255,255,.85)';
      ctx.fillText('بطاقة العضوية', w - 40, 78);

      var x = w - 40, y = 160, lh = 44;
      function line(label, value) {
        ctx.font = '18px "Segoe UI", Tahoma, sans-serif';
        ctx.fillStyle = 'rgba(255,255,255,.75)';
        ctx.fillText(label + ':', x, y);
        ctx.font = 'bold 22px "Segoe UI", Tahoma, sans-serif';
        ctx.fillStyle = '#ffffff';
        var valW = ctx.measureText(String(value || '—')).width;
        ctx.fillText(String(value || '—'), x - ctx.measureText(label + ':  ').width - 10, y);
        y += lh;
      }
      line('الاسم', s.full_name);
      line('رقم العضوية', s.membership_no);
      line('البرنامج', s.program_name || '—');
      line('المجموعة', s.group_name || '—');
      line('المستوى', s.level_name || '—');
      line('الكابتن', s.coach_name || '—');

      // خط فاصل + باركود رقم العضوية كشرائط بسيطة
      ctx.fillStyle = 'rgba(255,255,255,.2)';
      ctx.fillRect(40, h - 120, w - 80, 1);
      ctx.font = 'bold 28px "Segoe UI", Tahoma, sans-serif';
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.fillText(String(s.membership_no || ''), w / 2, h - 86);
      // خطوط الباركود
      ctx.save();
      ctx.translate(w / 2 - 140, h - 58);
      var code = String(s.membership_no || '0');
      ctx.fillStyle = '#fff';
      for (var i = 0; i < 60; i++) {
        var seed = code.charCodeAt(i % code.length) + i;
        var bw = (seed % 3) + 1;
        ctx.fillRect(i * 5, 0, bw, 34);
      }
      ctx.restore();

      ctx.font = '14px "Segoe UI", Tahoma, sans-serif';
      ctx.fillStyle = 'rgba(255,255,255,.6)';
      ctx.textAlign = 'center';
      ctx.fillText('مع خالص التقدير — ' + academy, w / 2, h - 18);
    }
    logo.src = '/images/icon-192.png?v=2';
  }

  function shareWhatsApp() {
    if (!currentSwimmer) { showMsg('ابحث عن بطاقة أولاً', 'warning'); return; }
    var s = currentSwimmer;
    drawCard(s, function () {
      var canvas = document.getElementById('cardCanvas');
      canvas.toBlob(function (blob) {
        if (!blob) { showMsg('تعذر إنشاء صورة البطاقة', 'error'); return; }
        var file = new File([blob], 'card-' + String(s.membership_no || s.id) + '.jpg', { type: 'image/jpeg' });
        var text = '🏊 بطاقة العضوية\nالاسم: ' + (s.full_name || '') + '\nرقم العضوية: ' + (s.membership_no || '') + '\nالبرنامج: ' + (s.program_name || '—') + '\nالمجموعة: ' + (s.group_name || '—') + '\nالمستوى: ' + (s.level_name || '—');
        var phone = waNumber(s.phone);
        var mob = /Mobile|Android|iPhone|iPad|iPod|Opera Mini|IEMobile|Silk/i.test(navigator.userAgent);
        function fallback() {
          var url = mob ? ('whatsapp://send?phone=' + phone + '&text=' + encodeURIComponent(text))
                        : ('https://wa.me/' + phone + '?text=' + encodeURIComponent(text));
          var a = document.createElement('a'); a.href = url; a.target = '_blank'; document.body.appendChild(a); a.click(); a.remove();
          showMsg('تم فتح واتساب بالدردشة. إذا لم تظهر الصورة، استخدم زر المشاركة من تطبيق واتساب مباشرة.', 'info');
        }
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          navigator.share({ files: [file], title: 'بطاقة العضوية', text: text })
            .then(function () { showMsg('تم فتح شاشة المشاركة — اختر واتساب لإرسال البطاقة', 'success'); })
            .catch(function (err) {
              if (err && err.name === 'AbortError') return;
              fallback();
            });
        } else {
          fallback();
        }
      }, 'image/jpeg', 0.92);
    });
  }

  document.getElementById('shareWa').addEventListener('click', shareWhatsApp);

  function lookup(code) {
    if (!code) return;
    clearMsg();
    showMsg('<i class="fas fa-spinner fa-spin"></i> جارٍ البحث...', 'info');
    fetch('/my-card/lookup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: code })
    }).then(function (r) { return r.json(); }).then(function (res) {
      clearMsg();
      if (res.ok) renderReport(res);
      else showMsg(res.message || 'لم يتم العثور على البطاقة', 'error');
    }).catch(function () {
      showMsg('تعذر الاتصال بالخادم', 'error');
    });
  }

  manualForm.addEventListener('submit', function (e) {
    e.preventDefault();
    lookup(manualCode.value.trim());
  });

  resetBtn.addEventListener('click', function () {
    result.style.display = 'none';
    resultBody.innerHTML = '';
    manualCode.value = '';
    currentSwimmer = null;
    clearMsg();
  });

  function setCameraUI(active) {
    scanning = active;
    idle.hidden = active;
    frameWrap.hidden = !active;
    scanStatus.hidden = !active;
  }

  function barcodeFormats(include2d) {
    var B = window.ZXing && window.ZXing.BarcodeFormat;
    if (!B) return null;
    var names = ['CODE_39', 'CODE_93', 'CODE_128', 'CODABAR', 'EAN_8', 'EAN_13', 'ITF', 'UPC_A', 'UPC_E'];
    if (include2d) names = names.concat(['QR_CODE', 'DATA_MATRIX', 'PDF_417']);
    var list = [];
    names.forEach(function (name) { if (B[name]) list.push(B[name]); });
    return list.length ? list : null;
  }

  function buildHints(tryHarder, include2d) {
    var hints = new Map();
    try {
      var D = window.ZXing.DecodeHintType;
      if (tryHarder) hints.set(D.TRY_HARDER, true);
      var formats = barcodeFormats(include2d);
      if (formats) hints.set(D.POSSIBLE_FORMATS, formats);
      if (D.ALSO_INVERTED) hints.set(D.ALSO_INVERTED, true);
    } catch (e) { }
    return hints;
  }

  function findTorchTrack() {
    if (!stream) return null;
    var tracks = stream.getVideoTracks();
    for (var i = 0; i < tracks.length; i++) { if (tracks[i].readyState !== 'ended') return tracks[i]; }
    return tracks[0] || null;
  }

  function pickCamera(devices) {
    var cams = devices.filter(function (d) { return d.kind === 'videoinput'; });
    if (!cams.length) return null;
    var back = cams.filter(function (d) {
      var label = String(d.label || '').toLowerCase();
      return /back|rear|environment|خلف/i.test(label);
    });
    return (back.length ? back : cams)[0].deviceId;
  }

  function buildConstraints(deviceId) {
    var base = { audio: false, video: { width: { ideal: 1280 }, height: { ideal: 720 } } };
    if (deviceId) base.video.deviceId = { exact: deviceId };
    else base.video.facingMode = { ideal: 'environment' };
    return base;
  }

  function snapshotDecode() {
    return new Promise(function (resolve, reject) {
      if (!video || !video.srcObject || !video.videoWidth) return reject(new Error('no frame'));
      if (!snapCanvas) snapCanvas = document.createElement('canvas');
      var vw = video.videoWidth;
      var vh = video.videoHeight;
      var cw = Math.round(vw * 0.96);
      var chh = Math.round(vh * 0.86);
      var sx = Math.round((vw - cw) / 2);
      var sy = Math.round((vh - chh) / 2);
      var outW = Math.min(cw, 1280);
      var outH = Math.round(chh * (outW / cw));
      snapCanvas.width = outW;
      snapCanvas.height = outH;
      var ctx = snapCanvas.getContext('2d');
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(video, sx, sy, cw, chh, 0, 0, outW, outH);
      var dataUrl = snapCanvas.toDataURL('image/png');
      var img = new Image();
      img.onload = function () {
        getSnapReader().decodeFromImage(img, dataUrl).then(function (res) {
          resolve(res);
        }).catch(function (e) {
          reject(e);
        });
      };
      img.onerror = function () { reject(new Error('image load failed')); };
      img.src = dataUrl;
    });
  }

  function getSnapReader() {
    if (snapReader) return snapReader;
    snapReader = new window.ZXing.BrowserMultiFormatReader(buildHints(true, true));
    return snapReader;
  }

  function tryStartCamera(deviceId) {
    var constraints = buildConstraints(deviceId);
    clearMsg();
    showMsg('<i class="fas fa-spinner fa-spin"></i> جارٍ تشغيل الكاميرا...', 'info');

    reader = new window.ZXing.BrowserMultiFormatReader(buildHints(false, false), 60);
    scanning = true;

    var decodePromise = reader.decodeFromConstraints(constraints, video, function (res, err) {
      if (!res) {
        if (err && err.message) {
          var msg = String(err.message);
          if (msg.indexOf('No MultiFormat Readers') > -1 || msg.indexOf('No QR code') > -1 || msg.indexOf('No barcode') > -1) return;
        }
        return;
      }
      if (res && res.getText) { lookup(res.getText()); stopCamera(); }
    });

    function markCamReady() {
      if (!scanning) return;
      if (!video.srcObject) return;
      stream = video.srcObject;
      setCameraUI(true);
      clearMsg();
      showMsg('<i class="fas fa-camera"></i> الكاميرا تعمل — وجّه الباركود داخل الإطار', 'success');
      try {
        var track = findTorchTrack();
        if (track && track.applyConstraints) {
          var caps = track.getCapabilities();
          if (caps && caps.focusMode) {
            track.applyConstraints({ advanced: [{ focusMode: 'continuous' }] }).catch(function () {});
          }
        }
      } catch (e) { }
      if (window._ppFallbackInterval) clearInterval(window._ppFallbackInterval);
      window._ppFallbackInterval = setInterval(function () {
        if (!scanning) return;
        snapshotDecode().then(function (res) {
          if (res && res.getText) { lookup(res.getText()); stopCamera(); }
        }).catch(function () { });
      }, 2500);
    }

    video.addEventListener('playing', markCamReady);
    var readyPoll = setInterval(function () {
      if (!scanning) { clearInterval(readyPoll); return; }
      if (video.srcObject && video.readyState >= 2) { markCamReady(); clearInterval(readyPoll); }
    }, 350);

    function onFail(e) {
      clearInterval(readyPoll);
      video.removeEventListener('playing', markCamReady);
      if (window._ppFallbackInterval) { clearInterval(window._ppFallbackInterval); window._ppFallbackInterval = null; }
      scanning = false;
      if (reader) { try { reader.reset(); } catch (x) { } reader = null; }
      if (snapReader) { try { snapReader.reset(); } catch (x) { } snapReader = null; }
      stream = null;
      return e;
    }

    function showCamError(e, fallbackPossible) {
      onFail(e);
      setCameraUI(false);
      var errName = (e && e.name) || '';
      var reason = 'تعذر تشغيل الكاميرا، تأكد من منح الإذن للمتصفح';
      if (errName === 'NotAllowedError' || errName === 'SecurityError') reason = 'تم رفض إذن الكاميرا — اسمح بالوصول للكاميرا من إعدادات المتصفح';
      else if (errName === 'NotFoundError' || errName === 'DevicesNotFoundError') reason = 'لا توجد كاميرا متاحة على هذا الجهاز';
      else if (errName === 'NotReadableError' || errName === 'TrackStartError') reason = 'الكاميرا مستخدمة من تطبيق آخر — أغلق التطبيقات الأخرى';
      else if (errName === 'OverconstrainedError') reason = 'إعدادات الكاميرا غير مدعومة';
      if (fallbackPossible) {
        showMsg(reason + ' — جاري تجربة كاميرا أخرى...', 'warning');
      } else {
        showMsg(reason, 'error');
      }
    }

    if (decodePromise && decodePromise.then) {
      decodePromise.then(function () { markCamReady(); }).catch(function (e) {
        var errName = (e && e.name) || '';
        if (!deviceId && errName !== 'NotAllowedError' && errName !== 'SecurityError' && navigator.mediaDevices && navigator.mediaDevices.enumerateDevices) {
          showCamError(e, true);
          navigator.mediaDevices.enumerateDevices().then(function (devices) {
            var id = pickCamera(devices);
            if (id) tryStartCamera(id);
            else { setCameraUI(false); showMsg('لا توجد كاميرا أخرى متاحة', 'error'); }
          }).catch(function () {
            showCamError(e, false);
          });
        } else {
          showCamError(e, false);
        }
      });
    }
  }

  function startCamera() {
    if (scanning) return;
    if (!window.ZXing || !window.ZXing.BrowserMultiFormatReader) {
      showMsg('مكتبة المسح غير متاحة — أعد تحميل الصفحة', 'error');
      return;
    }
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      showMsg('المتصفح لا يدعم الكاميرا — استخدم الإدخال اليدوي', 'error');
      return;
    }
    tryStartCamera(null);
  }

  function stopCamera() {
    scanning = false;
    if (window._ppFallbackInterval) { clearInterval(window._ppFallbackInterval); window._ppFallbackInterval = null; }
    if (reader) { try { reader.reset(); } catch (e) { } reader = null; }
    if (snapReader) { try { snapReader.reset(); } catch (e) { } snapReader = null; }
    try {
      if (stream) { stream.getTracks().forEach(function (t) { t.stop(); }); }
    } catch (e) { }
    stream = null;
    try { video.srcObject = null; } catch (e) { }
    setCameraUI(false);
    clearMsg();
  }

  captureBtn.addEventListener('click', function () {
    if (!scanning || !video.srcObject) return;
    snapshotDecode().then(function (res) {
      if (res && res.getText) { lookup(res.getText()); stopCamera(); }
      else showMsg('لم يقرأ اللقطة، حاول تقريب الباركود', 'warning');
    }).catch(function () {
      showMsg('لم يقرأ اللقطة', 'warning');
    });
  });

  startBtn.addEventListener('click', startCamera);
  stopBtn.addEventListener('click', stopCamera);
  window.addEventListener('pagehide', stopCamera);
})();
</script>
</body>
</html>
