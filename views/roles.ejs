<%- include('partials/layout_top', { title: 'الأدوار والصلاحيات', active: 'users' }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-user-shield"></i> الأدوار والصلاحيات</div>
    <div class="page-sub">إدارة أدوار النظام وتحديد صلاحيات كل دور</div>
  </div>
  <div class="spacer"></div>
  <a href="/users" class="btn btn-outline"><i class="fas fa-users"></i> المستخدمون</a>
</div>

<% roles.forEach(function (role) { %>
  <div class="card" style="margin-bottom:18px">
    <div class="card-header">
      <div>
        <h3><i class="fas fa-user-tag"></i> <%= role.name %></h3>
        <span class="font-12 text-muted"><%= role.users_count %> مستخدم · <%= role.is_system ? 'دور نظام' : 'دور مخصص' %></span>
      </div>
    </div>
    <div class="card-body">
      <% if (!canEdit) { %>
        <p class="text-muted">ليست لديك صلاحية تعديل الصلاحيات.</p>
      <% } else { %>
        <form method="POST" action="/roles/<%= role.id %>/permissions" class="role-perm-form" data-role="<%= role.id %>" novalidate>
          <div class="table-wrap">
            <table class="data-table perms-table">
              <thead>
                <tr>
                  <th>الوحدة</th>
                  <th style="width:90px"><label class="perm-head"><input type="checkbox" class="perm-all-col" data-col="view"> عرض</label></th>
                  <th style="width:90px"><label class="perm-head"><input type="checkbox" class="perm-all-col" data-col="add"> إضافة</label></th>
                  <th style="width:90px"><label class="perm-head"><input type="checkbox" class="perm-all-col" data-col="edit"> تعديل</label></th>
                  <th style="width:90px"><label class="perm-head"><input type="checkbox" class="perm-all-col" data-col="del"> حذف</label></th>
                  <th style="width:110px"><label class="perm-head"><input type="checkbox" class="perm-all-col" data-col="export"> تحميل/طباعة</label></th>
                </tr>
              </thead>
              <tbody>
                <% let perms = {}; try { perms = JSON.parse(role.permissions || '{}'); } catch (e) { perms = {}; } %>
                <% groups.forEach(function (grp) { %>
                  <tr class="group-row"><td colspan="6"><i class="fas fa-folder"></i> <%= grp[0] %></td></tr>
                  <% grp[1].forEach(function (m) { %>
                    <% const p = perms[m] || { view: 0, add: 0, edit: 0, del: 0, export: 0 }; %>
                    <tr>
                      <td><%= labels[m] || m %></td>
                      <td><input type="checkbox" name="<%= m %>_view" value="1" <%= p.view ? 'checked' : '' %> class="perm-row" data-row="view"></td>
                      <td><input type="checkbox" name="<%= m %>_add" value="1" <%= p.add ? 'checked' : '' %> class="perm-row" data-row="add"></td>
                      <td><input type="checkbox" name="<%= m %>_edit" value="1" <%= p.edit ? 'checked' : '' %> class="perm-row" data-row="edit"></td>
                      <td><input type="checkbox" name="<%= m %>_del" value="1" <%= p.del ? 'checked' : '' %> class="perm-row" data-row="del"></td>
                      <td><input type="checkbox" name="<%= m %>_export" value="1" <%= p.export ? 'checked' : '' %> class="perm-row" data-row="export"></td>
                    </tr>
                  <% }); %>
                <% }); %>
              </tbody>
            </table>
          </div>
          <div class="form-actions" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-floppy-disk"></i> حفظ صلاحيات <%= role.name %></button>
            <span class="role-save-status font-12" style="display:none"></span>
          </div>
        </form>
      <% } %>
    </div>
  </div>
<% }); %>

<script>
document.querySelectorAll('.perm-all-col').forEach(function (chk) {
  chk.addEventListener('change', function () {
    var col = this.getAttribute('data-col');
    document.querySelectorAll('.perm-row[data-row="' + col + '"]').forEach(function (c) { c.checked = chk.checked; });
  });
});
document.querySelectorAll('.group-row').forEach(function (r) {
  r.style.background = 'var(--bg-soft)';
  r.style.fontWeight = '700';
});

/* حفظ الصلاحيات عبر AJAX: سريع بلا إعادة تحميل الصفحة كاملة */
document.querySelectorAll('.role-perm-form').forEach(function (form) {
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var btn = form.querySelector('button[type=submit]');
    var status = form.querySelector('.role-save-status');
    var original = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارٍ الحفظ...';
    status.style.display = 'inline';
    status.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> جارٍ الحفظ...';
    fetch(form.getAttribute('action'), {
      method: 'POST',
      body: new FormData(form),
      headers: { 'Accept': 'application/json' }
    }).then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      status.style.color = '#22c55e';
      status.innerHTML = '<i class="fas fa-check-circle"></i> تم الحفظ بنجاح';
    }).catch(function (err) {
      status.style.color = '#ef4444';
      status.innerHTML = '<i class="fas fa-triangle-exclamation"></i> فشل الحفظ — حاول مجدداً';
    }).finally(function () {
      btn.disabled = false;
      btn.innerHTML = original;
      setTimeout(function () { status.style.display = 'none'; }, 3000);
    });
  });
});
</script>
<%- include('partials/layout_bottom') %>
