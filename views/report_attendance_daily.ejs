<%- include('partials/layout_top', { title: 'تقرير الحضور اليومي', active: 'reports' }) %>
<div class="page-head no-print">
  <div>
    <div class="page-title"><i class="fas fa-clipboard-user"></i> تقرير الحضور والغياب اليومي</div>
    <div class="page-sub">حضور وغياب جميع السباحين حسب التاريخ — جاهز للطباعة والتحميل PDF</div>
  </div>
  <div class="spacer"></div>
  <div class="flex gap-1" style="flex-wrap:wrap">
    <form method="get" action="/reports/attendance/daily" class="flex gap-1">
      <input type="date" name="date" class="form-control" value="<%= date %>">
      <button class="btn btn-outline" type="submit">تصفية</button>
    </form>
    <button class="btn btn-primary" data-print onclick="window.print()"><i class="fas fa-file-pdf"></i> طباعة / تحميل PDF</button>
    <a href="/reports/attendance" class="btn btn-ghost"><i class="fas fa-list"></i> تقرير نسب الحضور</a>
  </div>
</div>

<div class="report-title-line no-print">
  <span class="badge badge-primary"><%= fmtDate(date) %></span>
</div>

<div class="kpi-row no-print">
  <div class="kpi"><div class="k-val text-success"><%= daily.present %></div><div class="k-lbl">حاضر</div></div>
  <div class="kpi"><div class="k-val text-danger"><%= daily.absent %></div><div class="k-lbl">غائب</div></div>
  <div class="kpi"><div class="k-val text-warning"><%= daily.excused %></div><div class="k-lbl">معتذر</div></div>
  <div class="kpi"><div class="k-val text-primary"><%= daily.late %></div><div class="k-lbl">متأخر</div></div>
  <div class="kpi"><div class="k-val"><%= groups.length %></div><div class="k-lbl">مجموعات</div></div>
</div>

<% groups.forEach(function (g) { %>
  <div class="card" style="break-inside:avoid;margin-bottom:14px">
    <div class="card-header">
      <h3><i class="fas fa-people-group"></i> <%= g.name %>
        <% if (g.session) { %><span class="badge badge-success"><i class="fas fa-clock"></i> <%= g.session.start_time %></span><% } else { %><span class="badge badge-gray">لا توجد حصة في هذا اليوم</span><% } %>
      </h3>
      <span class="text-muted font-12"><i class="fas fa-user-tie"></i> <%= g.coach_name || '—' %></span>
    </div>
    <% if (g.session) { %>
      <div class="table-wrap">
        <table class="data-table report-table">
          <thead>
            <tr><th style="width:38px">#</th><th>السباح</th><th>رقم العضوية</th><th>المستوى</th><th>الحالة</th><th>السبب / الملاحظة</th></tr>
          </thead>
          <tbody>
            <% g.members.forEach(function (m, i) { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><b><%= m.full_name %></b></td>
                <td><%= m.membership_no %></td>
                <td><%= m.level_name || '—' %></td>
                <td>
                  <% if (m.status === 'present') { %><span class="att-status present"><i class="fas fa-check"></i> حاضر</span>
                  <% } else if (m.status === 'absent') { %><span class="att-status absent"><i class="fas fa-xmark"></i> غائب</span>
                  <% } else if (m.status === 'excused') { %><span class="att-status excused"><i class="fas fa-book"></i> معتذر</span>
                  <% } else if (m.status === 'late') { %><span class="att-status late"><i class="fas fa-clock"></i> متأخر</span>
                  <% } else { %><span class="att-status pending">لم يُسجل</span><% } %>
                </td>
                <td><%= m.reason || '—' %></td>
              </tr>
            <% }); %>
            <% if (!g.members.length) { %><tr><td colspan="6" class="text-muted">لا يوجد سباحون مسجلون في هذه المجموعة</td></tr><% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
<% }); %>

<% if (!groups.length) { %>
  <div class="card"><div class="empty-state"><i class="fas fa-clipboard-user"></i><p>لا توجد مجموعات</p></div></div>
<% } %>

<style>
  .report-table td, .report-table th { font-size: 13px; }
  .att-status { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 13px; padding: 4px 12px; border-radius: 999px; }
  .att-status.present { background: rgba(16,185,129,.13); color: #059669; }
  .att-status.absent { background: rgba(239,68,68,.13); color: #dc2626; }
  .att-status.excused { background: rgba(245,158,11,.14); color: #d97706; }
  .att-status.late { background: rgba(2,132,199,.13); color: #0284c7; }
  .att-status.pending { background: rgba(100,116,139,.15); color: #64748b; }
  .report-title-line { margin-bottom: 12px; }
  @media print {
    .card { border-color: #cbd5e1; }
    .att-status { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  }
</style>
<%- include('partials/layout_bottom') %>
