<%- include('partials/layout_top', { title: title, active: 'assessments' }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-clipboard-check"></i> التقييمات الفنية</div>
    <div class="page-sub">كل المجموعات والفرق في مكان واحد — ادخل أي مجموعة أو فريق لتقييم لاعبيها</div>
  </div>
  <div class="spacer"></div>
  <div class="flex flex-wrap gap-1">
    <% if (canAdd(user, 'assessments')) { %>
      <a href="/assessments/new" class="btn btn-primary"><i class="fas fa-plus"></i> تقييم جديد</a>
    <% } %>
    <% if (userCanExport) { %>
      <a href="/assessments/reports/all.pdf" target="_blank" class="btn btn-outline"><i class="fas fa-file-pdf"></i> تقرير كل المجموعات PDF</a>
      <a href="/assessments/reports/all.xls" class="btn btn-outline"><i class="fas fa-file-excel"></i> تقرير كل المجموعات Excel</a>
    <% } %>
    <a href="/assessments/log" class="btn btn-outline"><i class="fas fa-list-check"></i> سجل التقييمات</a>
  </div>
</div>

<div class="kpi-row">
  <div class="kpi"><div class="k-val text-primary"><%= groups.length %></div><div class="k-lbl">المجموعات</div></div>
  <div class="kpi"><div class="k-val text-info"><%= teams.length %></div><div class="k-lbl">الفرق</div></div>
  <div class="kpi"><div class="k-val"><%= totalMembers %></div><div class="k-lbl">إجمالي اللاعبين</div></div>
  <div class="kpi"><div class="k-val text-success"><%= assessedToday %></div><div class="k-lbl">تم تقييمهم اليوم</div></div>
  <div class="kpi"><div class="k-val text-warning"><%= ungroupedCount %></div><div class="k-lbl">لاعبون بدون مجموعة</div></div>
</div>

<% if (groups.length) { %>
  <div class="assess-groups-grid">
    <% groups.forEach(function (g) { %>
      <a class="assess-group-card" href="/assessments/groups/<%= g.id %>">
        <span class="assess-group-icon"><i class="fas fa-people-group"></i></span>
        <span class="assess-group-body">
          <span class="assess-group-name"><%= g.name %></span>
          <span class="assess-group-meta"><%= g.program_name || 'بدون برنامج' %><%= g.coach_name ? ' · ' + g.coach_name : '' %></span>
          <span class="assess-group-stats">
            <span><i class="fas fa-user-group"></i> <%= g.members %> لاعب</span>
            <span><i class="fas fa-circle-check"></i> <%= g.assessed_today %> اليوم</span>
          </span>
        </span>
        <i class="fas fa-chevron-left assess-group-arrow"></i>
      </a>
    <% }); %>
  </div>
<% } else { %>
  <div class="card">
    <div class="empty-state">
      <i class="fas fa-people-group"></i>
      <p>لا توجد مجموعات بعد — أنشئ مجموعة أولاً ثم عد لتقييم لاعبيها</p>
      <% if (canView(user, 'groups')) { %>
        <a href="/groups/new" class="btn btn-primary" style="margin-top:14px"><i class="fas fa-plus"></i> إنشاء مجموعة</a>
      <% } %>
    </div>
  </div>
<% } %>

<% if (teams.length) { %>
  <h2 class="section-title" style="margin-top:28px"><i class="fas fa-flag-checkered"></i> الفرق</h2>
  <div class="assess-groups-grid">
    <% teams.forEach(function (t) { %>
      <a class="assess-group-card" href="/teams/<%= t.id %>">
        <span class="assess-group-icon" style="background:linear-gradient(135deg,#6366f1,#8b5cf6)"><i class="fas fa-flag-checkered"></i></span>
        <span class="assess-group-body">
          <span class="assess-group-name"><%= t.name %></span>
          <span class="assess-group-meta"><%= t.age_group || '' %><%= t.coach_name ? ' · ' + t.coach_name : '' %></span>
          <span class="assess-group-stats">
            <span><i class="fas fa-users"></i> <%= t.members %> لاعب</span>
            <span><i class="fas fa-circle-check"></i> <%= t.assessed_today %> اليوم</span>
          </span>
        </span>
        <i class="fas fa-chevron-left assess-group-arrow"></i>
      </a>
    <% }); %>
  </div>
<% } %>

<% if (ungroupedCount > 0) { %>
  <details class="card mt-2" id="ungroupedAssign">
    <summary class="card-body flex items-center gap-2" style="flex-wrap:wrap;cursor:pointer;list-style:none">
      <span class="assess-group-icon" style="background:linear-gradient(135deg,#f59e0b,#f97316)"><i class="fas fa-user-plus"></i></span>
      <div style="flex:1;min-width:200px">
        <b><%= ungroupedCount %> لاعب غير مضاف إلى أي مجموعة</b>
        <div class="page-sub">اضغط هنا لعرض اللاعبين وتسكينهم في المجموعات المتاحة.</div>
      </div>
      <i class="fas fa-chevron-down" style="color:var(--text-muted)"></i>
    </summary>
    <div class="card-body" style="border-top:1px solid var(--card-border)">
      <form method="POST" action="/assessments/assign-ungrouped">
        <div class="form-grid" style="margin-bottom:12px">
          <div class="form-group" style="min-width:220px">
            <label>المجموعة المقصودة</label>
            <select class="form-control" name="group_id" required>
              <option value="">— اختر مجموعة —</option>
              <% availableGroups.forEach(function (g) { %>
                <option value="<%= g.id %>"><%= g.name %> (<%= g.members %>/<%= g.capacity || 12 %>)</option>
              <% }); %>
            </select>
          </div>
          <div class="form-group flex items-end">
            <button type="submit" class="btn btn-primary"><i class="fas fa-user-check"></i> تسكين المحددين</button>
          </div>
        </div>
        <div style="overflow-x:auto">
          <table class="data-table">
            <thead>
              <tr><th><input type="checkbox" id="selectAllUngrouped"></th><th>اللاعب</th><th>رقم العضوية</th><th>المستوى الحالي</th></tr>
            </thead>
            <tbody>
              <% ungroupedSwimmers.forEach(function (s) { %>
                <tr>
                  <td><input type="checkbox" name="swimmer_ids" value="<%= s.id %>" class="ug-check"></td>
                  <td><b><%= s.full_name %></b></td>
                  <td><%= s.membership_no || '—' %></td>
                  <td><%= s.level_name || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </form>
    </div>
  </details>
  <script>
    (function () {
      const all = document.getElementById('selectAllUngrouped');
      const boxes = document.querySelectorAll('#ungroupedAssign .ug-check');
      if (all) {
        all.addEventListener('change', function () {
          boxes.forEach(function (c) { c.checked = all.checked; });
        });
      }
    })();
  </script>
<% } %>
<%- include('partials/layout_bottom') %>
