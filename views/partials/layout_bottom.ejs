    </main>
    <footer style="padding: 14px 24px; border-top: 1px solid var(--card-border); color: var(--text-muted); font-size: 12px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;">
      <span>© <%= new Date().getFullYear() %> <b><%= siteName %></b> — جميع الحقوق محفوظة</span>
      <span><i class="fas fa-water"></i> أفضل مكان لتعلم السباحة</span>
    </footer>
  </div>
</div>
<div class="toast-container">
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="toast <%= flash.type %>"><i class="fas <%= flash.type === 'success' ? 'fa-circle-check' : flash.type === 'error' ? 'fa-circle-xmark' : 'fa-circle-info' %>"></i><span><%= flash.message %></span></div>
  <% } %>
</div>
<script src="/vendor/chart.umd.js"></script>
<script src="/js/app.js?v=10"></script>
<script src="/js/install.js?v=1"></script>
<% if (typeof pageScripts !== 'undefined' && pageScripts) { pageScripts.forEach(function (s) { %><script src="<%= s %>"></script><% }); } %>
<% if (typeof inlineScript !== 'undefined' && inlineScript) { %><script><%= inlineScript %></script><% } %>
<script>
/* عند الرجوع بالخلف (زر المتصفح أو إيماءة الهاتف) قد يعيد المتصفح الصفحة من
   ذاكرة bfcache بحالتها القديمة، فتظهر البيانات وكأن التعديل أُلغي. إعادة
   التحميل من السيرفر تضمن ظهور أحدث بيانات محفوظة في كل الأحوال. */
window.addEventListener('pageshow', function (e) {
  if (e.persisted) window.location.reload();
});
(function () {
  document.querySelectorAll('[data-multi-dropdown]').forEach(function (wrap) {
    var toggle = wrap.querySelector('[data-toggle]');
    var menu = wrap.querySelector('[data-menu]');
    var selectAll = wrap.querySelector('[data-select-all]');
    var label = wrap.querySelector('[data-label]');
    function updateLabel() {
      var checked = wrap.querySelectorAll('input[name][type="checkbox"]:checked');
      if (label) label.textContent = checked.length ? (checked.length + ' محدد') : '— اختر من القائمة —';
    }
    function getGroupChecks() {
      return Array.from(wrap.querySelectorAll('input[name][type="checkbox"]')).filter(function (c) { return c !== selectAll; });
    }
    if (toggle && menu) {
      toggle.addEventListener('click', function () {
        menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
      });
      document.addEventListener('click', function (e) {
        if (!wrap.contains(e.target)) menu.style.display = 'none';
      });
    }
    if (selectAll) {
      selectAll.addEventListener('change', function () {
        getGroupChecks().forEach(function (c) { c.checked = selectAll.checked; });
        updateLabel();
      });
    }
    wrap.querySelectorAll('input[name][type="checkbox"]').forEach(function (c) {
      if (c === selectAll) return;
      c.addEventListener('change', function () {
        if (selectAll) selectAll.checked = getGroupChecks().every(function (x) { return x.checked; });
        updateLabel();
      });
    });
    updateLabel();
  });
})();
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('/sw.js').catch(function () {});
  });
}
</script>
</body>
</html>
