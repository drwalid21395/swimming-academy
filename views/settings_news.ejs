<%- include('partials/layout_top', { title: 'الأخبار والأحداث', active: 'settings' }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-newspaper"></i> الأخبار والأحداث</div>
    <div class="page-sub">تُنشر على الموقع التعريفي — أخبار، أحداث، وإعلانات الأكاديمية</div>
  </div>
</div>

<% if (canEdit) { %>
  <div class="card" style="max-width:820px">
    <div class="card-body">
      <div class="form-section-title"><i class="fas fa-plus"></i> إضافة خبر أو حدث</div>
      <form method="POST" action="/settings/news/add" enctype="multipart/form-data">
        <div class="form-group">
          <label>العنوان</label>
          <input type="text" name="title" class="form-control" placeholder="مثال: معسكر الصيف 2026 — فتح باب التسجيل" required>
        </div>
        <div class="form-group">
          <label>التفاصيل</label>
          <textarea name="body" class="form-control" rows="4" placeholder="اكتب تفاصيل الخبر أو الحدث هنا..."></textarea>
        </div>
        <div class="form-group">
          <label>صورة الخبر (اختياري)</label>
          <input type="file" name="image" class="form-control" accept="image/*">
          <div class="form-hint">صورة تُعرض مع الخبر على الموقع (JPG/PNG)</div>
        </div>
        <label class="inline-check" style="display:flex;align-items:center;gap:8px;margin:10px 0">
          <input type="checkbox" name="is_public" checked> نشره على الموقع (ظاهر للزوار)
        </label>
        <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> نشر الخبر</button>
      </form>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-body">
    <div class="form-section-title"><i class="fas fa-list"></i> الأخبار والأحداث المنشورة</div>
    <% if (news.length) { %>
      <% news.forEach(function (n) { %>
        <div class="news-row" style="display:flex;align-items:flex-start;gap:12px;padding:14px 0;border-bottom:1px solid #eef2f7">
          <% if (n.image) { %>
            <div style="width:86px;height:86px;border-radius:12px;overflow:hidden;flex-shrink:0;border:1px solid #eef2f7">
              <img src="<%= n.image %>" alt="" style="width:100%;height:100%;object-fit:cover;display:block">
            </div>
          <% } %>
          <div style="flex:1">
            <div style="font-weight:700"><%= n.title %></div>
            <div class="text-muted" style="font-size:12.5px;margin:3px 0"><i class="fas fa-calendar"></i> <%= fmtDate(n.created_at) %> · <%= n.is_public ? '<span class="badge badge-success">منشور</span>' : '<span class="badge badge-gray">مسودة</span>' %></div>
            <div class="text-soft" style="font-size:13.5px"><%= n.body %></div>
          </div>
          <% if (canEdit) { %>
            <div style="display:flex;gap:6px;flex-shrink:0">
              <button type="button" class="btn btn-sm btn-outline" onclick="var el=document.getElementById('edit-<%= n.id %>');el.hidden=!el.hidden"><i class="fas fa-pen"></i></button>
              <form method="POST" action="/settings/news/<%= n.id %>/delete" data-confirm="حذف هذا الخبر؟">
                <button type="submit" class="btn btn-sm btn-danger" title="حذف"><i class="fas fa-trash"></i></button>
              </form>
            </div>
          <% } %>
        </div>
        <% if (canEdit) { %>
          <div id="edit-<%= n.id %>" hidden style="padding:14px 18px;margin:6px 0 2px;background:#f8fafc;border:1px solid #eef2f7;border-radius:12px">
            <div class="form-section-title" style="margin-bottom:10px"><i class="fas fa-pen"></i> تعديل الخبر</div>
            <form method="POST" action="/settings/news/<%= n.id %>/edit" enctype="multipart/form-data">
              <div class="form-group">
                <label>العنوان</label>
                <input type="text" name="title" class="form-control" value="<%= n.title %>" required>
              </div>
              <div class="form-group">
                <label>التفاصيل</label>
                <textarea name="body" class="form-control" rows="3"><%= n.body %></textarea>
              </div>
              <div class="form-group">
                <label>صورة الخبر</label>
                <% if (n.image) { %>
                  <div id="img-box-<%= n.id %>" style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
                    <img src="<%= n.image %>" alt="" style="width:56px;height:56px;border-radius:8px;object-fit:cover">
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;color:var(--danger)">
                      <input type="checkbox" name="remove_image" value="1" onchange="document.getElementById('img-box-<%= n.id %>').style.display=this.checked?'none':''"> إزالة الصورة الحالية
                    </label>
                  </div>
                <% } %>
                <input type="file" name="image" class="form-control" accept="image/*">
                <div class="form-hint">اختر صورة جديدة لاستبدالها، أو اتركها فارغة للإبقاء على الحالية</div>
              </div>
              <label class="inline-check" style="display:flex;align-items:center;gap:8px;margin:8px 0">
                <input type="checkbox" name="is_public" <%= n.is_public ? 'checked' : '' %>> نشره على الموقع
              </label>
              <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-save"></i> حفظ التعديلات</button>
              <button type="button" class="btn btn-sm" onclick="document.getElementById('edit-<%= n.id %>').hidden=true">إلغاء</button>
            </form>
          </div>
        <% } %>
      <% }); %>
    <% } else { %>
      <div class="empty-state"><i class="fas fa-newspaper"></i><p>لا توجد أخبار بعد — أضف أول خبر من الأعلى</p></div>
    <% } %>
  </div>
</div>
<%- include('partials/layout_bottom') %>
