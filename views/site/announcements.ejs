<%- include('_head', { title: 'الإعلانات', page: 'announcements' }) %>
<div class="site-container" style="max-width:900px">
  <h2 style="margin-bottom:24px">الإعلانات والأخبار</h2>
  <div class="timeline">
    <% announcements.forEach(function (a) { %>
      <div class="card" style="margin-bottom:14px">
        <div class="card-header">
          <h3><i class="fas fa-bullhorn"></i> <%= a.title %></h3>
          <span class="font-12 text-muted"><%= fmtDate(a.created_at) %></span>
        </div>
        <div class="card-body"><div class="font-13 text-soft"><%= a.body %></div></div>
      </div>
    <% }); %>
    <% if (!announcements.length) { %><div class="card"><div class="card-body"><div class="empty-state"><p>لا توجد إعلانات حالياً</p></div></div></div><% } %>
  </div>
</div>
<%- include('_foot') %>
