<%- include('_head', { title: 'الرئيسية', page: 'home' }) %>
<div class="site-hero">
  <div class="hero-bg"><i class="fas fa-water"></i></div>
  <h1><i class="fas fa-person-swimming"></i> <%= data.siteName %></h1>
  <p><%= data.slogan %><br>نعلّم السباحة لجميع الأعمار من المبتدئين حتى المحترفين، مع نخبة من أمهر الكباتن.</p>
  <a href="<%= (data.base || '/site') %>/contact" class="btn btn-lg" style="background:#fff;color:var(--primary)"><i class="fas fa-calendar-check"></i> احجز مقعدًا للتجربة</a>
</div>

<div class="site-container">
  <h2 style="text-align:center;margin-bottom:8px">برامجنا التدريبية</h2>
  <p style="text-align:center;color:var(--text-muted);margin-bottom:28px">دورات مخصصة لكل مستوى وقدرة</p>
  <div class="dash-grid">
    <% programs.forEach(function (p) { %>
      <a href="<%= (data.base || '/site') %>/programs/<%= p.id %>" class="program-card" style="text-decoration:none;color:var(--text)">
        <div class="flex justify-between items-center">
          <span class="badge badge-primary"><%= p.type %></span>
          <span class="fw-700" style="color:var(--primary);font-size:18px"><%= money(p.price) %></span>
        </div>
        <b style="font-size:16px"><%= p.name %></b>
        <div style="font-size:13px;color:var(--text-soft)"><%= p.description ? (p.description.length > 90 ? p.description.slice(0,90)+'...' : p.description) : 'دورة سباحة مكثفة' %></div>
        <div style="font-size:12px;color:var(--text-muted)"><i class="fas fa-stopwatch"></i> <%= p.sessions_count %> حصة — <%= p.session_duration_min %> دقيقة · <i class="fas fa-users"></i> من <%= p.age_from %> حتى <%= p.age_to %> سنة</div>
      </a>
    <% }); %>
  </div>
  <div style="text-align:center;margin-top:24px"><a href="<%= (data.base || '/site') %>/programs" class="btn btn-outline">عرض كل البرامج <i class="fas fa-arrow-left"></i></a></div>

  <h2 style="text-align:center;margin:44px 0 8px">المواعيد القادمة</h2>
  <p style="text-align:center;color:var(--text-muted);margin-bottom:28px">جداول الحصص تظهر تلقائياً — تُحدَّث فور تعديل المواعيد</p>
  <div class="dash-grid">
    <% upcoming.forEach(function (s) { %>
      <div class="card">
        <div class="card-body" style="text-align:center">
          <div style="font-size:28px;color:var(--primary)"><i class="fas fa-person-swimming"></i></div>
          <b style="display:block;margin:8px 0 4px"><%= s.title || (s.group_name || 'حصة تدريبية') %></b>
          <div class="font-13 text-soft">
            <div><i class="fas fa-calendar-day"></i> <%= fmtDate(s.date) %></div>
            <div><i class="fas fa-clock"></i> <%= s.start_time %> - <%= s.end_time || '' %></div>
            <% if (s.coach_name) { %><div><i class="fas fa-user-tie"></i> <%= s.coach_name %></div><% } %>
          </div>
        </div>
      </div>
    <% }); %>
    <% if (!upcoming.length) { %><div class="card"><div class="card-body"><div class="empty-state"><p>لا توجد مواعيد قادمة — جدوّل الحصص من لوحة الإدارة ليظهر هنا تلقائياً</p></div></div></div><% } %>
  </div>
  <div style="text-align:center;margin-top:24px"><a href="<%= (data.base || '/site') %>/news#events" class="btn btn-outline">كل المواعيد والأحداث <i class="fas fa-arrow-left"></i></a></div>

  <h2 style="text-align:center;margin:44px 0 8px">لماذا <%= data.siteName %>؟</h2>
  <p style="text-align:center;color:var(--text-muted);margin-bottom:28px">مميزات تعلم السباحة معنا</p>
  <div class="dash-grid">
    <div class="program-card"><div style="font-size:30px;color:var(--primary)"><i class="fas fa-shield-halved"></i></div><b>السلامة أولًا</b><div style="font-size:13px;color:var(--text-soft)">منقذون معتمدون وإجراءات سلامة صارمة داخل حماماتنا.</div></div>
    <div class="program-card"><div style="font-size:30px;color:#14b8a6"><i class="fas fa-user-graduate"></i></div><b>كباتن معتمدون</b><div style="font-size:13px;color:var(--text-soft)">كباتن حاصلون على شهادات دورية وفق أعلى المعايير والإشراف.</div></div>
    <div class="program-card"><div style="font-size:30px;color:#0ea5e9"><i class="fas fa-layer-group"></i></div><b>مستويات مدرجة</b><div style="font-size:13px;color:var(--text-soft)">من أساسيات السباحة وتدريب الدورات والبطولات عبر مستويات واضحة.</div></div>
    <div class="program-card"><div style="font-size:30px;color:#f59e0b"><i class="fas fa-chart-line"></i></div><b>متابعة التقدم</b><div style="font-size:13px;color:var(--text-soft)">تقارير دورية وتقييمات لأداء السباح، بالإضافة إلى متابعة كل مستوى.</div></div>
  </div>

  <h2 style="text-align:center;margin:44px 0 8px">آخر الإعلانات</h2>
  <div class="dash-grid">
    <% announcements.forEach(function (a) { %>
      <div class="card">
        <% if (a.image) { %>
          <div style="height:170px;overflow:hidden;cursor:pointer" onclick="window.open('<%= a.image %>','_blank')">
            <img src="<%= a.image %>" alt="<%= a.title %>" style="width:100%;height:100%;object-fit:cover;display:block">
          </div>
        <% } %>
        <div class="card-header"><h3><i class="fas fa-bullhorn"></i> <%= a.title %></h3><span class="font-12 text-muted"><%= fmtDate(a.created_at) %></span></div>
        <div class="card-body"><div class="font-13 text-soft"><%= a.body %></div></div>
      </div>
    <% }); %>
    <% if (!announcements.length) { %><div class="card"><div class="card-body"><div class="empty-state"><p>لا توجد إعلانات حالياً</p></div></div></div><% } %>
  </div>

  <% if (data.homeImages.length) { %>
    <h2 style="text-align:center;margin:44px 0 8px">من صورنا</h2>
    <p style="text-align:center;color:var(--text-muted);margin-bottom:28px">لقطات من فعاليات ومواعيد الأكاديمية</p>
    <div class="dash-grid">
      <% data.homeImages.slice(0,6).forEach(function (img) { %>
        <div style="border-radius:16px;overflow:hidden;border:1px solid var(--card-border);box-shadow:var(--shadow);cursor:pointer" onclick="window.open('/uploads/<%= img %>','_blank')">
          <img src="/uploads/<%= img %>" alt="صورة" style="width:100%;height:170px;object-fit:cover;display:block">
        </div>
      <% }); %>
    </div>
  <% } %>

  <div style="text-align:center;margin-top:28px">
    <a href="<%= (data.base || '/site') %>/news" class="btn btn-primary"><i class="fas fa-newspaper"></i> الأخبار والمركز الإعلامي</a>
  </div>

  <h2 style="text-align:center;margin:44px 0 8px">كادر الكباتن</h2>
  <div class="dash-grid">
    <% coaches.forEach(function (c) { %>
      <div class="card" style="text-align:center">
        <div class="card-body">
          <% if (c.avatar) { %>
            <div class="avatar-xl" style="margin:auto;overflow:hidden;background:#e2e8f0"><img src="<%= c.avatar %>" alt="<%= c.full_name %>" style="width:100%;height:100%;object-fit:cover;display:block"></div>
          <% } else { %>
            <div class="avatar-xl" style="margin:auto;background:linear-gradient(135deg,var(--primary),var(--primary-light));color:#fff"><%= (c.full_name || 'ك').trim().charAt(0) %></div>
          <% } %>
          <b style="display:block;margin-top:10px"><%= c.full_name %></b>
          <div class="badge badge-primary" style="margin-top:4px"><%= c.specialization || 'مدرب سباحة' %></div>
          <div class="font-12 text-muted" style="margin-top:6px"><%= c.qualification || '' %> · خبرة <%= c.experience_years || 0 %> سنة</div>
        </div>
      </div>
    <% }); %>
  </div>
</div>
<%- include('_foot') %>
