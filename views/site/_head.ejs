<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= data.siteName %></title>
  <link rel="stylesheet" href="/vendor/fa-all.min.css">
  <link rel="stylesheet" href="/css/style.css?v=23">
  <link rel="icon" type="image/png" sizes="192x192" href="/images/icon-192.png?v=2">
  <link rel="icon" type="image/png" sizes="512x512" href="/images/icon-512.png?v=2">
  <link rel="manifest" href="/manifest.webmanifest?v=4">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=2">
  <meta name="theme-color" content="#0ea5e9">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="<%= appName %>">
  <meta name="application-name" content="<%= appName %>">
  <style>
    body { background: linear-gradient(180deg, var(--site-bg, #f8fafc) 0%, #fff 100%); }
    .site-topbar { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.9); backdrop-filter: blur(10px); border-bottom: 1px solid var(--card-border); }
    .site-topbar .inner { display: flex; align-items: center; justify-content: space-between; padding: 14px 32px; max-width: 1280px; margin: auto; gap: 16px; flex-wrap: wrap; }
    .site-logo { display: flex; align-items: center; gap: 12px; }
    .site-logo .logo-icon { width: 46px; height: 46px; border-radius: 14px; background: linear-gradient(135deg,#0284c7,#06b6d4); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 4px 12px rgba(2,132,199,.35); }
    .site-logo b { font-size: 18px; }
    .site-nav { display: flex; gap: 4px; flex-wrap: wrap; }
    .site-nav a { padding: 9px 16px; border-radius: 10px; color: var(--text-soft); font-weight: 600; }
    .site-nav a:hover, .site-nav a.active { background: var(--primary-soft); color: var(--primary); }
    .site-sports-rail { position: fixed; top: 74px; bottom: 0; right: 0; width: 210px; z-index: 40; background: rgba(255,255,255,.9); backdrop-filter: blur(10px); border-inline-start: 1px solid var(--card-border); padding: 18px 12px; display: flex; flex-direction: column; gap: 6px; overflow-y: auto; box-shadow: -2px 0 16px rgba(15,23,42,.04); }
    .site-sports-rail .rail-title { font-size: 12px; font-weight: 800; color: var(--text-muted); margin-bottom: 6px; padding-inline-start: 6px; display: flex; align-items: center; gap: 6px; }
    .sport-tab { display: flex; align-items: center; gap: 8px; padding: 9px 12px; border-radius: 12px; font-size: 13px; font-weight: 600; color: var(--text-soft); text-decoration: none; transition: all .15s; }
    .sport-tab i { width: 18px; text-align: center; }
    .sport-tab:hover { background: var(--primary-soft); color: var(--primary); }
    .sport-tab.active { background: var(--primary); color: #fff !important; }
    @media (min-width:1180px){ .site-sports-rail { display: flex; } body.has-sports { padding-right: 250px; } }
    @media (max-width:1179px){ .site-sports-rail { position: static; top: auto; width: 100%; z-index: 40; padding: 10px 16px; flex-direction: row; flex-wrap: wrap; align-items: center; border-inline-start: none; border-top: 1px solid var(--card-border); box-shadow: none; } .site-sports-rail .rail-title { margin: 0 6px 0 0; } .sport-tab { padding: 7px 12px; } }
    .site-hero { padding: 72px 32px 60px; text-align: center; background: linear-gradient(135deg,#0284c7 0%, #0ea5e9 55%, #06b6d4 100%); color: #fff; border-radius: 0 0 40px 40px; position: relative; overflow: hidden; }
    .site-hero h1 { font-size: 40px; margin-bottom: 14px; }
    .site-hero p { font-size: 18px; opacity: .92; max-width: 700px; margin: 0 auto 26px; }
    .site-container { max-width: 1280px; margin: auto; padding: 40px 32px; }
    /* شبكة متوازنة للموقع الخارجي (تغلب على 2fr/1fr في لوحة التحكم) */
    .site-container .dash-grid { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
    /* صور الكباتن في الموقع الخارجي */
    .avatar-xl { width: 84px; height: 84px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; color: #fff; overflow: hidden; flex-shrink: 0; }
    .font-13 { font-size: 13px; }
    .alert { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-radius: 12px; font-size: 13.5px; font-weight: 600; }
    .alert-success { background: rgba(16,185,129,.12); color: #047857; }
    .alert-danger { background: rgba(239,68,68,.12); color: #b91c1c; }
    .alert-warning { background: rgba(245,158,11,.14); color: #b45309; }
    .site-foot { background: #0f172a; color: #cbd5e1; margin-top: 40px; }
    .site-foot .inner { max-width: 1280px; margin: auto; padding: 40px 32px; display: grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap: 24px; }
    .site-foot a { color: #94a3b8; }
    .program-card { border: 1px solid var(--card-border); border-radius: 16px; padding: 22px; background: var(--card); transition: all .2s; display: flex; flex-direction: column; gap: 8px; }
    .program-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--primary); }
    .hero-bg { position: absolute; inset: 0; opacity: .08; font-size: 180px; display: flex; align-items: center; justify-content: center; pointer-events: none; }
    .site-hero > :not(.hero-bg) { position: relative; z-index: 1; }
    @media (max-width:768px){
      .site-hero h1{font-size:28px}
      .site-hero{padding:48px 18px}
      .site-container{padding:24px 16px}
      .site-topbar{position:relative;top:auto}
      .site-topbar .inner{padding:12px 16px;justify-content:center}
      .site-logo{width:100%;justify-content:center}
      .site-nav{width:100%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
      .site-nav a{padding:10px 8px;text-align:center;display:flex;align-items:center;justify-content:center;gap:6px}
      .site-nav a:nth-last-child(-n+2){margin-inline-start:0 !important}
      .site-hero .btn,.site-cta{width:100%;max-width:360px;min-height:46px;justify-content:center}
    }
  </style>
  <% if (typeof data !== 'undefined' && data && /^#[0-9a-fA-F]{6}$/.test(data.primaryColor)) {
    const _clamp = (n) => Math.max(0, Math.min(255, Math.round(n)));
    const _h = data.primaryColor.replace('#','');
    const _R = parseInt(_h.slice(0,2),16)/255, _G = parseInt(_h.slice(2,4),16)/255, _B = parseInt(_h.slice(4,6),16)/255;
    const _lumOf = (hex) => { const h=hex.replace('#',''); const r=parseInt(h.slice(0,2),16)/255,g=parseInt(h.slice(2,4),16)/255,b=parseInt(h.slice(4,6),16)/255; const f=v=>v<=0.03928?v/12.92:Math.pow((v+0.055)/1.055,2.4); return 0.2126*f(r)+0.7152*f(g)+0.0722*f(b); };
    const _mixC = (pct, target) => { const t=parseInt(target.slice(1),16); const tr=(t>>16)&255,tg=(t>>8)&255,tb=t&255; return '#'+[_clamp(_R*255*(1-pct)+tr*pct),_clamp(_G*255*(1-pct)+tg*pct),_clamp(_B*255*(1-pct)+tb*pct)].map(n=>n.toString(16).padStart(2,'0')).join(''); };
    const _dark = _mixC(0.55,'#0f172a');
    const _dark2 = _mixC(0.75,'#0f172a');
    const _soft = _mixC(0.88,'#ffffff');
    const _lightMix = _mixC(0.35,'#ffffff');
    const _lm = _lumOf(data.primaryColor);
    const _onHero = _lumOf(_dark) > 0.5 ? '#0f172a' : '#ffffff';
    const _onLight = _lm > 0.55 ? '#0f172a' : (_lm > 0.32 ? _mixC(0.62,'#000000') : data.primaryColor);
  %>
  <style>
    :root {
      --primary: <%= data.primaryColor %>;
      --primary-dark: <%= _dark %>;
      --primary-light: <%= _lightMix %>;
      --primary-soft: <%= _soft %>;
      --site-grad-dark: <%= _dark2 %>;
      --site-grad-mid: <%= _dark %>;
      --site-grad: <%= data.primaryColor %>;
      --site-grad-light: <%= _lightMix %>;
      --link-on-light: <%= _onLight %>;
    }
    .site-hero { background: linear-gradient(135deg, var(--site-grad-dark) 0%, var(--site-grad-mid) 55%, var(--site-grad-mid) 80%, var(--site-grad) 100%) !important; }
    .site-hero h1, .site-hero p, .site-hero .hero-bg { color: #ffffff !important; }
    .site-logo .logo-icon { background: linear-gradient(135deg, <%= data.primaryColor %>, var(--site-grad-light)) !important; box-shadow: 0 4px 12px <%= _dark %>55 !important; }
    .site-nav a:hover, .site-nav a.active { background: var(--primary-soft); color: <%= _onLight %>; }
    .site-hero .btn-primary { background: <%= data.primaryColor %> !important; color: <%= _lm > 0.4 ? '#0f172a' : '#ffffff' %> !important; }
    /* مساعد الذكاء الاصطناعي العائم */
    .ai-chat-widget { position: fixed; left: 18px; bottom: 18px; z-index: 1000; font-family: inherit; }
    .ai-chat-toggle { width: 56px; height: 56px; border-radius: 50%; background: var(--primary, #0284c7); color: #fff; border: none; box-shadow: 0 4px 14px rgba(2,132,199,.35); font-size: 24px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: transform .15s; }
    .ai-chat-toggle:hover { transform: scale(1.05); }
    .ai-chat-panel { position: absolute; left: 0; bottom: 68px; width: min(360px, calc(100vw - 36px)); background: #fff; border-radius: 18px; box-shadow: 0 8px 30px rgba(15,23,42,.18); overflow: hidden; display: none; flex-direction: column; }
    .ai-chat-panel.show { display: flex; }
    .ai-chat-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--primary, #0284c7); color: #fff; font-weight: 700; }
    .ai-chat-head button { background: transparent; border: none; color: #fff; font-size: 22px; line-height: 1; cursor: pointer; }
    .ai-chat-messages { max-height: 320px; min-height: 160px; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
    .ai-msg { padding: 10px 14px; border-radius: 14px; font-size: 13.5px; line-height: 1.6; max-width: 92%; word-break: break-word; }
    .ai-msg-bot { align-self: flex-start; background: #f1f5f9; color: #0f172a; border-end-start-radius: 4px; }
    .ai-msg-user { align-self: flex-end; background: var(--primary-soft, #e0f2fe); color: #0f172a; border-end-end-radius: 4px; }
    .ai-chat-input-wrap { display: flex; gap: 8px; padding: 10px 14px; border-top: 1px solid #e2e8f0; }
    .ai-chat-input-wrap input { flex: 1; border: 1px solid #cbd5e1; border-radius: 10px; padding: 8px 12px; font-size: 14px; }
    .ai-chat-input-wrap button { background: var(--primary, #0284c7); color: #fff; border: none; border-radius: 10px; padding: 0 14px; cursor: pointer; }
    .ai-chat-note { font-size: 11px; color: #64748b; text-align: center; padding: 6px 12px 10px; }
    @media (max-width: 420px) {
      .ai-chat-widget { left: 12px; bottom: 12px; }
      .ai-chat-panel { width: calc(100vw - 24px); left: 0; }
    }
    /* شريط صور متحرك في الموقع الخارجي */
    .home-carousel { position: relative; border-radius: 18px; overflow: hidden; box-shadow: var(--shadow); aspect-ratio: 16 / 9; max-height: 460px; background: #0f172a; }
    .hc-slides { position: relative; width: 100%; height: 100%; }
    .hc-slide { position: absolute; inset: 0; transform: translateX(100%); transition: transform .5s ease; z-index: 1; }
    .hc-slide.left { transform: translateX(-100%); }
    .hc-slide.right { transform: translateX(100%); }
    .hc-slide.active { transform: translateX(0); z-index: 2; }
    .hc-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .hc-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 5; background: rgba(15,23,42,.55); color: #fff; border: none; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 18px; transition: background .15s; }
    .hc-arrow:hover { background: rgba(15,23,42,.85); }
    .hc-prev { right: 12px; }
    .hc-next { left: 12px; }
    .hc-dots { position: absolute; bottom: 14px; left: 0; right: 0; display: flex; justify-content: center; gap: 8px; z-index: 5; }
    .hc-dot { width: 10px; height: 10px; border-radius: 50%; border: none; background: rgba(255,255,255,.5); cursor: pointer; transition: all .2s; }
    .hc-dot.active { background: #fff; width: 24px; border-radius: 6px; }
    @media (max-width: 600px) {
      .home-carousel { border-radius: 12px; }
      .hc-arrow { width: 36px; height: 36px; font-size: 14px; }
    }
  </style>
  <% } %>
</head>
<body class="<% if (typeof data !== 'undefined' && data.sports && data.sports.length) { %>has-sports<% } %>">
<div class="site-topbar">
  <div class="inner">
    <a href="<%= data.base || '/site' %>" class="site-logo" style="text-decoration:none;color:var(--text)">
      <div class="logo-icon"><% if (data.logo) { %><img src="<%= data.logo %>" alt="logo" class="logo-img"><% } else { %><i class="fas fa-water"></i><% } %></div>
      <div><b><%= data.siteName %></b><div style="font-size:12px;color:var(--text-muted)"><%= data.slogan %></div></div>
    </a>
    <nav class="site-nav">
      <a href="<%= data.base || '/site' %>" class="<%= page === 'home' ? 'active' : '' %>">الرئيسية</a>
      <a href="<%= (data.base || '/site') %>/programs" class="<%= page === 'programs' ? 'active' : '' %>">البرامج</a>
      <a href="<%= (data.base || '/site') %>/coaches" class="<%= page === 'coaches' ? 'active' : '' %>">الكباتن</a>
      <a href="<%= (data.base || '/site') %>/news" class="<%= page === 'news' ? 'active' : '' %>"><i class="fas fa-newspaper"></i> الأخبار والمركز الإعلامي</a>
      <a href="<%= (data.base || '/site') %>/announcements" class="<%= page === 'announcements' ? 'active' : '' %>">الإعلانات</a>
      <a href="<%= (data.base || '/site') %>/contact" class="<%= page === 'contact' ? 'active' : '' %>">تواصل معنا</a>
      <a href="/my-card" class="<%= page === 'my-card' ? 'active' : '' %>"><i class="fas fa-id-card"></i> بطاقتي</a>
      <a href="<%= (data.base || '/site') %>/reserve" class="btn btn-primary btn-sm" style="margin-inline-start:8px"><i class="fas fa-calendar-check"></i> احجز مكانك</a>
      <a href="/login" class="btn btn-primary btn-sm" style="margin-inline-start:6px"><i class="fas fa-right-to-bracket"></i> تسجيل دخول للإدارة</a>
      <button type="button" class="btn btn-outline btn-sm install-app-btn" style="margin-inline-start:6px"><i class="fas fa-download"></i> تثبيت التطبيق</button>
    </nav>
  </div>
</div>
<% if (typeof data !== 'undefined' && data.sports && data.sports.length) { %>
  <div class="site-sports-rail">
    <div class="rail-title"><i class="fas fa-medal"></i> أنشطتنا الرياضية</div>
    <a href="<%= (data.base || '/site') %>/?sport=0" class="sport-tab <%= Number(data.activeSportId || 0) === 0 ? 'active' : '' %>"><i class="fas fa-house"></i> <span>الرئيسية / كل الألعاب</span></a>
    <% data.sports.forEach(function (s) { %>
      <a href="<%= (data.base || '/site') %>/sport/<%= s.id %>" class="sport-tab <%= Number(data.activeSportId || 0) === Number(s.id) ? 'active' : '' %>"><i class="fas <%= s.icon %>"></i> <span><%= s.name %></span></a>
    <% }); %>
  </div>
<% } %>
