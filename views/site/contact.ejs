<%- include('_head', { title: 'تواصل معنا', page: 'contact' }) %>
<div class="site-container" style="max-width:900px">
  <h2 style="margin-bottom:6px">تواصل معنا</h2>
  <p style="color:var(--text-muted);margin-bottom:24px">سجل الآن أو أرسل استفسارك وسنعاود التواصل معك</p>

  <% if (message) { %>
    <div class="card" style="border-color:var(--success)">
      <div class="card-body"><b class="text-success"><i class="fas fa-circle-check"></i> <%= message %></b></div>
    </div>
  <% } %>

  <div class="dash-grid">
    <div class="card">
      <div class="card-body">
        <form method="POST" action="/site/contact" novalidate>
          <div class="form-grid">
            <div class="form-group"><label>الاسم الكامل <span class="req">*</span></label><input type="text" name="name" class="form-control" required></div>
            <div class="form-group"><label>رقم الهاتف</label><input type="tel" name="phone" class="form-control"></div>
            <div class="form-group full"><label>البريد الإلكتروني</label><input type="email" name="email" class="form-control"></div>
            <div class="form-group full"><label>الرسالة <span class="req">*</span></label><textarea name="message" class="form-control" rows="5" required></textarea></div>
            <div class="form-group full"><button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-paper-plane"></i> إرسال</button></div>
          </div>
        </form>
      </div>
    </div>
    <div>
      <div class="card" style="margin-bottom:14px">
        <div class="card-body">
          <div class="detail-grid">
            <div class="detail-item"><div class="dl">الهاتف</div><div class="dv" dir="ltr"><%= data.phone || '—' %></div></div>
            <div class="detail-item"><div class="dl">واتساب</div><div class="dv" dir="ltr"><%= data.whatsapp || '—' %></div></div>
            <div class="detail-item"><div class="dl">البريد</div><div class="dv" dir="ltr"><%= data.email || '—' %></div></div>
            <div class="detail-item"><div class="dl">العنوان</div><div class="dv"><%= data.address || '—' %></div></div>
            <div class="detail-item"><div class="dl">مواعيد العمل</div><div class="dv"><%= data.work_hours || '—' %></div></div>
          </div>
        </div>
      </div>
      <% if (data.safety_notes) { %>
        <div class="card">
          <div class="card-header"><h3><i class="fas fa-shield-halved"></i> إرشادات السلامة</h3></div>
          <div class="card-body"><div class="font-13 text-soft"><%= data.safety_notes %></div></div>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('_foot') %>
