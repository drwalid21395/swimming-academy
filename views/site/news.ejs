<%- include('_head', { title: 'الأخبار والمركز الإعلامي', page: 'news' }) %>
<div class="site-hero" style="padding:56px 32px 48px">
  <div class="hero-bg"><i class="fas fa-newspaper"></i></div>
  <h1><i class="fas fa-newspaper"></i> الأخبار والمركز الإعلامي</h1>
  <p>أحدث أخبار الأكاديمية، المواعيد القادمة، ومعرض الصور والفعاليات</p>
</div>

<div class="site-container">

  <div class="site-tabs" style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:32px">
    <a href="#news" class="site-tab btn" style="padding:10px 20px"><i class="fas fa-bullhorn"></i> الأخبار</a>
    <a href="#events" class="site-tab btn" style="padding:10px 20px"><i class="fas fa-calendar-days"></i> الأحداث والمواعيد</a>
    <a href="#gallery" class="site-tab btn" style="padding:10px 20px"><i class="fas fa-images"></i> معرض الصور</a>
  </div>

  <!-- الأخبار -->
  <div id="news">
    <h2 style="text-align:center;margin-bottom:28px"><i class="fas fa-bullhorn"></i> أخبار الأكاديمية</h2>
    <div class="dash-grid">
      <% news.forEach(function (n) { %>
        <div class="card">
          <% if (n.image) { %>
            <div style="height:200px;overflow:hidden;cursor:pointer" onclick="window.open('<%= n.image %>','_blank')">
              <img src="<%= n.image %>" alt="<%= n.title %>" style="width:100%;height:100%;object-fit:cover;display:block">
            </div>
          <% } %>
          <div class="card-header">
            <h3><i class="fas fa-circle-info"></i> <%= n.title %></h3>
            <span class="font-12 text-muted"><i class="fas fa-clock"></i> <%= fmtDate(n.created_at) %></span>
          </div>
          <div class="card-body"><div class="font-13 text-soft"><%= n.body %></div></div>
        </div>
      <% }); %>
      <% if (!news.length) { %><div class="card"><div class="card-body"><div class="empty-state"><p>لا توجد أخبار منشورة حالياً</p></div></div></div><% } %>
    </div>
  </div>

  <!-- الأحداث / المواعيد القادمة -->
  <div id="events" style="margin-top:44px">
    <h2 style="text-align:center;margin-bottom:28px"><i class="fas fa-calendar-days"></i> الأحداث والمواعيد القادمة</h2>
    <div class="dash-grid">
      <% upcoming.forEach(function (s) { %>
        <div class="card">
          <div class="card-body" style="text-align:center">
            <div style="font-size:34px;color:var(--primary)"><i class="fas fa-person-swimming"></i></div>
            <b style="display:block;margin:8px 0 4px"><%= s.title || (s.group_name || 'حصة تدريبية') %></b>
            <div class="font-13 text-soft">
              <div><i class="fas fa-calendar-day"></i> <%= fmtDate(s.date) %></div>
              <div><i class="fas fa-clock"></i> <%= s.start_time %> - <%= s.end_time || '' %></div>
              <% if (s.coach_name) { %><div><i class="fas fa-user-tie"></i> الكابتن: <%= s.coach_name %></div><% } %>
              <% if (s.pool_name) { %><div><i class="fas fa-person-swimming"></i> <%= s.pool_name %><%= s.branch_name ? ' — ' + s.branch_name : '' %></div><% } %>
            </div>
          </div>
        </div>
      <% }); %>
      <% if (!upcoming.length) { %><div class="card"><div class="card-body"><div class="empty-state"><p>لا توجد مواعيد قادمة حالياً</p></div></div></div><% } %>
    </div>
  </div>

  <!-- معرض الصور -->
  <div id="gallery" style="margin-top:44px">
    <h2 style="text-align:center;margin-bottom:28px"><i class="fas fa-images"></i> معرض الصور</h2>
    <% if (homeImages.length) { %>
      <div class="dash-grid">
        <% homeImages.forEach(function (img) { %>
          <div style="border-radius:16px;overflow:hidden;border:1px solid var(--card-border);box-shadow:var(--shadow);cursor:pointer" onclick="window.open('/uploads/<%= img %>','_blank')">
            <img src="/uploads/<%= img %>" alt="صورة" style="width:100%;height:220px;object-fit:cover;display:block">
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="card"><div class="card-body"><div class="empty-state"><p>لا توجد صور في المعرض بعد</p></div></div></div>
    <% } %>
  </div>

</div>
<%- include('_foot') %>
