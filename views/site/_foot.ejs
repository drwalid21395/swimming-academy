<footer class="site-foot">
  <div class="inner">
    <div>
      <div class="site-logo" style="margin-bottom:10px">
        <div class="logo-icon" style="width:38px;height:38px;font-size:16px"><% if (data.logo) { %><img src="<%= data.logo %>" alt="logo" class="logo-img"><% } else { %><i class="fas fa-water"></i><% } %></div>
        <b style="color:#fff"><%= data.siteName %></b>
      </div>
      <p style="font-size:13px;line-height:1.8;color:#94a3b8"><%= data.about || 'أكاديمية متخصصة في تعليم رياضة السباحة لجميع الأعمار وفق أعلى معايير السلامة والاحتراف.' %></p>
    </div>
    <div>
      <b style="color:#fff;display:block;margin-bottom:10px">الأعضاء</b>
      <a href="/my-card" style="display:block;margin-bottom:8px;font-size:14px"><i class="fas fa-id-card"></i> بطاقتي — استعلم عن بياناتك</a>
    </div>
    <div>
      <b style="color:#fff;display:block;margin-bottom:10px">البرامج</b>
      <a href="<%= (data.base || '/site') %>/programs" style="display:block;margin-bottom:8px;font-size:14px">البرامج والدورات</a>
      <a href="<%= (data.base || '/site') %>/coaches" style="display:block;margin-bottom:8px;font-size:14px">فريق الكباتن</a>
      <a href="<%= (data.base || '/site') %>/announcements" style="display:block;margin-bottom:8px;font-size:14px">آخر الإعلانات</a>
      <a href="<%= (data.base || '/site') %>/contact" style="display:block;font-size:14px">التسجيل والتواصل</a>
    </div>
    <div>
      <b style="color:#fff;display:block;margin-bottom:10px">التواصل</b>
      <div style="font-size:14px;margin-bottom:8px"><i class="fas fa-phone"></i> <% if (data.phone) { %><a href="tel:<%= String(data.phone).replace(/\s+/g, '') %>" style="color:inherit" dir="ltr"><%= data.phone %></a><% } else { %>—<% } %></div>
      <div style="font-size:14px;margin-bottom:8px"><i class="fab fa-whatsapp"></i> <% if (data.whatsapp) { %><a href="https://wa.me/<%= String(data.whatsapp).replace(/\D+/g, '') %>" target="_blank" rel="noopener" style="color:inherit" dir="ltr"><%= data.whatsapp %></a><% } else { %>—<% } %></div>
      <div style="font-size:14px;margin-bottom:8px"><i class="fas fa-envelope"></i> <%= data.email || '—' %></div>
      <div style="font-size:14px"><i class="fas fa-location-dot"></i> <%= data.address || '—' %></div>
    </div>
    <div>
      <b style="color:#fff;display:block;margin-bottom:10px">مواعيد العمل</b>
      <div style="font-size:14px;margin-bottom:12px"><%= data.work_hours || 'السبت - الخميس: 9 ص - 9 م' %></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;font-size:13px">
        <% if (data.facebook) { %><a href="<%= data.facebook %>" target="_blank" style="background:#1e293b;padding:6px 14px;border-radius:999px">فيسبوك</a><% } %>
        <% if (data.instagram) { %><a href="<%= data.instagram %>" target="_blank" style="background:#1e293b;padding:6px 14px;border-radius:999px">انستجرام</a><% } %>
        <% if (data.tiktok) { %><a href="<%= data.tiktok %>" target="_blank" style="background:#1e293b;padding:6px 14px;border-radius:999px">تيك توك</a><% } %>
      </div>
    </div>
  </div>
  <div style="text-align:center;padding:16px;border-top:1px solid #1e293b;font-size:13px;color:#64748b">
    © <%= new Date().getFullYear() %> <%= data.siteName %> — جميع الحقوق محفوظة
  </div>
</footer>
<div class="ai-chat-widget" id="aiChatWidget">
  <button class="ai-chat-toggle" id="aiChatToggle" aria-label="المساعد الذكي"><i class="fas fa-robot"></i></button>
  <div class="ai-chat-panel" id="aiChatPanel" hidden>
    <div class="ai-chat-head"><span><i class="fas fa-robot"></i> مساعد <%= data.siteName %></span><button type="button" id="aiChatClose" aria-label="إغلاق">&times;</button></div>
    <div class="ai-chat-messages" id="aiChatMsgs">
      <div class="ai-msg ai-msg-bot">أهلاً بك! اسألني عن البرامج، الأسعار، الكباتن، مواعيد العمل أو أي شيء تريد معرفته عن الأكاديمية.</div>
    </div>
    <div class="ai-chat-input-wrap">
      <input type="text" id="aiChatInput" placeholder="اكتب سؤالك..." maxlength="1200" aria-label="سؤالك">
      <button type="button" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
    </div>
    <div class="ai-chat-note">الإجابة تُولَّد بالذكاء الاصطناعي بناءً على بيانات الموقع.</div>
  </div>
</div>
<script src="/js/install.js?v=1"></script>
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function () {
      navigator.serviceWorker.register('/sw.js').catch(function () {});
    });
  }

  /* مساعد الذكاء الاصطناعي العام من واجهة الموقع */
  (function () {
    var widget = document.getElementById('aiChatWidget');
    if (!widget) return;
    var toggle = document.getElementById('aiChatToggle');
    var panel = document.getElementById('aiChatPanel');
    var close = document.getElementById('aiChatClose');
    var send = document.getElementById('aiChatSend');
    var input = document.getElementById('aiChatInput');
    var msgs = document.getElementById('aiChatMsgs');
    function esc(s) { return String(s || '').replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function scroll() { msgs.scrollTop = msgs.scrollHeight; }
    function addMsg(text, who) {
      var d = document.createElement('div');
      d.className = 'ai-msg ai-msg-' + who;
      d.innerHTML = text;
      msgs.appendChild(d);
      scroll();
      return d;
    }
    function open() { panel.hidden = false; panel.classList.add('show'); input.focus(); }
    function hide() { panel.classList.remove('show'); setTimeout(function () { panel.hidden = true; }, 160); }
    toggle.addEventListener('click', open);
    close.addEventListener('click', hide);
    function ask() {
      var q = input.value.trim();
      if (!q) return;
      addMsg(esc(q), 'user');
      input.value = '';
      var bot = addMsg('<i class="fas fa-spinner fa-spin"></i> جارٍ التفكير...', 'bot');
      fetch('/api/ask', {
        method: 'POST',
        headers: { 'content-type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ message: q }).toString()
      }).then(function (r) { return r.json(); }).then(function (j) {
        if (j.ok) bot.innerHTML = esc(j.text).replace(/\n/g, '<br>');
        else bot.innerHTML = '<span style="color:#b91c1c"><i class="fas fa-circle-exclamation"></i> ' + esc(j.error) + '</span>';
        scroll();
      }).catch(function () {
        bot.innerHTML = '<span style="color:#b91c1c"><i class="fas fa-circle-exclamation"></i> تعذر الاتصال بالمساعد</span>';
        scroll();
      });
    }
    send.addEventListener('click', ask);
    input.addEventListener('keydown', function (e) { if (e.key === 'Enter') ask(); });
  })();
  /* شريط صور متحرك */
  (function () {
    document.querySelectorAll('[data-carousel]').forEach(function (carousel) {
      var slides = carousel.querySelectorAll('.hc-slide');
      var dots = carousel.querySelectorAll('.hc-dot');
      var prev = carousel.querySelector('[data-prev]');
      var next = carousel.querySelector('[data-next]');
      if (!slides.length) return;
      var current = 0, timer;
      function updateDots() {
        dots.forEach(function (d, i) { d.classList.toggle('active', i === current); });
      }
      function resetClasses() {
        slides.forEach(function (s, i) {
          s.classList.remove('active', 'left', 'right', 'enter-left', 'enter-right', 'exit-left', 'exit-right');
          if (i === current) s.classList.add('active');
          else s.classList.add('right');
        });
        updateDots();
      }
      function go(step) {
        var dir = step > 0 ? 'next' : 'prev';
        var nextIdx = (current + step + slides.length) % slides.length;
        var old = current;
        current = nextIdx;
        slides[old].classList.remove('active');
        slides[old].classList.add(dir === 'next' ? 'exit-left' : 'exit-right');
        slides[nextIdx].classList.remove('right', 'left');
        slides[nextIdx].classList.add(dir === 'next' ? 'enter-right' : 'enter-left');
        void slides[nextIdx].offsetWidth;
        slides[nextIdx].classList.add('active');
        slides[nextIdx].classList.remove('enter-right', 'enter-left');
        slides[old].classList.remove('exit-left', 'exit-right');
        slides[old].classList.add(dir === 'next' ? 'left' : 'right');
        updateDots();
        resetTimer();
      }
      function goTo(idx) {
        if (idx === current) return;
        go(idx > current ? 1 : -1);
      }
      function startTimer() { timer = setInterval(function () { go(1); }, 3000); }
      function resetTimer() { clearInterval(timer); startTimer(); }
      function stopTimer() { clearInterval(timer); }
      if (prev) prev.addEventListener('click', function () { go(-1); });
      if (next) next.addEventListener('click', function () { go(1); });
      dots.forEach(function (d) { d.addEventListener('click', function () { goTo(Number(d.getAttribute('data-index'))); }); });
      carousel.addEventListener('mouseenter', stopTimer);
      carousel.addEventListener('mouseleave', startTimer);
      carousel.addEventListener('touchstart', stopTimer, { passive: true });
      carousel.addEventListener('touchend', function () { setTimeout(startTimer, 3000); }, { passive: true });
      resetClasses();
      startTimer();
    });
  })();
</script>
</body>
</html>
