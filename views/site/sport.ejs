<%- include('_head', { title: (website.title || sport.name), page: 'sport' }) %>
<div class="site-hero">
  <div class="hero-bg"><i class="fas <%= sport.icon %>"></i></div>
  <h1><i class="fas <%= sport.icon %>"></i> <%= website.title || sport.name %></h1>
  <p><%= website.slogan || website.about || sport.description || 'تدريب احترافي ضمن الأكاديمية' %></p>
  <a href="<%= (data.base || '/site') %>/reserve" class="btn btn-lg" style="background:var(--primary);color:#fff;border:2px solid rgba(255,255,255,.65)"><i class="fas fa-calendar-check"></i> احجز مكانك الآن</a>
</div>

<div class="site-container">
  <% var imgs = (website.images || []).filter(function (u) { return u; }); %>
  <% if (website.banner || imgs.length) { %>
    <div style="margin-bottom:32px;max-width:980px;margin-inline:auto">
      <% if (website.banner) { %>
        <div style="border-radius:20px;overflow:hidden;border:1px solid var(--card-border);box-shadow:var(--shadow)">
          <img src="<%= website.banner %>" alt="<%= sport.name %>" style="width:100%;max-height:420px;object-fit:cover;display:block">
        </div>
      <% } %>
      <% if (imgs.length) { %>
        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:14px">
          <% imgs.forEach(function (u) { %>
            <img src="<%= u %>" alt="<%= sport.name %>" style="width:190px;height:130px;object-fit:cover;border-radius:14px;border:1px solid var(--card-border);box-shadow:var(--shadow)">
          <% }); %>
        </div>
      <% } %>
    </div>
  <% } %>

  <h2 style="text-align:center;margin-bottom:8px">برامج <%= sport.name %></h2>
  <p style="text-align:center;color:var(--text-muted);margin-bottom:26px">البرامج المخصصة لهذه اللعبة في الأكاديمية</p>
  <div class="dash-grid">
    <% programs.forEach(function (p) { %>
      <a href="<%= (data.base || '/site') %>/programs/<%= p.id %>" class="program-card" style="text-decoration:none;color:var(--text)">
        <div class="flex justify-between items-center">
          <span class="badge badge-primary"><%= p.type %></span>
          <span class="fw-700" style="color:var(--primary);font-size:18px"><%= money(p.price) %></span>
        </div>
        <b style="font-size:16px"><%= p.name %></b>
        <div style="font-size:13px;color:var(--text-soft)"><%= p.description ? (p.description.length > 90 ? p.description.slice(0,90)+'...' : p.description) : 'برنامج ' + sport.name %></div>
        <div style="font-size:12px;color:var(--text-muted)"><i class="fas fa-stopwatch"></i> <%= p.sessions_count %> حصة — <%= p.session_duration_min %> دقيقة · <i class="fas fa-users"></i> من <%= p.age_from %> حتى <%= p.age_to %> سنة</div>
      </a>
    <% }); %>
    <% if (!programs.length) { %><div class="card"><div class="card-body"><div class="empty-state"><p>لا توجد برامج مضافة لهذه اللعبة بعد</p></div></div></div><% } %>
  </div>

  <h2 style="text-align:center;margin:44px 0 8px">كادر <%= sport.name %></h2>
  <div class="dash-grid">
    <% coaches.forEach(function (c) { %>
      <div class="card" style="text-align:center">
        <div class="card-body">
          <% if (c.avatar) { %>
            <div class="avatar-xl" style="margin:auto;overflow:hidden;background:#e2e8f0"><img src="<%= c.avatar %>" alt="<%= c.full_name %>" style="width:100%;height:100%;object-fit:cover;display:block"></div>
          <% } else { %>
            <div class="avatar-xl" style="margin:auto;background:linear-gradient(135deg,var(--primary),var(--primary-light));color:#fff"><%= (c.full_name || 'ك').trim().charAt(0) %></div>
          <% } %>
          <b style="display:block;margin-top:10px"><%= c.full_name %></b>
          <div class="badge badge-primary" style="margin-top:4px"><%= c.specialization || ('مدرب ' + sport.name) %></div>
          <div class="font-12 text-muted" style="margin-top:6px"><%= c.qualification || '' %> · خبرة <%= c.experience_years || 0 %> سنة</div>
        </div>
      </div>
    <% }); %>
    <% if (!coaches.length) { %><div class="card"><div class="card-body"><div class="empty-state"><p>لا يوجد كباتن مخصصون لهذه اللعبة بعد</p></div></div></div><% } %>
  </div>

  <h2 style="text-align:center;margin:44px 0 8px">إعلانات <%= sport.name %></h2>
  <div class="dash-grid">
    <% announcements.forEach(function (a) { %>
      <div class="card">
        <% if (a.image) { %>
          <div style="height:170px;overflow:hidden;cursor:pointer" onclick="window.open('<%= a.image %>','_blank')">
            <img src="<%= a.image %>" alt="<%= a.title %>" style="width:100%;height:100%;object-fit:cover;display:block">
          </div>
        <% } %>
        <div class="card-header"><h3><i class="fas fa-bullhorn"></i> <%= a.title %></h3><span class="font-12 text-muted"><%= fmtDate(a.created_at) %></span></div>
        <div class="card-body"><div class="font-13 text-soft"><%= a.body %></div></div>
      </div>
    <% }); %>
    <% if (!announcements.length) { %><div class="card"><div class="card-body"><div class="empty-state"><p>لا توجد إعلانات لهذه اللعبة حالياً</p></div></div></div><% } %>
  </div>

  <div style="text-align:center;margin-top:36px">
    <a href="<%= (data.base || '/site') %>/programs" class="btn btn-outline">عرض كل البرامج <i class="fas fa-arrow-left"></i></a>
    <a href="<%= (data.base || '/site') %>/reserve" class="btn btn-primary"><i class="fas fa-calendar-check"></i> احجز مكانك في <%= website.title || sport.name %></a>
  </div>
</div>
<%- include('_foot') %>