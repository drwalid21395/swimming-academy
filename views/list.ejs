<%- include('partials/layout_top', { title: page.title, active: page.active || page.module }) %>
<% var bulk = !!(page.bulkActions && page.bulkActions.length && page.rows && page.rows.length); %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas <%= page.icon || 'fa-list' %>"></i> <%= page.title %></div>
    <div class="page-sub"><%= page.subtitle || '' %><% if (page.rows && page.rows.length) { %> <span class="count-badge">إجمالي السجلات: <%= page.rows.length %></span><% } %></div>
  </div>
  <div class="spacer"></div>
  <div class="flex flex-wrap gap-1" style="align-items:center">
    <% if (page.filters) { page.filters.forEach(function (f) { %>
      <select class="form-control" data-filter-target="<%= f.name %>" style="min-width:150px">
        <option value=""><%= f.label %></option>
        <% (f.options || []).forEach(function (o) { %><option value="<%= o.value %>"><%= o.label %></option><% }); %>
      </select>
    <% }); } %>
    <input type="search" id="tableSearch" class="form-control" placeholder="بحث داخل الجدول..." style="min-width:200px">
    <% if (page.headerActions) { page.headerActions.forEach(function (a) { %>
      <a href="<%= a.href %>" class="btn <%= a.cls || 'btn-outline' %>"><i class="fas <%= a.icon %>"></i> <%= a.label %></a>
    <% }); } %>
    <% if (page.canAdd && page.addUrl) { %>
      <a href="<%= page.addUrl %>" class="btn btn-primary"><i class="fas fa-plus"></i> <%= page.addLabel || 'إضافة جديد' %></a>
    <% } %>
  </div>
</div>

<% if (bulk) { %>
<div class="bulk-bar" data-bulk-url="<%= page.bulkUrl %>">
  <span class="bulk-count"><i class="fas fa-check-double"></i> تم تحديد <b data-bulk-count>0</b> من <%= page.rows.length %></span>
  <div class="spacer"></div>
  <select class="form-control" data-bulk-action style="min-width:220px">
    <option value="">— اختر إجراءً جماعياً —</option>
    <% page.bulkActions.forEach(function (a) { %>
      <option value="<%= a.value %>"<%= a.confirm ? ' data-confirm="' + a.confirm + '"' : '' %>><%= a.label %></option>
    <% }); %>
  </select>
  <button type="button" class="btn btn-danger" data-bulk-apply disabled><i class="fas fa-circle-play"></i> تنفيذ</button>
  <button type="button" class="btn btn-outline" data-bulk-clear disabled><i class="fas fa-xmark"></i> إلغاء التحديد</button>
</div>
<% } %>

<div class="card">
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <% if (bulk) { %><th class="bulk-col"><input type="checkbox" class="bulk-all" title="تحديد الكل" aria-label="تحديد الكل"></th><% } %>
          <% page.columns.forEach(function (col) { %><th class="sortable" title="اضغط للترتيب"><%= col.label %><span class="sort-ind"></span></th><% }); %>
          <% if (page.actions) { %><th>إجراءات</th><% } %>
        </tr>
      </thead>
      <tbody>
        <% if (page.rows && page.rows.length) { %>
          <% page.rows.forEach(function (row) { %>
            <tr data-id="<%= row.id %>" <%- page.filters ? page.filters.map(function (f) { return 'data-' + f.name + '="' + (row[f.name] ?? '') + '"'; }).join(' ') : '' %>>
              <% if (bulk) { %><td class="bulk-col"><input type="checkbox" class="bulk-check" value="<%= row.id %>" aria-label="تحديد السجل"></td><% } %>
              <% page.columns.forEach(function (col) { %>
                <td><% if (col.html) { %><%- col.html(row, user) %><% } else { %><%= row[col.key] !== null && row[col.key] !== undefined ? row[col.key] : '—' %><% } %></td>
              <% }); %>
              <% if (page.actions) { %>
                <td>
                  <div class="table-actions">
                    <% var acts = (typeof page.actions === 'function') ? page.actions() : page.actions; %>
                    <% if (typeof acts === 'function') acts = acts(row); %>
                    <% (acts && acts.forEach ? acts : []).forEach(function (a) { %>
                      <div class="action-cell">
                        <% var ip = a.iconPrefix || 'fas'; %>
                        <% if (a.confirm) { %>
                          <form method="POST" action="<%= a.href %>" style="display:inline;margin:0"><button type="submit" class="btn btn-ghost btn-sm <%= a.cls || '' %>" title="<%= a.label %>" data-confirm="<%= a.confirm %>" data-action="submit"><i class="<%= ip %> <%= a.icon %>"></i> <%= a.label %></button></form>
                        <% } else { %>
                          <a href="<%= a.href %>" class="btn btn-ghost btn-sm <%= a.cls || '' %>" title="<%= a.label %>"><i class="<%= ip %> <%= a.icon %>"></i> <%= a.label %></a>
                        <% } %>
                      </div>
                    <% }); %>
                  </div>
                </td>
              <% } %>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="<%= page.columns.length + (page.actions ? 1 : 0) + (bulk ? 1 : 0) %>">
            <div class="empty-state"><i class="fas fa-folder-open"></i><p>لا توجد بيانات لعرضها</p></div>
          </td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/layout_bottom') %>
