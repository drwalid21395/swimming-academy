<%- include('partials/layout_top', { title, active }) %>
<div class="page-head no-print">
  <div>
    <div class="page-title"><i class="fas fa-folder-open"></i> <%= title %></div>
    <div class="page-sub"><%= total %> سباحاً في <%= groups.length %> مجموعة — طباعة ملونة بهوية الأكاديمية، جاهز للحفظ PDF</div>
  </div>
  <div class="spacer"></div>
  <div class="flex gap-1">
    <button class="btn btn-primary" onclick="window.print()"><i class="fas fa-file-pdf"></i> طباعة / تحميل PDF</button>
    <% if (mode === 'all') { %>
      <a href="/reports/swimmers.xls" class="btn btn-outline"><i class="fas fa-file-excel"></i> تحميل Excel</a>
    <% } else if (groups[0]) { %>
      <a href="/groups/<%= groups[0].id %>/swimmers.xls" class="btn btn-outline"><i class="fas fa-file-excel"></i> تحميل Excel</a>
    <% } %>
    <a href="<%= mode === 'all' ? '/swimmers' : '/groups/' + (groups[0] ? groups[0].id : '') %>" class="btn btn-ghost"><i class="fas fa-arrow-right"></i> رجوع</a>
  </div>
</div>

<!-- ترويسة هوية الأكاديمية -->
<div class="report-cover">
  <div class="cover-logo">
    <% if (siteLogo) { %><img src="<%= siteLogo %>" alt=""><% } else { %><div class="cover-fallback"><i class="fas fa-water"></i></div><% } %>
  </div>
  <div class="cover-text">
    <div class="cover-name"><%= siteName %></div>
    <div class="cover-slogan"><%= (typeof settings !== 'undefined' && settings.slogan) ? settings.slogan : 'نظام الإدارة المتكامل للأكاديمية' %></div>
    <div class="cover-title"><i class="fas fa-folder-open"></i> <%= title %></div>
    <div class="cover-meta">
      <span><i class="fas fa-calendar-day"></i> تاريخ الإصدار: <%= fmtDate(today) %></span>
      <span><i class="fas fa-people-group"></i> <%= total %> سباحاً</span>
      <% if (typeof user !== 'undefined' && user) { %><span><i class="fas fa-user-tie"></i> أُعد بواسطة: <%= user.full_name %></span><% } %>
    </div>
  </div>
  <div class="cover-contact">
    <% if (typeof settings !== 'undefined' && settings.phone) { %><div><i class="fas fa-phone"></i> <b dir="ltr"><%= settings.phone %></b></div><% } %>
    <% if (typeof settings !== 'undefined' && settings.whatsapp) { %><div><i class="fas fa-whatsapp"></i> <b dir="ltr"><%= settings.whatsapp %></b></div><% } %>
    <% if (typeof settings !== 'undefined' && settings.address) { %><div><i class="fas fa-location-dot"></i> <%= settings.address %></div><% } %>
  </div>
</div>

<% groups.forEach(function (g) { %>
  <div class="report-group" style="page-break-before:<%= groups[0] && g === groups[0] ? 'auto' : 'always' %>">
    <div class="group-head">
      <div class="gh-title"><i class="fas fa-people-group"></i> <%= g.name %> <span class="gh-count"><%= g.swimmerCount %> سباح</span></div>
      <div class="gh-meta">
        <% if (g.coach_name) { %><span><i class="fas fa-user-tie"></i> <%= g.coach_name %></span><% } %>
        <% (g.schedule || []).forEach(function (sl) { %><span><i class="fas fa-calendar-day"></i> <%= dayAr(sl.day) %> <%= sl.start %> — <%= sl.end %></span><% }); %>
      </div>
    </div>

    <% if (!g.swimmers.length) { %>
      <div class="empty-state"><i class="fas fa-people-group"></i><p>لا يوجد أعضاء في هذه المجموعة</p></div>
    <% } %>

    <% g.swimmers.forEach(function (s) { %>
      <div class="report-swimmer">
        <div class="sw-head">
          <% if (s.avatar) { %><div class="avatar-lg avatar-img"><img src="<%= s.avatar %>" alt=""></div><% } else { %><div class="avatar-lg"><%= (s.full_name || 'س').trim().charAt(0) %></div><% } %>
          <div class="sw-id">
            <div class="report-name"><%= s.full_name %> <%- statusBadge(s.status) %></div>
            <div class="report-sub"><i class="fas fa-id-card"></i> <%= s.membership_no || '—' %> · <i class="fas fa-signal"></i> <%= s.level_name || '—' %> · <i class="fas fa-user-tie"></i> <%= s.coach_name || '—' %></div>
          </div>
        </div>

        <div class="detail-grid report-grid">
          <div class="detail-item"><div class="dl">العمر</div><div class="dv"><%= s.age === '' || s.age === null ? '—' : s.age + ' سنة' %></div></div>
          <div class="detail-item"><div class="dl">تاريخ الميلاد</div><div class="dv"><%= s.birth_date ? fmtDate(s.birth_date) : '—' %></div></div>
          <div class="detail-item"><div class="dl">النوع</div><div class="dv"><%= s.gender || '—' %></div></div>
          <div class="detail-item"><div class="dl">الهاتف</div><div class="dv"><%= s.phone || '—' %></div></div>
          <div class="detail-item"><div class="dl">العنوان</div><div class="dv"><%= s.address || '—' %></div></div>
          <div class="detail-item"><div class="dl">المدرسة / الدراسة</div><div class="dv"><%= s.school || '—' %></div></div>
          <div class="detail-item"><div class="dl">ولي الأمر</div><div class="dv"><%= (s.guardian && s.guardian.full_name) || '—' %></div></div>
          <div class="detail-item"><div class="dl">هاتف ولي الأمر</div><div class="dv"><%= (s.guardian && s.guardian.phone) || '—' %></div></div>
          <div class="detail-item"><div class="dl">واتساب ولي الأمر</div><div class="dv"><%= (s.guardian && s.guardian.whatsapp) || '—' %></div></div>
        </div>

        <% if (s.docs.length) { %>
          <div class="report-section-title"><i class="fas fa-paperclip"></i> الملفات والصور</div>
          <div class="chip-list" style="margin-bottom:8px">
            <% s.docs.forEach(function (d) { %>
              <a href="<%= d.file_path %>" target="_blank" class="chip chip-link"><i class="fas fa-file"></i> <%= d.title || d.file_name || 'ملف' %></a>
            <% }); %>
          </div>
        <% } %>

        <% if (s.assessments.length) { %>
          <div class="report-section-title"><i class="fas fa-clipboard-check"></i> التقييمات</div>
          <table class="data-table report-table">
            <thead>
              <tr><th>التاريخ</th><th>المستوى</th><th>الكابتن</th><th>النسبة</th><th>جاهز للترقية</th><th>التقييم التالي</th></tr>
            </thead>
            <tbody>
              <% s.assessments.forEach(function (a) { %>
                <tr>
                  <td><b><%= fmtDate(a.date) %></b></td>
                  <td><%= a.level_name || '—' %></td>
                  <td><%= a.coach_name || '—' %></td>
                  <td><b><%= (a.overall_percent !== null && a.overall_percent !== undefined) ? a.overall_percent + '%' : '—' %></b></td>
                  <td><span class="acc-badge <%= a.ready_to_advance ? 'ok' : 'no' %>"><%= a.ready_to_advance ? 'نعم' : 'لا' %></span></td>
                  <td><%= a.next_assessment_date ? fmtDate(a.next_assessment_date) : '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    <% }); %>
  </div>
<% }); %>

<style>
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

  /* ===== ترويسة هوية الأكاديمية ===== */
  .report-cover {
    background: linear-gradient(135deg, #075985 0%, #0284c7 55%, #38bdf8 100%);
    color: #fff;
    border-radius: 16px;
    padding: 24px 28px;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
  }
  .report-cover::after {
    content: ''; position: absolute; inset-inline-end: -70px; bottom: -70px;
    width: 240px; height: 240px; border-radius: 50%;
    background: rgba(255,255,255,.09);
  }
  .report-cover::before {
    content: ''; position: absolute; inset-inline-start: 30%; top: -90px;
    width: 200px; height: 200px; border-radius: 50%;
    background: rgba(255,255,255,.06);
  }
  .cover-logo { flex-shrink: 0; z-index: 2; }
  .cover-logo img { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; border: 3px solid rgba(255,255,255,.7); background: #fff; display: block; }
  .cover-fallback { width: 84px; height: 84px; border-radius: 50%; background: rgba(255,255,255,.25); border: 3px solid rgba(255,255,255,.7); display: flex; align-items: center; justify-content: center; font-size: 38px; }
  .cover-text { flex: 1; position: relative; z-index: 2; }
  .cover-name { font-size: 26px; font-weight: 900; letter-spacing: .3px; }
  .cover-slogan { font-size: 13px; opacity: .9; margin-top: 2px; }
  .cover-title { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,.18); border-radius: 999px; padding: 5px 16px; font-size: 15px; font-weight: 800; margin-top: 12px; }
  .cover-meta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 12px; font-size: 12.5px; }
  .cover-meta span { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,.14); padding: 4px 12px; border-radius: 999px; }
  .cover-contact { position: relative; z-index: 2; font-size: 12.5px; line-height: 2; text-align: left; }
  .cover-contact div { display: flex; align-items: center; gap: 8px; justify-content: flex-end; }

  /* ===== رأس كل مجموعة ===== */
  .group-head {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    background: linear-gradient(90deg, #e0f2fe, #f0f9ff);
    border-inline-start: 6px solid #0284c7;
    border-radius: 12px;
    padding: 10px 18px;
    margin-bottom: 14px;
  }
  .gh-title { font-size: 17px; font-weight: 900; color: #0c4a6e; display: flex; align-items: center; gap: 9px; }
  .gh-count { background: #0284c7; color: #fff; border-radius: 999px; padding: 2px 12px; font-size: 12.5px; font-weight: 800; }
  .gh-meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12px; color: #075985; }
  .gh-meta span { display: inline-flex; align-items: center; gap: 5px; }

  /* ===== بطاقة السباح ===== */
  .report-swimmer { padding: 8px 0 4px; }
  .sw-head { display: flex; align-items: center; gap: 14px; }
  .avatar-lg {
    width: 62px; height: 62px; border-radius: 50%;
    background: linear-gradient(135deg, #0284c7, #38bdf8);
    color: #fff; display: flex; align-items: center; justify-content: center;
    font-size: 26px; font-weight: 800; flex-shrink: 0;
    border: 3px solid #bae6fd;
  }
  .avatar-img { overflow: hidden; }
  .avatar-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .report-name { font-size: 17px; font-weight: 800; color: #0f172a; }
  .report-sub { font-size: 12.5px; color: #475569; margin-top: 4px; }
  .report-grid { margin-top: 10px; }

  .report-section-title { font-size: 13.5px; font-weight: 900; color: #0c4a6e; margin: 12px 0 6px; display: flex; align-items: center; gap: 7px; }
  .report-section-title i { color: #0284c7; }

  .chip-link { text-decoration: none; color: #0369a1; }
  .report-table td, .report-table th { font-size: 12.5px; }
  .report-table thead th { background: #e0f2fe; color: #0c4a6e; }
  .acc-badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 800; }
  .acc-badge.ok { background: rgba(16,185,129,.15); color: #047857; }
  .acc-badge.no { background: rgba(239,68,68,.12); color: #b91c1c; }

  @media print {
    .print-header { display: none !important; }
    .report-cover { border-radius: 0; margin: -6px -2px 18px; }
    .group-head { page-break-inside: avoid; }
    .report-swimmer { page-break-inside: avoid; }
    .report-table { page-break-inside: auto; }
  }
</style>
<%- include('partials/layout_bottom') %>
