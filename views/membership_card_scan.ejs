<%- include('partials/layout_top', { title: title, active: active }) %>
<style>
  .mc-scan-wrap { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:16px; align-items:start; }
  .mc-scan-wrap > * { min-width:0; }

  .mc-cam-card { padding:0; overflow:hidden; }
  .mc-stage { position:relative; background:#04121f; aspect-ratio:4/3; display:flex; align-items:center; justify-content:center; }
  .mc-stage video { width:100%; height:100%; object-fit:cover; display:block; background:#04121f; }
  .mc-overlay[hidden], .mc-cam-idle[hidden] { display:none !important; }
  .mc-overlay { position:absolute; inset:0; pointer-events:none; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding:24px; }
  .mc-frame { position:relative; width:78%; max-width:420px; aspect-ratio:2.6/1; border-radius:14px; box-shadow:0 0 0 100vmax rgba(2,15,26,.42); border:2px solid rgba(125,211,252,.75); }
  .mc-frame::before, .mc-frame::after { content:''; position:absolute; width:22px; height:22px; border:3px solid #38bdf8; }
  .mc-frame::before { inset-block-start:-3px; inset-inline-start:-3px; border-inline-end:0; border-block-end:0; border-start-start-radius:12px; }
  .mc-frame::after { inset-block-end:-3px; inset-inline-end:-3px; border-inline-start:0; border-block-start:0; border-end-end-radius:12px; }
  .mc-laser { position:absolute; inset-inline:6px; height:2px; background:linear-gradient(90deg, transparent, #38bdf8, transparent); box-shadow:0 0 12px #38bdf8; animation:mcLaser 2.1s ease-in-out infinite; }
  @keyframes mcLaser { 0%,100% { top:12%; } 50% { top:86%; } }
  .mc-cam-hint { font-size:12px; color:#e0f2fe; background:rgba(2,15,26,.6); padding:5px 12px; border-radius:20px; }
  .mc-cam-idle { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; text-align:center; padding:24px; background:radial-gradient(circle at 50% 30%, #0b2b45, #04121f 70%); color:#e0f2fe; }
  .mc-cam-idle i { font-size:44px; color:#38bdf8; }
  .mc-cam-idle p { margin:0; font-size:14px; font-weight:700; }
  .mc-cam-idle small { color:#94a3b8; font-size:12px; max-width:280px; line-height:1.7; }
  .mc-cam-idle .btn { min-height:44px; }

  .mc-cam-toolbar { display:flex; flex-wrap:wrap; gap:10px; align-items:center; padding:12px 14px; border-top:1px solid var(--card-border); }
  .mc-mode-group { display:inline-flex; background:var(--bg-soft); border:1px solid var(--card-border); border-radius:12px; padding:3px; gap:3px; }
  .mc-mode-group button { border:0; background:transparent; color:var(--text-muted); font-weight:700; font-size:13px; padding:8px 16px; border-radius:9px; cursor:pointer; }
  .mc-mode-group button.active[data-mode="present"] { background:#16a34a; color:#fff; box-shadow:0 2px 8px rgba(22,163,74,.35); }
  .mc-mode-group button.active[data-mode="absent"] { background:#dc2626; color:#fff; box-shadow:0 2px 8px rgba(220,38,38,.35); }
  .mc-vol { display:flex; align-items:center; gap:8px; color:var(--text-muted); font-size:12px; flex:1 1 190px; min-width:0; }
  .mc-vol input[type="range"] { flex:1; min-width:70px; accent-color:var(--primary); }
  .mc-vol span { min-width:34px; text-align:center; font-weight:700; }
  .mc-vol button { border:1px solid var(--card-border); background:var(--card); color:var(--text-muted); border-radius:8px; padding:5px 9px; font-size:11px; cursor:pointer; }
  .mc-cam-toolbar .btn { min-height:38px; }

  .mc-result { border-radius:16px; padding:20px; border:2px solid var(--card-border); background:var(--card); text-align:center; transition:border-color .2s, background .2s; }
  .mc-result .rs-icon { width:62px; height:62px; border-radius:50%; margin:0 auto 12px; display:flex; align-items:center; justify-content:center; font-size:25px; background:var(--bg-soft); color:var(--text-muted); }
  .mc-result .rs-name { font-size:21px; font-weight:800; overflow-wrap:anywhere; }
  .mc-result .rs-meta { font-size:12px; color:var(--text-muted); margin-top:4px; overflow-wrap:anywhere; }
  .mc-result .rs-msg { font-size:13px; margin-top:10px; font-weight:700; }
  .mc-result .rs-time { font-size:11px; color:var(--text-muted); margin-top:6px; letter-spacing:1px; }
  .mc-result[data-state="success"] { border-color:#16a34a; background:rgba(22,163,74,.06); }
  .mc-result[data-state="success"] .rs-icon { background:#dcfce7; color:#16a34a; }
  .mc-result[data-state="success"] .rs-msg { color:#15803d; }
  .mc-result[data-state="duplicate"] { border-color:#f59e0b; background:rgba(245,158,11,.08); }
  .mc-result[data-state="duplicate"] .rs-icon { background:#fef3c7; color:#b45309; }
  .mc-result[data-state="duplicate"] .rs-msg { color:#b45309; }
  .mc-result[data-state="error"] { border-color:#dc2626; background:rgba(220,38,38,.06); }
  .mc-result[data-state="error"] .rs-icon { background:#fee2e2; color:#dc2626; }
  .mc-result[data-state="error"] .rs-msg { color:#b91c1c; }
  .mc-result[data-state="scanning"] .rs-icon { background:var(--primary-soft); color:var(--primary); }

  .mc-stat-row { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:14px; }
  .mc-stat-row .it { background:var(--card); border:1px solid var(--card-border); border-radius:12px; padding:10px 12px; display:flex; align-items:center; gap:10px; }
  .mc-stat-row .it i { font-size:16px; }
  .mc-stat-row .it b { font-size:18px; display:block; line-height:1.1; }
  .mc-stat-row .it span { font-size:11px; color:var(--text-muted); }
  .mc-stat-row .present i { color:#16a34a; }
  .mc-stat-row .absent i { color:#dc2626; }

  .mc-manual { margin-top:14px; }
  .mc-manual label { font-size:12px; color:var(--text-muted); font-weight:700; margin-bottom:6px; display:block; }
  .mc-manual .row { display:flex; gap:8px; }
  .mc-manual input { flex:1; min-width:0; direction:ltr; text-align:left; letter-spacing:1px; font-weight:700; }
  .mc-manual .btn { flex:none; min-height:42px; }

  .mc-recent { margin-top:14px; }
  .mc-recent h4 { margin:0 0 10px; font-size:13px; display:flex; align-items:center; gap:8px; }
  .mc-recent h4 .badge { background:var(--bg-soft); border:1px solid var(--card-border); border-radius:20px; padding:2px 9px; font-size:11px; color:var(--text-muted); }
  .mc-recent-list { display:flex; flex-direction:column; gap:8px; max-height:330px; overflow:auto; }
  .mc-scan-item { display:flex; align-items:center; gap:10px; padding:9px 10px; border-radius:11px; background:var(--bg-soft); border:1px solid var(--card-border); animation:mcIn .25s ease; }
  @keyframes mcIn { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:none; } }
  .mc-scan-item .ic { width:32px; height:32px; border-radius:9px; display:flex; align-items:center; justify-content:center; flex:none; font-size:13px; }
  .mc-scan-item.present .ic { background:#dcfce7; color:#16a34a; }
  .mc-scan-item.absent .ic { background:#fee2e2; color:#dc2626; }
  .mc-scan-item.duplicate .ic { background:#fef3c7; color:#b45309; }
  .mc-scan-item .tx { min-width:0; flex:1; }
  .mc-scan-item .tx b { display:block; font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .mc-scan-item .tx small { color:var(--text-muted); font-size:11px; display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .mc-scan-item .tm { font-size:11px; color:var(--text-muted); flex:none; direction:ltr; }
  .mc-recent .empty-mini { font-size:12px; color:var(--text-muted); text-align:center; padding:14px 0; }

  @media (max-width:900px) {
    .mc-scan-wrap { grid-template-columns:1fr; }
    .mc-stage { aspect-ratio:3/2; }
  }
  @media (max-width:520px) {
    .mc-cam-toolbar { gap:8px; }
    .mc-mode-group { flex:1 1 100%; justify-content:center; }
    .mc-mode-group button { flex:1; }
    .mc-vol { flex:1 1 100%; }
    .mc-result .rs-name { font-size:18px; }
    .mc-manual .row { flex-wrap:wrap; }
    .mc-manual .btn { flex:1 1 100%; }
  }

  .mc-roster-card { margin-top:16px; }
  .mc-roster-head { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  .mc-roster-search { min-width:180px; max-width:280px; }
  .mc-roster-group { padding:0; margin-bottom:14px; border:1px solid var(--card-border); border-radius:14px; overflow:hidden; }
  .mc-roster-group:last-child { margin-bottom:0; }
  .mc-roster-group .att-group-head { padding:12px 14px; background:var(--bg-soft); display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  .mc-roster-group .att-group-head h4 { margin:0; font-size:15px; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .mc-roster-group .att-card { padding:8px 14px 14px; }
  .mc-roster-group .att-row { padding:8px 0; }
  .mc-row-hit { background:rgba(22,163,74,.12); border-radius:10px; transition:background .3s; }
  .mc-empty-roster { text-align:center; color:var(--text-muted); padding:18px; font-size:13px; }
</style>

<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-qrcode"></i> مسح الباركود</div>
    <div class="page-sub">تسجيل الحضور والغياب بمسح باركود بطاقة العضوية</div>
  </div>
  <div class="spacer"></div>
  <div class="flex gap-1" style="flex-wrap:wrap">
    <a href="/attendance" class="btn btn-outline"><i class="fas fa-clipboard-user"></i> الحضور والغياب</a>
    <a href="/attendance" class="btn btn-ghost"><i class="fas fa-arrow-right"></i> رجوع</a>
  </div>
</div>

<div class="mc-scan-wrap">
  <div class="card mc-cam-card">
    <div class="mc-stage" id="stage">
      <video id="cam" playsinline autoplay muted></video>
      <div class="mc-overlay" id="overlay" hidden>
        <div class="mc-frame"><div class="mc-laser"></div></div>
        <div class="mc-cam-hint"><i class="fas fa-camera"></i> ضع الباركود داخل الإطار</div>
      </div>
      <div class="mc-cam-idle" id="camIdle">
        <i class="fas fa-camera-retro"></i>
        <p>الكاميرا متوقفة</p>
        <small>اضغط الزر لبدء المسح. سيطلب المتصفح إذن استخدام الكاميرا — اسمح به لتسجيل الحضور بالباركود.</small>
        <button type="button" class="btn btn-primary" id="startCam"><i class="fas fa-play"></i> تشغيل الكاميرا</button>
      </div>
    </div>

    <div class="mc-cam-toolbar">
      <div class="mc-mode-group" id="modeGroup">
        <button type="button" data-mode="present" class="active"><i class="fas fa-user-check"></i> حضور</button>
        <button type="button" data-mode="absent"><i class="fas fa-user-xmark"></i> غياب</button>
      </div>
      <div class="mc-vol">
        <i class="fas fa-volume-high"></i>
        <input type="range" id="volume" min="0" max="100" step="5" value="70" aria-label="مستوى صوت المسح">
        <span id="volLabel">70%</span>
        <button type="button" id="testSound" title="تجربة الصوت">تجربة</button>
      </div>
      <button type="button" class="btn btn-outline" id="captureScan" disabled title="التقاط صورة وقراءة الباركود يدوياً"><i class="fas fa-camera"></i> مسح لقطة</button>
      <button type="button" class="btn btn-outline" id="torchBtn" disabled title="تشغيل/إطفاء الفلاش"><i class="fas fa-bolt"></i></button>
      <button type="button" class="btn btn-outline" id="stopCam" disabled><i class="fas fa-stop"></i> إيقاف</button>
    </div>
  </div>

  <div>
    <div class="mc-result" id="result" data-state="idle">
      <div class="rs-icon"><i class="fas fa-barcode"></i></div>
      <div class="rs-name" id="rsName">جاهز للمسح</div>
      <div class="rs-meta" id="rsMeta">شغّل الكاميرا أو أدخل رقم العضوية يدوياً</div>
      <div class="rs-msg" id="rsMsg"></div>
      <div class="rs-time" id="rsTime"></div>
      <div class="rs-attempts" id="rsAttempts" style="font-size:11px;color:var(--text-muted);margin-top:6px;min-height:16px;"></div>
    </div>

    <div class="mc-stat-row">
      <div class="it present"><i class="fas fa-user-check"></i><div><b id="statPresent"><%= Number(stats.present || 0) %></b><span>حضور اليوم</span></div></div>
      <div class="it absent"><i class="fas fa-user-xmark"></i><div><b id="statAbsent"><%= Number(stats.absent || 0) %></b><span>غياب اليوم</span></div></div>
    </div>

    <div class="card mc-manual">
      <div class="card-body">
        <form id="manualForm" autocomplete="off">
          <label for="manualCode"><i class="fas fa-keyboard"></i> إدخال يدوي / قارئ باركود USB</label>
          <div class="row">
            <input type="text" id="manualCode" class="form-control" placeholder="SW-0001" inputmode="text" maxlength="40">
            <button type="submit" class="btn btn-primary"><i class="fas fa-arrow-left"></i> تسجيل</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card mc-recent">
      <div class="card-body">
        <h4><i class="fas fa-clock-rotate-left"></i> أحدث عمليات المسح <span class="badge" id="recentCount"><%= (recent || []).length %></span></h4>
        <div class="mc-recent-list" id="recentList">
          <% (recent || []).forEach(function (r) { %>
            <% var stateClass = r.result === 'duplicate' ? 'duplicate' : (r.mode === 'absent' ? 'absent' : 'present'); %>
            <div class="mc-scan-item <%= stateClass %>">
              <div class="ic"><i class="fas <%= stateClass === 'present' ? 'fa-check' : stateClass === 'absent' ? 'fa-xmark' : 'fa-triangle-exclamation' %>"></i></div>
              <div class="tx">
                <b><%= r.full_name || '—' %></b>
                <small><%= r.program_name || (r.mode === 'absent' ? 'غياب' : 'حضور') %><%= r.result === 'duplicate' ? ' — مسجّل مسبقاً' : '' %></small>
              </div>
              <div class="tm"><%= r.scan_time || '' %></div>
            </div>
          <% }); %>
          <% if (!recent || !recent.length) { %>
            <div class="empty-mini" id="recentEmpty">لا توجد عمليات مسح اليوم بعد</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card mc-roster-card" id="rosterCard">
  <div class="card-header mc-roster-head">
    <h3 style="margin:0"><i class="fas fa-users"></i> قائمة الحضور التلقائي
      <span class="badge badge-primary"><%= attDate %></span>
      <% if (sessionId) { %><span class="badge badge-warning">حصة محددة</span><% } %>
    </h3>
    <div class="spacer" style="flex:1"></div>
    <input type="search" id="rosterSearch" class="form-control mc-roster-search" placeholder="ابحث باسم اللاعب أو رقم العضوية..." autocomplete="off">
    <span class="badge badge-success"><i class="fas fa-bolt"></i> حفظ تلقائي</span>
  </div>
  <div class="card-body">
    <p class="text-muted font-12" style="margin:0 0 12px">
      كل أسماء اللاعبين ظاهرة تلقائياً. المسح يسجّل اللاعب <b>حاضراً</b>، وباقي اللاعبين يُسجّلون <b>غائبين تلقائياً</b> عند أول مسح.
      يمكنك أيضاً تغيير حالة أي لاعب بالضغط على الزر المناسب — يُحفظ فوراً.
    </p>
    <% if (!groups || !groups.length) { %>
      <div class="mc-empty-roster"><i class="fas fa-people-group"></i> لا توجد مجموعات أو لاعبون لعرضهم.</div>
    <% } %>
    <% groups.forEach(function (g) { %>
      <% var cardSession = g.session_id || (g.session && g.session.id) || ''; %>
      <div class="mc-roster-group" data-session-card="<%= cardSession %>" data-group-card="<%= g.id %>">
        <div class="att-group-head">
          <h4><i class="fas fa-people-group"></i> <%= g.name %>
            <% if (g.session) { %><span class="badge badge-success"><i class="fas fa-clock"></i> <%= g.session.start_time || '' %></span><% } else { %><span class="badge badge-gray">لا توجد حصة</span><% } %>
          </h4>
          <span class="text-muted font-12"><i class="fas fa-user-tie"></i> <%= g.coach_name || '—' %> · <b><%= g.members.length %></b> لاعب</span>
          <div class="spacer" style="flex:1"></div>
          <span class="badge badge-success" data-group-present="<%= g.id %>">0 حاضر</span>
          <span class="badge badge-danger" data-group-absent="<%= g.id %>">0 غائب</span>
        </div>
        <div class="att-card">
          <% if (!g.members || !g.members.length) { %>
            <div class="mc-empty-roster">لا يوجد لاعبون في هذه المجموعة.</div>
          <% } else if (!cardSession || !canScan) { %>
            <div class="mc-empty-roster">لا يمكن تعديل الحضور لهذه المجموعة.</div>
          <% } else { %>
            <div class="flex gap-1" style="margin:8px 0 10px;flex-wrap:wrap">
              <button type="button" class="btn btn-success btn-sm" data-mark-all="present" data-session="<%= cardSession %>"><i class="fas fa-check"></i> الكل حاضر</button>
              <button type="button" class="btn btn-outline-danger btn-sm" data-mark-all="absent" data-session="<%= cardSession %>"><i class="fas fa-xmark"></i> الكل غائب</button>
              <button type="button" class="btn btn-outline-warning btn-sm" data-mark-all="excused" data-session="<%= cardSession %>"><i class="fas fa-book"></i> الكل معتذر</button>
            </div>
            <div class="att-row" style="border-bottom-width:2px">
              <div class="att-name"><b>اللاعب</b></div>
              <div class="att-btns">
                <span class="att-btn att-head" title="حاضر" style="cursor:default"><i class="fas fa-check"></i> <span>حاضر</span></span>
                <span class="att-btn att-head" title="غائب" style="cursor:default"><i class="fas fa-xmark"></i> <span>غائب</span></span>
                <span class="att-btn att-head" title="معتذر" style="cursor:default"><i class="fas fa-book"></i> <span>معتذر</span></span>
                <span class="att-btn att-head" title="متأخر" style="cursor:default"><i class="fas fa-clock"></i> <span>متأخر</span></span>
              </div>
            </div>
            <% g.members.forEach(function (m) { %>
              <% var st = g.attMap[m.id] || 'absent'; %>
              <div class="att-row" data-swimmer-row="<%= m.id %>" data-search="<%= (m.full_name + ' ' + (m.membership_no || '')).toLowerCase() %>">
                <div class="att-name">
                  <div class="flex items-center gap-1">
                    <div class="avatar-sm"><%= (m.full_name || 'س').trim().charAt(0) %></div>
                    <div>
                      <b><%= m.full_name %></b>
                      <div class="font-11 text-muted"><%= m.membership_no || '' %></div>
                    </div>
                  </div>
                </div>
                <div class="att-btns">
                  <button type="button" class="att-btn <%= st === 'present' ? 'active-present' : '' %>" data-status="present" data-swimmer="<%= m.id %>" data-session="<%= cardSession %>" title="حاضر"><i class="fas fa-check"></i> <span>حاضر</span></button>
                  <button type="button" class="att-btn <%= st === 'absent' ? 'active-absent' : '' %>" data-status="absent" data-swimmer="<%= m.id %>" data-session="<%= cardSession %>" title="غائب"><i class="fas fa-xmark"></i> <span>غائب</span></button>
                  <button type="button" class="att-btn <%= st === 'excused' ? 'active-excused' : '' %>" data-status="excused" data-swimmer="<%= m.id %>" data-session="<%= cardSession %>" title="معتذر"><i class="fas fa-book"></i> <span>معتذر</span></button>
                  <button type="button" class="att-btn <%= st === 'late' ? 'active-late' : '' %>" data-status="late" data-swimmer="<%= m.id %>" data-session="<%= cardSession %>" title="متأخر"><i class="fas fa-clock"></i> <span>متأخر</span></button>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<script>
(function () {
  'use strict';
  var canScan = <%- canScan ? 'true' : 'false' %>;
  var pageSessionId = <%- sessionId || 0 %>;
  var video = document.getElementById('cam');
  var overlay = document.getElementById('overlay');
  var camIdle = document.getElementById('camIdle');
  var startBtn = document.getElementById('startCam');
  var stopBtn = document.getElementById('stopCam');
  var captureBtn = document.getElementById('captureScan');
  var torchBtn = document.getElementById('torchBtn');
  var modeGroup = document.getElementById('modeGroup');
  var volumeInput = document.getElementById('volume');
  var volLabel = document.getElementById('volLabel');
  var testSoundBtn = document.getElementById('testSound');
  var manualForm = document.getElementById('manualForm');
  var manualCode = document.getElementById('manualCode');
  var resultBox = document.getElementById('result');
  var rsName = document.getElementById('rsName');
  var rsMeta = document.getElementById('rsMeta');
  var rsMsg = document.getElementById('rsMsg');
  var rsTime = document.getElementById('rsTime');
  var rsAttempts = document.getElementById('rsAttempts');
  var recentList = document.getElementById('recentList');
  var recentCount = document.getElementById('recentCount');
  var statPresent = document.getElementById('statPresent');
  var statAbsent = document.getElementById('statAbsent');

  var mode = 'present';
  var reader = null;
  var scanning = false;
  var submitting = false;
  var lastCode = '';
  var lastCodeAt = 0;
  var audioCtx = null;
  var volume = 0.7;
  var torchTrack = null;
  var torchOn = false;
  var activeStream = null;
  var scanAttempts = 0;
  var snapReader = null;
  var snapCanvas = null;
  var snapBusy = false;
  var noReadTimer = null;

  try {
    var saved = parseFloat(localStorage.getItem('mcScanVolume'));
    if (!isNaN(saved)) volume = Math.min(1, Math.max(0, saved));
  } catch (e) { /* التخزين غير متاح */ }
  volumeInput.value = String(Math.round(volume * 100));
  volLabel.textContent = Math.round(volume * 100) + '%';

  /* ---------------- صيغ الباركود ---------------- */
  /* الماسح المستمر يقرأ كل صيغ الباركود الخطية الشائعة بسرعة،
     واللقطة الاحتياطية تضيف الصيغ ثنائية الأبعاد ووضع المحاولة الجادّة */
  function barcodeFormats(include2d) {
    var B = window.ZXing && window.ZXing.BarcodeFormat;
    if (!B) return null;
    var names = ['CODE_39', 'CODE_93', 'CODE_128', 'CODABAR', 'EAN_8', 'EAN_13', 'ITF', 'UPC_A', 'UPC_E', 'RSS_14'];
    if (include2d) names = names.concat(['QR_CODE', 'DATA_MATRIX', 'PDF_417', 'AZTEC']);
    var list = [];
    names.forEach(function (name) { if (B[name]) list.push(B[name]); });
    return list.length ? list : null;
  }

  function buildHints(tryHarder, include2d) {
    var hints = new Map();
    try {
      var D = window.ZXing.DecodeHintType;
      if (tryHarder) hints.set(D.TRY_HARDER, true);
      var formats = barcodeFormats(include2d);
      if (formats) hints.set(D.POSSIBLE_FORMATS, formats);
      if (D.ALSO_INVERTED) hints.set(D.ALSO_INVERTED, true);
    } catch (e) { }
    return hints;
  }

  /* ---------------- الصوت ---------------- */
  function ensureAudio() {
    if (!audioCtx) {
      var Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) return null;
      try { audioCtx = new Ctx(); } catch (e) { audioCtx = null; }
    }
    if (audioCtx && audioCtx.state === 'suspended') { try { audioCtx.resume(); } catch (e) { } }
    return audioCtx;
  }

  function tone(ctx, freq, start, duration, type, gainValue) {
    var osc = ctx.createOscillator();
    var gain = ctx.createGain();
    osc.type = type || 'sine';
    osc.frequency.value = freq;
    var t0 = ctx.currentTime + start;
    gain.gain.setValueAtTime(0.0001, t0);
    gain.gain.linearRampToValueAtTime(Math.max(0.0001, gainValue), t0 + 0.012);
    gain.gain.exponentialRampToValueAtTime(0.0001, t0 + duration);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(t0);
    osc.stop(t0 + duration + 0.03);
  }

  function playSound(kind) {
    if (volume <= 0) return;
    var ctx = ensureAudio();
    if (!ctx) return;
    var v = Math.min(1, volume);
    if (kind === 'success') {
      tone(ctx, 880, 0, 0.1, 'sine', v * 0.55);
      tone(ctx, 1320, 0.1, 0.14, 'sine', v * 0.5);
    } else if (kind === 'duplicate') {
      tone(ctx, 620, 0, 0.13, 'triangle', v * 0.5);
      tone(ctx, 420, 0.15, 0.2, 'triangle', v * 0.5);
    } else {
      tone(ctx, 220, 0, 0.32, 'sawtooth', v * 0.4);
    }
    if (navigator.vibrate) {
      try { navigator.vibrate(kind === 'success' ? 55 : [40, 55, 40]); } catch (e) { }
    }
  }

  /* ---------------- عرض النتيجة ---------------- */
  function showResult(state, name, meta, message) {
    resultBox.setAttribute('data-state', state);
    var icons = {
      idle: 'fa-barcode', scanning: 'fa-qrcode', success: 'fa-circle-check',
      duplicate: 'fa-triangle-exclamation', error: 'fa-circle-xmark'
    };
    resultBox.querySelector('.rs-icon').innerHTML = '<i class="fas ' + (icons[state] || icons.idle) + '"></i>';
    rsName.textContent = name || '';
    rsMeta.textContent = meta || '';
    rsMsg.textContent = message || '';
    var d = new Date();
    rsTime.textContent = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0') + ':' + String(d.getSeconds()).padStart(2, '0');
  }

  function bumpAttempt() {
    scanAttempts++;
    if (rsAttempts) rsAttempts.textContent = 'محاولات القراءة: ' + scanAttempts;
  }

  function clearAttempts() {
    scanAttempts = 0;
    if (rsAttempts) rsAttempts.textContent = '';
  }

  function clearNoReadTimer() {
    if (noReadTimer) { clearTimeout(noReadTimer); noReadTimer = null; }
  }

  function scheduleNoReadHint() {
    clearNoReadTimer();
    noReadTimer = setTimeout(function () {
      if (!scanning || submitting) return;
      showResult('scanning', 'لم يُقرأ الباركود بعد', 'قرّب الكاميرا من الباركود وثبّتها، أو اضغط «مسح لقطة»', 'تأكد من وضوح الإضاءة وعدم انعكاس الضوء على البطاقة');
    }, 9000);
  }

  function prependRecent(data, ok) {
    var empty = document.getElementById('recentEmpty');
    if (empty) empty.remove();
    var stateClass = data.status === 'duplicate' ? 'duplicate' : (data.mode === 'absent' ? 'absent' : 'present');
    var item = document.createElement('div');
    item.className = 'mc-scan-item ' + stateClass;
    var icon = stateClass === 'present' ? 'fa-check' : stateClass === 'absent' ? 'fa-xmark' : 'fa-triangle-exclamation';
    var name = (data.swimmer && data.swimmer.name) || '—';
    var sub = (data.swimmer && data.swimmer.program_name) || (data.mode === 'absent' ? 'غياب' : 'حضور');
    if (stateClass === 'duplicate') sub += ' — مسجّل مسبقاً';
    item.innerHTML = '<div class="ic"><i class="fas ' + icon + '"></i></div>' +
      '<div class="tx"><b></b><small></small></div>' +
      '<div class="tm"></div>';
    item.querySelector('b').textContent = name;
    item.querySelector('small').textContent = sub;
    item.querySelector('.tm').textContent = data.time || '';
    recentList.insertBefore(item, recentList.firstChild);
    var count = recentList.querySelectorAll('.mc-scan-item').length;
    recentCount.textContent = String(count);
    while (recentList.querySelectorAll('.mc-scan-item').length > 20) {
      recentList.removeChild(recentList.lastElementChild);
    }
  }

  /* ---------------- قائمة الحضور التلقائي ---------------- */
  function setRowStatus(row, status) {
    var btns = row.querySelectorAll('.att-btn[data-status]');
    btns.forEach(function (b) {
      b.classList.remove('active-present', 'active-absent', 'active-excused', 'active-late');
      if (b.getAttribute('data-status') === status) b.classList.add('active-' + status);
    });
  }

  function refreshRosterCounts() {
    var totalPresent = 0;
    var totalAbsent = 0;
    document.querySelectorAll('.mc-roster-group').forEach(function (card) {
      var p = 0, a = 0;
      card.querySelectorAll('.att-btn[data-status]').forEach(function (b) {
        if (b.classList.contains('active-present')) p++;
        else if (b.classList.contains('active-absent')) a++;
      });
      totalPresent += p;
      totalAbsent += a;
      var gid = card.getAttribute('data-group-card');
      var pEl = card.querySelector('[data-group-present]');
      var aEl = card.querySelector('[data-group-absent]');
      if (pEl) pEl.textContent = p + ' حاضر';
      if (aEl) aEl.textContent = a + ' غائب';
      void gid;
    });
    if (statPresent) statPresent.textContent = String(totalPresent);
    if (statAbsent) statAbsent.textContent = String(totalAbsent);
  }

  function applyStatuses(sessionId, statuses) {
    if (!sessionId || !statuses) return;
    var cards = document.querySelectorAll('[data-session-card="' + sessionId + '"]');
    if (!cards.length) return;
    cards.forEach(function (card) {
      card.querySelectorAll('.att-row[data-swimmer-row]').forEach(function (row) {
        var btn = row.querySelector('.att-btn[data-swimmer]');
        if (!btn) return;
        var id = btn.getAttribute('data-swimmer');
        setRowStatus(row, statuses[id] || 'absent');
      });
    });
    refreshRosterCounts();
  }

  function highlightSwimmer(sessionId, swimmerId) {
    if (!sessionId || !swimmerId) return;
    var row = document.querySelector('[data-session-card="' + sessionId + '"] [data-swimmer-row="' + swimmerId + '"]');
    if (!row) return;
    /* إضاءة خفيفة فقط دون تمرير الصفحة حتى تبقى الكاميرا أمام المستخدم */
    row.classList.add('mc-row-hit');
    setTimeout(function () { row.classList.remove('mc-row-hit'); }, 1800);
  }

  var rosterSearch = document.getElementById('rosterSearch');
  if (rosterSearch) {
    rosterSearch.addEventListener('input', function () {
      var q = String(rosterSearch.value || '').trim().toLowerCase();
      document.querySelectorAll('.mc-roster-group').forEach(function (card) {
        var visible = 0;
        card.querySelectorAll('.att-row[data-swimmer-row]').forEach(function (row) {
          var show = !q || String(row.getAttribute('data-search') || '').indexOf(q) > -1;
          row.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        card.style.display = (q && !visible) ? 'none' : '';
      });
    });
  }

  document.addEventListener('click', function (ev) {
    var btn = ev.target && ev.target.closest ? ev.target.closest('.att-btn[data-status]') : null;
    if (!btn) return;
    /* التسجيل اليدوي: نغمة تأكيد فقط دون تمرير أو إزعاج */
    if (ev.isTrusted && btn.hasAttribute('data-session')) {
      var st = btn.getAttribute('data-status');
      playSound(st === 'present' || st === 'late' ? 'success' : 'duplicate');
    }
    setTimeout(refreshRosterCounts, 80);
  });

  refreshRosterCounts();

  /* ---------------- تسجيل المسح ---------------- */
  function handleCode(rawCode, fromManual) {
    var code = String(rawCode == null ? '' : rawCode).trim();
    if (!code) return;
    var now = Date.now();
    if (code === lastCode && (now - lastCodeAt) < 3000) return;
    if (submitting) return;
    lastCode = code;
    lastCodeAt = now;
    submitting = true;
    clearNoReadTimer();
    showResult('scanning', 'جارٍ التحقق...', code, '');

    var payload = { code: code, mode: mode };
    if (pageSessionId) payload.session_id = pageSessionId;
    fetch('/membership-cards/scan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).then(function (r) {
      return r.json().catch(function () { return { ok: false, status: 'error', message: 'تعذر قراءة استجابة الخادم' }; });
    }).then(function (data) {
      submitting = false;
      if (data.stats) {
        if (statPresent) statPresent.textContent = String(Number(data.stats.present) || 0);
        if (statAbsent) statAbsent.textContent = String(Number(data.stats.absent) || 0);
      }
      if (data.session_id && data.statuses) applyStatuses(data.session_id, data.statuses);
      if (data.ok) {
        playSound('success');
        showResult('success', data.swimmer.name, (data.swimmer.program_name || '') + ' • ' + (data.swimmer.membership_no || code),
          data.message || (mode === 'absent' ? 'تم تسجيل الغياب' : 'تم تسجيل الحضور'));
        prependRecent({ status: data.status, mode: mode, swimmer: data.swimmer, time: data.time }, true);
        highlightSwimmer(data.session_id, data.swimmer.id);
      } else if (data.status === 'duplicate') {
        playSound('duplicate');
        showResult('duplicate', (data.swimmer && data.swimmer.name) || 'مسجّل مسبقاً',
          (data.swimmer && data.swimmer.membership_no) || code, data.message || 'مسجّل مسبقاً');
        prependRecent({ status: 'duplicate', mode: mode, swimmer: data.swimmer, time: data.time }, false);
        highlightSwimmer(data.session_id, data.swimmer && data.swimmer.id);
      } else {
        playSound('error');
        showResult('error', 'لم يتم التسجيل', code, data.message || 'تعذر تسجيل العملية');
      }
      if (fromManual) manualCode.value = '';
      if (fromManual) manualCode.focus();
      if (window.App && window.App.showToast) {
        var toastType = data.ok ? 'success' : (data.status === 'duplicate' ? 'warning' : 'error');
        window.App.showToast((data.swimmer && data.swimmer.name ? data.swimmer.name + ' — ' : '') + (data.message || ''), toastType);
      }
    }).catch(function () {
      submitting = false;
      playSound('error');
      showResult('error', 'تعذر الاتصال', code, 'تحقق من الاتصال بالإنترنت وحاول مرة أخرى');
    });
  }

  /* ---------------- الكاميرا ---------------- */
  function setCamUI(on) {
    if (on) {
      overlay.hidden = false;
      camIdle.hidden = true;
      startBtn.disabled = true;
      stopBtn.disabled = false;
      if (captureBtn) captureBtn.disabled = false;
    } else {
      overlay.hidden = true;
      camIdle.hidden = false;
      startBtn.disabled = false;
      stopBtn.disabled = true;
      if (captureBtn) captureBtn.disabled = true;
      if (torchBtn) torchBtn.disabled = true;
    }
  }

  function updateTorchUI() {
    if (!torchBtn) return;
    torchBtn.classList.toggle('btn-primary', torchOn);
    torchBtn.classList.toggle('btn-outline', !torchOn);
    torchBtn.innerHTML = '<i class="fas fa-bolt"></i> ' + (torchOn ? 'مفعّل' : 'فلاش');
  }

  function findTorchTrack() {
    if (!activeStream) return null;
    var tracks = activeStream.getVideoTracks();
    for (var i = 0; i < tracks.length; i++) {
      var c = tracks[i].getCapabilities();
      if (c && c.torch) return tracks[i];
    }
    return null;
  }

  function toggleTorch() {
    var track = findTorchTrack();
    if (!track) {
      if (window.App && window.App.showToast) window.App.showToast('الفلاش غير مدعوم على هذا الجهاز', 'warning');
      return;
    }
    torchOn = !torchOn;
    track.applyConstraints({ advanced: [{ torch: torchOn }] }).then(function () {
      updateTorchUI();
    }).catch(function () {
      torchOn = !torchOn;
      updateTorchUI();
      if (window.App && window.App.showToast) window.App.showToast('تعذر تغيير حالة الفلاش', 'error');
    });
  }

  function getSnapReader() {
    if (snapReader) return snapReader;
    snapReader = new window.ZXing.BrowserMultiFormatReader(buildHints(true, true));
    return snapReader;
  }

  /* التقاط إطار من الفيديو وتحويله لصورة ثابتة ثم قراءته بقارئ مستقل
     (لا يتعارض مع الماسح المستمر) */
  function snapshotDecode() {
    return new Promise(function (resolve, reject) {
      if (!video || !video.srcObject || !video.videoWidth) return reject(new Error('no frame'));
      if (snapBusy) return reject(new Error('busy'));
      snapBusy = true;
      try {
        if (!snapCanvas) snapCanvas = document.createElement('canvas');
        var vw = video.videoWidth;
        var vh = video.videoHeight;
        /* توسيع منطقة اللقطة لتشمل معظم الإطار حتى لا يضيع الباركود الطرفي */
        var cw = Math.round(vw * 0.96);
        var chh = Math.round(vh * 0.86);
        var sx = Math.round((vw - cw) / 2);
        var sy = Math.round((vh - chh) / 2);
        var outW = Math.min(cw, 1280);
        var outH = Math.round(chh * (outW / cw));
        snapCanvas.width = outW;
        snapCanvas.height = outH;
        var ctx = snapCanvas.getContext('2d');
        ctx.imageSmoothingEnabled = false;
        ctx.drawImage(video, sx, sy, cw, chh, 0, 0, outW, outH);
        var dataUrl = snapCanvas.toDataURL('image/png');
        var img = new Image();
        img.onload = function () {
          getSnapReader().decodeFromImage(img, dataUrl).then(function (res) {
            snapBusy = false;
            resolve(res);
          }).catch(function (e) {
            snapBusy = false;
            reject(e);
          });
        };
        img.onerror = function () { snapBusy = false; reject(new Error('image load failed')); };
        img.src = dataUrl;
      } catch (e) {
        snapBusy = false;
        reject(e);
      }
    });
  }

  function captureAndDecode() {
    if (!scanning || !video.srcObject) return;
    showResult('scanning', 'جارٍ قراءة اللقطة...', 'حافظ على ثبات الكاميرا', '');
    var tries = 0;
    function tryOnce() {
      tries++;
      snapshotDecode().then(function (res) {
        if (res && res.getText) { clearAttempts(); handleCode(res.getText(), false); }
        else if (tries < 3) setTimeout(tryOnce, 200);
        else showResult('error', 'لم يقرأ اللقطة', 'جرب تقريب الكاميرا أو تشغيل الفلاش أو استخدم الإدخال اليدوي', 'يمكنك المحاولة مرة أخرى');
      }).catch(function () {
        if (tries < 3) { setTimeout(tryOnce, 200); bumpAttempt(); }
        else showResult('error', 'لم يقرأ اللقطة', 'جرب تقريب الكاميرا أو تشغيل الفلاش أو استخدم الإدخال اليدوي', 'يمكنك المحاولة مرة أخرى');
      });
    }
    tryOnce();
  }

  function stopCamera() {
    scanning = false;
    clearNoReadTimer();
    if (window._mcFallbackInterval) { clearInterval(window._mcFallbackInterval); window._mcFallbackInterval = null; }
    if (reader) {
      try { reader.reset(); } catch (e) { }
      reader = null;
    }
    if (snapReader) {
      try { snapReader.reset(); } catch (e) { }
      snapReader = null;
    }
    snapBusy = false;
    try {
      if (activeStream) {
        activeStream.getTracks().forEach(function (t) { t.stop(); });
      }
    } catch (e) { }
    activeStream = null;
    video.srcObject = null;
    torchTrack = null;
    torchOn = false;
    updateTorchUI();
    if (captureBtn) captureBtn.disabled = true;
    if (torchBtn) torchBtn.disabled = true;
    clearAttempts();
    setCamUI(false);
  }

  function pickCamera(devices) {
    var cams = devices.filter(function (d) { return d.kind === 'videoinput'; });
    if (!cams.length) return null;
    var back = cams.filter(function (d) {
      var label = String(d.label || '').toLowerCase();
      return /back|rear|environment|خلف/i.test(label);
    });
    return (back.length ? back : cams)[0].deviceId;
  }

  function buildConstraints(deviceId) {
    var base = {
      audio: false,
      video: {
        /* 720p كافية لقراءة الباركود وأسرع كثيراً في فك الترميز من 1080p */
        width: { ideal: 1280 },
        height: { ideal: 720 }
      }
    };
    if (deviceId) base.video.deviceId = { exact: deviceId };
    else base.video.facingMode = { ideal: 'environment' };
    return base;
  }

  function tryStartCamera(deviceId) {
    var constraints = buildConstraints(deviceId);
    showResult('scanning', 'جارٍ تشغيل الكاميرا...', deviceId ? 'جاري تجربة كاميرا بديلة' : 'اسمح بالوصول للكاميرا عند سؤال المتصفح', '');

    reader = new window.ZXing.BrowserMultiFormatReader(buildHints(false, false), 60);
    scanning = true;
    clearAttempts();

    var decodePromise = reader.decodeFromConstraints(constraints, video, function (res, err) {
      if (!res) {
        if (err && err.message) {
          var msg = String(err.message);
          if (msg.indexOf('No MultiFormat Readers') > -1 || msg.indexOf('No QR code') > -1 || msg.indexOf('No barcode') > -1) {
            bumpAttempt();
            return;
          }
          console.log('ZXing decode error:', msg);
        }
        return;
      }
      clearAttempts();
      handleCode(res.getText(), false);
    });

    function markCamReady() {
      if (!scanning) return;
      if (!video.srcObject) return;
      activeStream = video.srcObject;
      setCamUI(true);
      var track = findTorchTrack();
      if (torchBtn) torchBtn.disabled = !track;
      updateTorchUI();
      showResult('scanning', 'الكاميرا تعمل', 'وجّه الباركود داخل الإطار ببطء وحافظ على الإضاءة', 'يمكنك الضغط على «مسح لقطة» إذا لم يقرأ تلقائياً');
      if (window.App && window.App.showToast) window.App.showToast('الكاميرا جاهزة للمسح', 'success');
      scheduleNoReadHint();

      /* محاولة تفعيل التركيز التلقائي إن كان متاحاً */
      try {
        if (track && track.applyConstraints) {
          var caps = track.getCapabilities();
          if (caps && caps.focusMode) {
            track.applyConstraints({ advanced: [{ focusMode: 'continuous' }] }).catch(function () {});
          }
        }
      } catch (e) { }

      /* محاولة قراءة إطار ثابت كل 2.5 ثانية كخطة احتياطية للماسح المستمر */
      if (window._mcFallbackInterval) clearInterval(window._mcFallbackInterval);
      window._mcFallbackInterval = setInterval(function () {
        if (!scanning || submitting) return;
        snapshotDecode().then(function (res) {
          if (res && res.getText) { clearAttempts(); handleCode(res.getText(), false); }
        }).catch(function () { /* لا نزعج المستخدم بمحاولات فاشلة صامتة */ });
      }, 2500);
    }

    video.addEventListener('playing', markCamReady);
    var readyPoll = setInterval(function () {
      if (!scanning) { clearInterval(readyPoll); return; }
      if (video.srcObject && video.readyState >= 2) { markCamReady(); clearInterval(readyPoll); }
    }, 350);

    function onFail(e) {
      clearInterval(readyPoll);
      clearNoReadTimer();
      if (window._mcFallbackInterval) { clearInterval(window._mcFallbackInterval); window._mcFallbackInterval = null; }
      scanning = false;
      if (reader) { try { reader.reset(); } catch (x) { } reader = null; }
      if (snapReader) { try { snapReader.reset(); } catch (x) { } snapReader = null; }
      snapBusy = false;
      video.removeEventListener('playing', markCamReady);
      activeStream = null;
      return e;
    }

    function showCamError(e, fallbackPossible) {
      onFail(e);
      setCamUI(false);
      var errName = (e && e.name) || '';
      var reason = 'تعذر تشغيل الكاميرا، تأكد من منح الإذن للمتصفح';
      if (errName === 'NotAllowedError' || errName === 'SecurityError') reason = 'تم رفض إذن الكاميرا — اسمح بالوصول للكاميرا من إعدادات المتصفح';
      else if (errName === 'NotFoundError' || errName === 'DevicesNotFoundError') reason = 'لا توجد كاميرا متاحة على هذا الجهاز';
      else if (errName === 'NotReadableError' || errName === 'TrackStartError') reason = 'الكاميرا مستخدمة من تطبيق آخر — أغلق التطبيقات الأخرى';
      else if (errName === 'OverconstrainedError') reason = 'إعدادات الكاميرا غير مدعومة';
      if (fallbackPossible) {
        showResult('error', 'تعذر تشغيل الكاميرا الحالية', reason, 'جاري تجربة كاميرا أخرى...');
      } else {
        showResult('error', 'تعذر تشغيل الكاميرا', reason, 'يمكنك استخدام الإدخال اليدوي أو قارئ الباركود USB');
        if (window.App && window.App.showToast) window.App.showToast(reason, 'error');
      }
    }

    if (decodePromise && decodePromise.then) {
      decodePromise.then(function () { markCamReady(); }).catch(function (e) {
        var errName = (e && e.name) || '';
        if (!deviceId && errName !== 'NotAllowedError' && errName !== 'SecurityError' && navigator.mediaDevices && navigator.mediaDevices.enumerateDevices) {
          showCamError(e, true);
          navigator.mediaDevices.enumerateDevices().then(function (devices) {
            var id = pickCamera(devices);
            if (id) tryStartCamera(id);
            else { setCamUI(false); showResult('error', 'لا توجد كاميرا أخرى', 'لم يتم العثور على كاميرا بديلة', 'استخدم الإدخال اليدوي'); }
          }).catch(function () {
            showCamError(e, false);
          });
        } else {
          showCamError(e, false);
        }
      });
    }
  }

  function startCamera() {
    if (!canScan) {
      if (window.App && window.App.showToast) window.App.showToast('غير مصرح لك بتسجيل الحضور', 'error');
      return;
    }
    if (scanning) return;
    if (!window.ZXing || !window.ZXing.BrowserMultiFormatReader) {
      showResult('error', 'مكتبة المسح غير متاحة', '', 'أعد تحميل الصفحة ثم حاول مرة أخرى');
      return;
    }
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      showResult('error', 'الكاميرا غير مدعومة', '', 'المتصفح لا يدعم الوصول للكاميرا — استخدم الإدخال اليدوي');
      return;
    }
    ensureAudio();
    startBtn.disabled = true;
    tryStartCamera(null);
  }

  /* ---------------- الأحداث ---------------- */
  startBtn.addEventListener('click', startCamera);
  stopBtn.addEventListener('click', function () { stopCamera(); showResult('idle', 'تم إيقاف الكاميرا', 'شغّلها مرة أخرى أو استخدم الإدخال اليدوي', ''); });
  if (captureBtn) captureBtn.addEventListener('click', captureAndDecode);
  if (torchBtn) torchBtn.addEventListener('click', toggleTorch);

  modeGroup.addEventListener('click', function (e) {
    var btn = e.target.closest('button[data-mode]');
    if (!btn) return;
    mode = btn.getAttribute('data-mode') === 'absent' ? 'absent' : 'present';
    Array.prototype.forEach.call(modeGroup.querySelectorAll('button'), function (b) {
      b.classList.toggle('active', b === btn);
    });
    if (window.App && window.App.showToast) {
      window.App.showToast(mode === 'absent' ? 'الوضع: تسجيل الغياب' : 'الوضع: تسجيل الحضور', 'info');
    }
  });

  volumeInput.addEventListener('input', function () {
    volume = Math.min(1, Math.max(0, (parseFloat(volumeInput.value) || 0) / 100));
    volLabel.textContent = Math.round(volume * 100) + '%';
    try { localStorage.setItem('mcScanVolume', String(volume)); } catch (e) { }
  });
  volumeInput.addEventListener('change', function () { playSound('success'); });
  testSoundBtn.addEventListener('click', function () { playSound('success'); });

  manualForm.addEventListener('submit', function (e) {
    e.preventDefault();
    var v = manualCode.value.trim();
    if (!v) { manualCode.focus(); return; }
    handleCode(v, true);
  });

  document.addEventListener('visibilitychange', function () {
    if (document.hidden && scanning) stopCamera();
  });
  window.addEventListener('pagehide', function () { if (scanning) stopCamera(); });

  /* فتح الكاميرا تلقائياً عند دخول الصفحة بدلاً من التركيز على الإدخال اليدوي */
  ['pointerdown', 'keydown', 'touchstart'].forEach(function (name) {
    document.addEventListener(name, function () { ensureAudio(); }, { once: true, passive: true });
  });

  if (canScan) {
    ensureAudio();
    setTimeout(startCamera, 200);
  } else {
    startBtn.disabled = true;
    stopBtn.disabled = true;
    showResult('error', 'غير مصرح', '', 'ليست لديك صلاحية تسجيل الحضور بمسح البطاقات');
  }
})();
</script>

