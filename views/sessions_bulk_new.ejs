<%- include('partials/layout_top', { title: title, active: 'attendance' }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-calendar-plus"></i> إضافة حصص للمجموعات</div>
    <div class="page-sub">اختر مجموعة واحدة أو أكثر لإنشاء حصة لكل منها، ثم سجّل الحضور والغياب</div>
  </div>
  <a href="/attendance?date=<%= date %>" class="btn btn-outline"><i class="fas fa-arrow-right"></i> الحضور اليومي</a>
</div>

<%- include('partials/schedule_tabs', { activeTab: 'attendance' }) %>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3><i class="fas fa-calendar-days"></i> بيانات الحصص</h3></div>
    <div class="card-body">
      <form method="POST" action="/sessions/bulk-new" novalidate>
        <div class="form-grid">
          <div class="form-group">
            <label>تاريخ الحصة <span class="req">*</span></label>
            <input type="date" name="date" class="form-control" value="<%= date %>" required>
          </div>
          <div class="form-group">
            <label>وقت البداية <span class="req">*</span></label>
            <input type="time" name="start_time" class="form-control" value="<%= start_time %>" required>
          </div>
          <div class="form-group">
            <label>وقت النهاية</label>
            <input type="time" name="end_time" class="form-control" value="<%= end_time %>">
          </div>
          <div class="form-group">
            <label>الكابتن <span class="text-soft font-11">(اختياري، يُأخذ من المجموعة إن لم تختر)</span></label>
            <select name="coach_id" class="form-control">
              <option value="">— تلقائي من المجموعة —</option>
              <% coaches.forEach(function(c){ %><option value="<%= c.id %>"><%= c.full_name %></option><% }); %>
            </select>
          </div>
          <div class="form-group">
            <label>حمام السباحة <span class="text-soft font-11">(اختياري، يُأخذ من المجموعة إن لم تختر)</span></label>
            <select name="pool_id" class="form-control">
              <option value="">— تلقائي من المجموعة —</option>
              <% pools.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %></option><% }); %>
            </select>
          </div>
        </div>

        <div class="form-group full" style="margin-top:16px">
          <label>المجموعات <span class="req">*</span></label>
          <% if (groups.length) { %>
            <div class="multi-dropdown" data-multi-dropdown="bulk_groups">
              <button type="button" class="form-control" data-toggle style="display:flex;align-items:center;justify-content:space-between;gap:8px">
                <span data-label>— اختر من القائمة —</span>
                <i class="fas fa-chevron-down font-12"></i>
              </button>
              <div class="multi-dropdown-menu" data-menu style="display:none">
                <label class="check-chip w-full" style="margin-bottom:8px;border-bottom:1px solid var(--card-border);border-radius:0;padding-bottom:8px">
                  <input type="checkbox" data-select-all>
                  <div class="chip-box"><i class="fas fa-check-double"></i></div>
                  <span class="chip-label"><b>اختيار الكل</b></span>
                </label>
                <div class="flex flex-wrap gap-1">
                  <% groups.forEach(function(g){ %>
                    <label class="check-chip">
                      <input type="checkbox" name="group_ids[]" value="<%= g.id %>">
                      <div class="chip-box"><i class="fas fa-check"></i></div>
                      <span class="chip-label"><%= g.name %></span>
                    </label>
                  <% }); %>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="empty-state"><i class="fas fa-people-group"></i><p>لا توجد مجموعات متاحة</p></div>
          <% } %>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-lg" id="bulkSubmit"><i class="fas fa-plus"></i> إنشاء الحصة</button>
          <a href="/attendance?date=<%= date %>" class="btn btn-outline btn-lg"><i class="fas fa-xmark"></i> إلغاء</a>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3><i class="fas fa-circle-info"></i> ملاحظات</h3></div>
    <div class="card-body">
      <ul class="font-14" style="line-height:2">
        <li>إذا لم تختر كابتن أو حمام سيُستخدم الإعداد الافتراضي لكل مجموعة.</li>
        <li>إذا تركت وقت النهاية فارغًا سيتم إنشاء الحصة بنفس وقت البداية.</li>
        <li>بعد الإنشاء ستنتقل إلى شاشة الحضور والغياب لتسجيل الحضور لكل مجموعة.</li>
        <li>يمكنك اختيار مجموعة واحدة أو جميع المجموعات دفعة واحدة.</li>
      </ul>
    </div>
  </div>
</div>

<script>
(function () {
  var wrap = document.querySelector('[data-multi-dropdown="bulk_groups"]');
  var submit = document.getElementById('bulkSubmit');
  if (!wrap || !submit) return;
  function update() {
    var n = wrap.querySelectorAll('input[name="group_ids[]"]:checked').length;
    submit.disabled = n === 0;
  }
  wrap.querySelectorAll('input[type="checkbox"]').forEach(function (c) { c.addEventListener('change', update); });
  update();
})();
</script>
<%- include('partials/layout_bottom') %>
