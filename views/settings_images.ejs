<%- include('partials/layout_top', { title: 'صور الواجهة الرئيسية', active: 'settings' }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-image"></i> صور الواجهة الرئيسية</div>
    <div class="page-sub">صور تظهر في الصفحة الرئيسية للموقع التعريفي</div>
  </div>
</div>

<% if (canEdit) { %>
  <div class="card" style="max-width:820px">
    <div class="card-body">
      <div class="form-section-title"><i class="fas fa-upload"></i> إضافة صورة</div>
      <form method="POST" action="/settings/images" enctype="multipart/form-data" class="chip-add">
        <input type="file" name="image" class="form-control" accept="image/*" required>
        <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> رفع الصورة</button>
      </form>
      <div class="hint mt-2">الحد الأقصى 10MB، صيغ JPG / PNG / WebP</div>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-body">
    <div class="form-section-title"><i class="fas fa-images"></i> الصور الحالية</div>
    <% if (images.length) { %>
      <div class="img-grid">
        <% images.forEach(function (img, i) { %>
          <div class="img-tile">
            <img src="/uploads/<%= img %>" alt="صورة">
            <% if (canEdit) { %>
              <form method="POST" action="/settings/images/<%= i %>/delete" data-confirm="حذف هذه الصورة؟">
                <button type="submit" class="img-del" title="حذف">حذف</button>
              </form>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state"><i class="fas fa-images"></i><p>لا توجد صور بعد — أضف صوراً للواجهة الرئيسية</p></div>
    <% } %>
  </div>
</div>
<%- include('partials/layout_bottom') %>
