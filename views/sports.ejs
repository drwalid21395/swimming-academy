<%- include('partials/layout_top', { title: 'الألعاب الرياضية', active: 'sports' }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-medal"></i> الألعاب الرياضية</div>
    <div class="page-sub">كل لعبة لها صفحة موقع مستقلة داخل أكاديميتك: نبذة، صور، برامج، كباتن، وإعلانات خاصة بها</div>
  </div>
</div>

<div class="alert alert-info" style="max-width:900px">
  <i class="fas fa-circle-info"></i> تفعيل اللعبة أو إيقافها يتم من شاشة التحكم المركزية في المنصة <a href="/platform/sports">الألعاب الرياضية</a> (Super Admin). هنا تُعدّل محتوى موقع كل لعبة المفعلة لأكاديميتك.
</div>

<div class="dash-grid">
  <% sports.forEach(function (s) { %>
    <div class="card">
      <div class="card-body">
        <div class="flex items-center" style="gap:12px;margin-bottom:10px">
          <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,var(--primary),var(--primary-light));color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0">
            <i class="fas <%= s.icon %>"></i>
          </div>
          <div style="flex:1">
            <div style="font-weight:800;font-size:16px"><%= s.name %></div>
            <div class="text-muted" style="font-size:12px">ترتيب: <%= s.sort_order %></div>
          </div>
        </div>
        <div style="font-size:13px;color:var(--text-soft);margin-bottom:12px"><%= s.description || '—' %></div>
        <div style="margin-bottom:12px">
          <% if (s.is_enabled) { %>
            <span class="badge badge-success"><i class="fas fa-check-circle"></i> مفعّلة لأكاديميتك</span>
          <% } else { %>
            <span class="badge badge-gray"><i class="fas fa-circle"></i> غير مفعّلة</span>
          <% } %>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <a href="/site/sport/<%= s.id %>" class="btn btn-sm btn-outline" target="_blank"><i class="fas fa-eye"></i> عرض صفحة اللعبة</a>
          <% if (s.is_enabled) { %>
            <a href="/sports/<%= s.id %>/website" class="btn btn-sm btn-primary"><i class="fas fa-pen-to-square"></i> محتوى موقع اللعبة</a>
          <% } %>
        </div>
      </div>
    </div>
  <% }); %>
  <% if (!sports.length) { %>
    <div class="card"><div class="card-body"><div class="empty-state"><i class="fas fa-medal"></i><p>لا توجد ألعاب مفعّلة — أضف ألعاباً من منصة التحكم المركزية</p></div></div></div>
  <% } %>
</div>
<%- include('partials/layout_bottom') %>