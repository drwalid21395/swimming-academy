<%- include('partials/layout_top', { title: 'إعدادات النظام', active: 'settings' }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-gears"></i> إعدادات النظام</div>
    <div class="page-sub">بيانات الأكاديمية وتفاصيل الموقع التعريفي</div>
  </div>
</div>

<% if (academy) { %>
<% const st = subInfo || {}; %>
<div class="card" style="max-width:820px">
  <div class="card-body">
    <div class="section-title-lg"><i class="fas fa-file-contract"></i> نظام الاشتراك الخاص بك</div>
    <div class="detail-grid">
      <div class="detail-item"><div class="dl">الأكاديمية</div><div class="dv"><%= academy.name %></div></div>
      <div class="detail-item"><div class="dl">الخطة</div><div class="dv"><%= plan ? plan.name : '—' %></div></div>
      <div class="detail-item">
        <div class="dl">الحالة</div>
        <div class="dv">
          <span class="badge <%= st.status === 'ACTIVE' ? 'badge-success' : st.status === 'EXPIRING_SOON' ? 'badge-warning' : 'badge-danger' %>"><%= st.label || '—' %></span>
        </div>
      </div>
      <div class="detail-item"><div class="dl">بداية الاشتراك</div><div class="dv"><%= subscription ? fmtDate(subscription.start_date) : '—' %></div></div>
      <div class="detail-item"><div class="dl">نهاية الاشتراك</div><div class="dv"><%= subscription ? fmtDate(subscription.expiry_date) : '—' %></div></div>
      <div class="detail-item"><div class="dl">الأيام المتبقية</div><div class="dv"><%= st.daysLeft != null ? st.daysLeft + ' يوم' : '—' %></div></div>
      <div class="detail-item"><div class="dl">المبلغ المدفوع</div><div class="dv"><%= money(paidAmount) %></div></div>
      <div class="detail-item"><div class="dl">المبلغ المتبقي للدفع</div><div class="dv"><%= money(dueAmount) %></div></div>
    </div>
    <% if (st.status === 'EXPIRING_SOON') { %>
      <div class="alert alert-warning" style="margin-top:12px"><i class="fas fa-clock"></i> اشتراكك يقترب من الانتهاء (أقل من 7 أيام). يرجى تجديد اشتراكك لتجنب إيقاف الخدمة.</div>
    <% } else if (st.status === 'PENDING_PAYMENT' || st.status === 'EXPIRED') { %>
      <div class="alert alert-danger" style="margin-top:12px"><i class="fas fa-triangle-exclamation"></i> اشتراكك <%= st.status === 'EXPIRED' ? 'منتهي' : 'بانتظار الدفع' %>. الخدمة مقيدة حتى تجديد الاشتراك.</div>
    <% } %>
  </div>
</div>

<% if (canUploadLogo) { %>
<div class="card" style="max-width:820px">
  <div class="card-body">
    <div class="section-title-lg"><i class="fas fa-image"></i> صورة وشعار الأكاديمية</div>
    <% if (academy.logo && academy.logo.startsWith('/uploads/')) { %>
      <div style="margin-bottom:12px"><img src="<%= academy.logo %>" alt="logo" class="logo-preview" style="max-width:120px;max-height:120px;border-radius:12px;border:1px solid #ddd"> <a href="<%= academy.logo %>?dl=1" class="btn btn-sm btn-outline">تحميل الصورة</a></div>
    <% } %>
    <form method="POST" action="/settings/logo" enctype="multipart/form-data" class="inline-form">
      <input type="file" name="logo" accept="image/*" class="form-control" style="display:inline-block;width:auto" required>
      <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> رفع الشعار</button>
    </form>
  </div>
</div>
<% } %>

<% if (canCustomizeBranding) { %>
<div class="card" style="max-width:820px">
  <div class="card-body">
    <div class="section-title-lg"><i class="fas fa-palette"></i> اللون الرئيسي لهوية الأكاديمية</div>
    <p style="color:var(--text-soft);margin:0 0 14px;font-size:13px">اختر اللون الذي يميّز أكاديميتك وسيُطبَّق على الواجهة الداخلية ولوحة التحكم والموقع.</p>
    <form method="POST" action="/settings/color" class="inline-form">
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
        <input type="color" name="primary_color" value="<%= (function(){try{var s=JSON.parse(academy.settings||'{}');return /^#[0-9a-fA-F]{6}$/.test(s.primary_color)?s.primary_color:'#0284c7';}catch(e){return '#0284c7';}})() %>" style="width:64px;height:44px;padding:4px;border:1px solid var(--card-border);border-radius:10px;background:var(--card)">
        <button type="submit" class="btn btn-primary"><i class="fas fa-palette"></i> حفظ اللون</button>
      </div>
    </form>
  </div>
</div>
<% } %>
<% } %>

<div class="card" style="max-width:820px">
  <div class="card-body">
    <% if (!canEdit) { %>
      <div class="detail-grid">
        <% defs.forEach(function (d) { %>
          <div class="detail-item"><div class="dl"><%= d.label %></div><div class="dv"><%= current[d.key] || '—' %></div></div>
        <% }); %>
      </div>
    <% } else { %>
      <form method="POST" action="/settings" novalidate>
        <div class="form-grid">
          <% let lastSec = ''; %>
          <% defs.forEach(function (d, i) { %>
            <% const sec = d.section || ''; %>
            <% if (sec && sec !== lastSec) { %><div class="full form-section-title"><i class="fas fa-circle-info"></i> <%= sec %></div><% lastSec = sec; } %>
            <div class="form-group <%= d.type === 'textarea' ? 'full' : '' %>">
              <label><%= d.label %></label>
              <% if (d.type === 'textarea') { %>
                <textarea class="form-control" name="<%= d.key %>" rows="4"><%= current[d.key] || '' %></textarea>
              <% } else { %>
                <input type="<%= d.type || 'text' %>" class="form-control" name="<%= d.key %>" value="<%= current[d.key] || '' %>">
              <% } %>
            </div>
          <% }); %>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-floppy-disk"></i> حفظ الإعدادات</button>
        </div>
      </form>
    <% } %>
  </div>
</div>
<%- include('partials/layout_bottom') %>
