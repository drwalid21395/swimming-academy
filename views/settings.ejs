<%- include('partials/layout_top', { title: 'إعدادات النظام', active: 'settings' }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-gears"></i> إعدادات النظام</div>
    <div class="page-sub">بيانات الأكاديمية وتفاصيل الموقع التعريفي</div>
  </div>
</div>

<% if (academy) { %>
<% const st = subInfo || {}; %>
<div class="card" style="max-width:820px">
  <div class="card-body">
    <div class="section-title-lg"><i class="fas fa-file-contract"></i> نظام الاشتراك الخاص بك</div>
    <div class="detail-grid">
      <div class="detail-item"><div class="dl">الأكاديمية</div><div class="dv"><%= academy.name %></div></div>
      <div class="detail-item"><div class="dl">الخطة</div><div class="dv"><%= plan ? plan.name : '—' %></div></div>
      <div class="detail-item">
        <div class="dl">الحالة</div>
        <div class="dv">
          <span class="badge <%= st.status === 'ACTIVE' ? 'badge-success' : st.status === 'EXPIRING_SOON' ? 'badge-warning' : 'badge-danger' %>"><%= st.label || '—' %></span>
        </div>
      </div>
      <div class="detail-item"><div class="dl">بداية الاشتراك</div><div class="dv"><%= subscription ? fmtDate(subscription.start_date) : '—' %></div></div>
      <div class="detail-item"><div class="dl">نهاية الاشتراك</div><div class="dv"><%= subscription ? fmtDate(subscription.expiry_date) : '—' %></div></div>
      <div class="detail-item"><div class="dl">الأيام المتبقية</div><div class="dv"><%= st.daysLeft != null ? st.daysLeft + ' يوم' : '—' %></div></div>
      <div class="detail-item"><div class="dl">المبلغ المدفوع</div><div class="dv"><%= money(paidAmount) %></div></div>
      <div class="detail-item"><div class="dl">المبلغ المتبقي للدفع</div><div class="dv"><%= money(dueAmount) %></div></div>
    </div>
    <% if (st.status === 'EXPIRING_SOON') { %>
      <div class="alert alert-warning" style="margin-top:12px"><i class="fas fa-clock"></i> اشتراكك يقترب من الانتهاء (أقل من 7 أيام). يرجى تجديد اشتراكك لتجنب إيقاف الخدمة.</div>
    <% } else if (st.status === 'PENDING_PAYMENT' || st.status === 'EXPIRED') { %>
      <div class="alert alert-danger" style="margin-top:12px"><i class="fas fa-triangle-exclamation"></i> اشتراكك <%= st.status === 'EXPIRED' ? 'منتهي' : 'بانتظار الدفع' %>. الخدمة مقيدة حتى تجديد الاشتراك.</div>
    <% } %>
  </div>
</div>

<% if (canUploadLogo) { %>
<div class="card" style="max-width:820px">
  <div class="card-body">
    <div class="section-title-lg"><i class="fas fa-image"></i> صورة وشعار الأكاديمية</div>
    <% if (academy.logo && academy.logo.startsWith('/uploads/')) { %>
      <div style="margin-bottom:12px"><img src="<%= academy.logo %>" alt="logo" class="logo-preview" style="max-width:120px;max-height:120px;border-radius:12px;border:1px solid #ddd"> <a href="<%= academy.logo %>?dl=1" class="btn btn-sm btn-outline">تحميل الصورة</a></div>
    <% } %>
    <form method="POST" action="/settings/logo" enctype="multipart/form-data" class="inline-form">
      <input type="file" name="logo" accept="image/*" class="form-control" style="display:inline-block;width:auto" required>
      <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> رفع الشعار</button>
    </form>
  </div>
</div>
<% } %>

<% if (canCustomizeBranding) { %>
<div class="card" style="max-width:820px">
  <div class="card-body">
    <div class="section-title-lg"><i class="fas fa-palette"></i> اللون الرئيسي لهوية الأكاديمية</div>
    <p style="color:var(--text-soft);margin:0 0 14px;font-size:13px">اختر اللون الذي يميّز أكاديميتك وسيُطبَّق على الواجهة الداخلية ولوحة التحكم والموقع.</p>
    <form method="POST" action="/settings/color" class="inline-form">
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
        <input type="color" name="primary_color" value="<%= (function(){try{var s=JSON.parse(academy.settings||'{}');return /^#[0-9a-fA-F]{6}$/.test(s.primary_color)?s.primary_color:'#0284c7';}catch(e){return '#0284c7';}})() %>" style="width:64px;height:44px;padding:4px;border:1px solid var(--card-border);border-radius:10px;background:var(--card)">
        <button type="submit" class="btn btn-primary"><i class="fas fa-palette"></i> حفظ اللون</button>
      </div>
    </form>
  </div>
</div>
<% } %>
<% } %>

<div class="card" style="max-width:820px;margin-bottom:18px">
  <div class="card-body">
    <div class="section-title-lg"><i class="fas fa-bell"></i> إشعارات النشاط وصوتها</div>
    <p style="color:var(--text-soft);margin:4px 0 14px;font-size:13px">
      يتم تنبيه مستخدمي الأكاديمية بصوت عند أي إشعار أو تعديل داخل الموقع.
      <b>مَن يسمع الصوت يُحدَّد من خلال صلاحية «استقبال صوت إشعارات النشاط»</b>
      في صفحة المستخدم أو الدور.
      <br><i class="fas fa-mobile-screen"></i> لتلقي الإشعارات على الهاتف وشاشة القفل:
      ثبّت التطبيق من المتصفح (<b>إضافة إلى الشاشة الرئيسية</b>)، ثم اضغط
      <b>تفعيل إشعارات الجهاز</b> من الهاتف واسمح بالإذن.
    </p>
    <% if (!canEdit) { %>
      <div class="detail-grid">
        <div class="detail-item"><div class="dl">تشغيل الصوت</div><div class="dv"><%= current.notif_sound_enabled === '0' ? 'معطّل' : 'مفعّل' %></div></div>
        <div class="detail-item"><div class="dl">مستوى الصوت</div><div class="dv"><%= current.notif_sound_volume || 70 %>%</div></div>
        <div class="detail-item"><div class="dl">نوع الصوت</div><div class="dv"><%= {chime:'رنين هادئ', bell:'جرس', ping:'بينغ', beep:'صفارة', alarm:'إنذار'}[current.notif_sound_type || 'chime'] %></div></div>
        <div class="detail-item"><div class="dl">مدة التحديث</div><div class="dv"><%= current.notif_poll_seconds || 20 %> ثانية</div></div>
      </div>
    <% } else { %>
      <form method="POST" action="/settings/notifications" id="notifSettingsForm" novalidate>
        <div class="form-grid">
          <div class="form-group">
            <label>تشغيل الصوت</label>
            <select class="form-control" name="notif_sound_enabled">
              <option value="1" <%= current.notif_sound_enabled !== '0' ? 'selected' : '' %>>مفعّل</option>
              <option value="0" <%= current.notif_sound_enabled === '0' ? 'selected' : '' %>>معطّل</option>
            </select>
          </div>
          <div class="form-group">
            <label for="volRange">مستوى الصوت (<span id="volVal"><%= current.notif_sound_volume || 70 %></span>%)</label>
            <input type="range" id="volRange" name="notif_sound_volume" min="0" max="100" value="<%= current.notif_sound_volume || 70 %>" class="form-control">
          </div>
          <div class="form-group">
            <label>نوع الصوت</label>
            <select class="form-control" name="notif_sound_type" id="soundTypeSelect">
              <option value="chime" <%= (current.notif_sound_type || 'chime') === 'chime' ? 'selected' : '' %>>رنين هادئ</option>
              <option value="bell" <%= (current.notif_sound_type || '') === 'bell' ? 'selected' : '' %>>جرس</option>
              <option value="ping" <%= (current.notif_sound_type || '') === 'ping' ? 'selected' : '' %>>بينغ</option>
              <option value="beep" <%= (current.notif_sound_type || '') === 'beep' ? 'selected' : '' %>>صفارة</option>
              <option value="alarm" <%= (current.notif_sound_type || '') === 'alarm' ? 'selected' : '' %>>إنذار</option>
            </select>
          </div>
          <div class="form-group">
            <label>مدة التحديث (ثوانٍ)</label>
            <input type="number" class="form-control" name="notif_poll_seconds" min="5" max="120" value="<%= current.notif_poll_seconds || 20 %>">
          </div>
        </div>
        <div class="form-actions" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk"></i> حفظ إعدادات الصوت</button>
          <button type="button" class="btn btn-outline" id="notifTestSound"><i class="fas fa-volume-high"></i> اختبار الصوت</button>
          <button type="button" class="btn btn-outline" id="notifDevicePerm"><i class="fas fa-mobile-screen"></i> تفعيل إشعارات الجهاز</button>
        </div>
      </form>
    <% } %>
  </div>
</div>

<div class="card" style="max-width:820px">
  <div class="card-body">
    <% if (!canEdit) { %>
      <div class="detail-grid">
        <% defs.forEach(function (d) { %>
          <div class="detail-item"><div class="dl"><%= d.label %></div><div class="dv"><%= current[d.key] || '—' %></div></div>
        <% }); %>
      </div>
    <% } else { %>
      <form method="POST" action="/settings" novalidate>
        <div class="form-grid">
          <% let lastSec = ''; %>
          <% defs.forEach(function (d, i) { %>
            <% const sec = d.section || ''; %>
            <% if (sec && sec !== lastSec) { %><div class="full form-section-title"><i class="fas fa-circle-info"></i> <%= sec %></div><% lastSec = sec; } %>
            <div class="form-group <%= d.type === 'textarea' ? 'full' : '' %>">
              <label><%= d.label %></label>
              <% if (d.type === 'textarea') { %>
                <textarea class="form-control" name="<%= d.key %>" rows="<%= d.key === 'receipt_message_template' ? 14 : 4 %>"><%= current[d.key] || '' %></textarea>
                <% if (d.key === 'receipt_message_template') { %>
                  <div class="form-hint" style="line-height:2">
                    المتغيّرات المتاحة: <code>{academy}</code> اسم الأكاديمية، <code>{player}</code> اللاعب، <code>{guardian_line}</code> ولي الأمر، <code>{membership_line}</code>، <code>{program_line}</code>، <code>{group_line}</code>، <code>{period_line}</code>، <code>{sessions_line}</code>، <code>{type_block}</code>، <code>{price_line}</code>، <code>{discount_line}</code>، <code>{tax_line}</code>، <code>{total_line}</code>، <code>{paid_line}</code>، <code>{remaining_line}</code>، <code>{method_line}</code>، <code>{receipt_line}</code>، <code>{group_text}</code>، <code>{group_link}</code>، <code>{footer}</code>، <code>{separator}</code>.
                    الأسطر الفارغة تُحذف تلقائياً، ويمكنك تغيير النص والرابط بحرية. اتركه فارغاً لاستخدام القالب الافتراضي.
                  </div>
                <% } %>
              <% } else { %>
                <input type="<%= d.type || 'text' %>" class="form-control" name="<%= d.key %>" value="<%= current[d.key] || '' %>">
              <% } %>
            </div>
          <% }); %>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-floppy-disk"></i> حفظ الإعدادات</button>
        </div>
      </form>
    <% } %>
  </div>
</div>
<script>
window.addEventListener('load', function () {
  (function () {
    var volRange = document.getElementById('volRange');
    var volVal = document.getElementById('volVal');
    var testBtn = document.getElementById('notifTestSound');
    var devBtn = document.getElementById('notifDevicePerm');
    var soundType = document.getElementById('soundTypeSelect');
    if (volRange && volVal) {
      volRange.addEventListener('input', function () { volVal.textContent = volRange.value; });
    }
    function toast(msg, type) {
      if (window.App && App.showToast) App.showToast(msg, type);
      else window.alert(msg);
    }
    if (testBtn) {
      if (typeof window.SWNotif === 'undefined') {
        testBtn.disabled = true;
        testBtn.title = 'سكربت الصوت لم يُحمّل بعد';
      } else {
        testBtn.addEventListener('click', function () {
          window.SWNotif.unlock();
          window.SWNotif.test(soundType ? soundType.value : 'chime', volRange ? volRange.value : 70);
          toast('تجربة الصوت', 'info');
        });
      }
    }
    if (devBtn) {
      if (typeof window.SWNotif === 'undefined') {
        devBtn.disabled = true;
        devBtn.title = 'سكربت الإشعارات لم يُحمّل بعد';
      } else {
        devBtn.addEventListener('click', function () {
          devBtn.disabled = true;
          var oldText = devBtn.innerHTML;
          devBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارِ التفعيل...';
          window.SWNotif.requestPermission(function (p) {
            devBtn.disabled = false;
            devBtn.innerHTML = oldText;
            if (p === 'granted') toast('تم تفعيل إشعارات الجهاز بنجاح', 'success');
            else if (p === 'denied') toast('تم رفض إذن الإشعارات من المتصفح', 'warning');
            else if (p === 'unsupported') toast('المتصفح/الجهاز لا يدعم إشعارات Push (ثبّت التطبيق أولاً)', 'info');
            else toast('لم يتم التفعيل: ' + p, 'error');
          });
        });
      }
    }
  })();
});
</script>
<%- include('partials/layout_bottom') %>
