<%- include('partials/layout_top', { title: 'تفاصيل الحصة', active: 'sessions' }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-calendar-day"></i> تفاصيل الحصة</div>
    <div class="page-sub"><%= fmtDate(s.date) %> · <span dir="ltr"><%= s.start_time %> — <%= s.end_time || '' %></span></div>
  </div>
  <div class="spacer"></div>
  <div class="flex gap-1">
    <a href="/sessions" class="btn btn-outline"><i class="fas fa-arrow-right"></i> الحصص</a>
    <a href="/attendance/session/<%= s.id %>" class="btn btn-primary"><i class="fas fa-clipboard-user"></i> تسجيل الحضور</a>
    <a href="/attendance/scan?session=<%= s.id %>" class="btn btn-success"><i class="fas fa-qrcode"></i> مسح الباركود</a>
    <% if (page.canExport) { %>
      <a href="/sessions/<%= s.id %>/attendance.pdf" class="btn btn-outline"><i class="fas fa-file-pdf"></i> PDF الحصة</a>
      <a href="/sessions/<%= s.id %>/attendance.xls" class="btn btn-outline"><i class="fas fa-file-excel"></i> Excel الحصة</a>
    <% } %>
    <% if (page.canEdit) { %><a href="/sessions/<%= s.id %>/edit" class="btn btn-primary"><i class="fas fa-pen"></i> تعديل</a><% } %>
    <% if (s.status !== 'cancelled' && page.canEdit) { %><a href="/sessions/<%= s.id %>/cancel" class="btn btn-outline-danger"><i class="fas fa-ban"></i> إلغاء وتعويض</a><% } %>
  </div>
</div>

<div class="dash-grid">
  <div class="card">
    <div class="card-header"><h3><i class="fas fa-circle-info"></i> بيانات الحصة</h3></div>
    <div class="card-body">
      <div class="detail-grid">
        <div class="detail-item"><div class="dl">العنوان</div><div class="dv"><%= s.title || '—' %></div></div>
        <div class="detail-item"><div class="dl">التاريخ</div><div class="dv"><%= fmtDate(s.date) %></div></div>
        <div class="detail-item"><div class="dl">الوقت</div><div class="dv"><%= s.start_time %> — <%= s.end_time || '' %></div></div>
        <div class="detail-item"><div class="dl">المجموعة</div><div class="dv"><%= (groupNames && groupNames.length ? groupNames.join('، ') : s.group_name) || '—' %></div></div>
        <div class="detail-item"><div class="dl">الكابتن</div><div class="dv"><%= s.coach_name || '—' %></div></div>
        <div class="detail-item"><div class="dl">الحمام</div><div class="dv"><%= s.pool_name || '—' %></div></div>
        <div class="detail-item"><div class="dl">الحالة</div><div class="dv">
          <% if (s.status === 'scheduled') { %><span class="badge badge-primary">مجدولة</span><% } else if (s.status === 'completed') { %><span class="badge badge-success">منفذة</span><% } else if (s.status === 'cancelled') { %><span class="badge badge-danger">ملغاة</span><% } else { %><span class="badge badge-warning">مؤجلة</span><% } %>
        </div></div>
        <% if (s.is_compensatory) { %>
          <div class="detail-item"><div class="dl">حصة تعويضية</div><div class="dv">نعم <%= s.original_date ? 'عن ' + fmtDate(s.original_date) : '' %></div></div>
        <% } %>
        <div class="detail-item"><div class="dl">ملاحظات</div><div class="dv"><%= s.note || '—' %></div></div>
      </div>
    </div>
  </div>
  <div class="card att-card">
    <div class="card-header" style="flex-wrap:wrap;gap:8px">
      <h3><i class="fas fa-clipboard-user"></i> الحضور — المجموعات واللاعبون</h3>
      <div class="flex gap-1" style="flex-wrap:wrap">
        <% if (page.canSave) { %>
          <button class="btn btn-success btn-sm" data-mark-all="present" data-session="<%= s.id %>"><i class="fas fa-check"></i> الكل حاضر</button>
          <button class="btn btn-outline-danger btn-sm" data-mark-all="absent" data-session="<%= s.id %>"><i class="fas fa-xmark"></i> الكل غائب</button>
          <button class="btn btn-outline-warning btn-sm" data-mark-all="excused" data-session="<%= s.id %>"><i class="fas fa-book"></i> الكل معتذر</button>
        <% } %>
        <span class="badge badge-gray"><%= groups.length %> مجموعة · <%= members.length %> لاعب</span>
      </div>
    </div>
    <div class="card-body">
      <% groups.forEach(function (g) { %>
        <% var presentCount = g.members.filter(function (m) { return m.att_status === 'present'; }).length; %>
        <% var absentCount = g.members.filter(function (m) { return m.att_status === 'absent'; }).length; %>
        <% var lateCount = g.members.filter(function (m) { return m.att_status === 'late'; }).length; %>
        <% var excusedCount = g.members.filter(function (m) { return m.att_status === 'excused'; }).length; %>
        <details class="att-session-group">
          <summary>
            <span class="assess-avatar"><%= (g.name || 'م').trim().charAt(0) %></span>
            <span class="assess-name">
              <b><%= g.name %></b>
              <small><%= g.members.length %> لاعب · حاضر <%= presentCount %> · غائب <%= absentCount %> · متأخر <%= lateCount %> · معتذر <%= excusedCount %></small>
            </span>
            <i class="fas fa-chevron-down att-chev"></i>
          </summary>
          <div class="att-session-group-body">
            <div class="att-row" style="border-bottom-width:2px">
              <div class="att-name"><b>اللاعب</b></div>
              <div class="att-btns">
                <span class="att-btn att-head" title="حاضر" style="cursor:default"><i class="fas fa-check"></i> <span>حاضر</span></span>
                <span class="att-btn att-head" title="غائب" style="cursor:default"><i class="fas fa-xmark"></i> <span>غائب</span></span>
                <span class="att-btn att-head" title="معتذر" style="cursor:default"><i class="fas fa-book"></i> <span>معتذر</span></span>
                <span class="att-btn att-head" title="متأخر" style="cursor:default"><i class="fas fa-clock"></i> <span>متأخر</span></span>
              </div>
            </div>
            <% g.members.forEach(function (m) { %>
              <div class="att-row">
                <div class="att-name">
                  <div class="flex items-center gap-1">
                    <div class="avatar-sm"><%= (m.full_name || 'س').trim().charAt(0) %></div>
                    <div>
                      <b><%= m.full_name %></b>
                      <div class="font-11 text-muted" dir="ltr"><%= m.membership_no || '—' %></div>
                      <div style="margin-top:2px">
                        <% if (m.att_status === 'present') { %><span class="badge badge-success">حاضر</span><% } else if (m.att_status === 'absent') { %><span class="badge badge-danger">غائب</span><% } else if (m.att_status === 'excused') { %><span class="badge badge-warning">معتذر</span><% } else if (m.att_status === 'late') { %><span class="badge badge-info">متأخر</span><% } else { %><span class="badge badge-gray">—</span><% } %>
                        <% if (m.coach_note || m.reason) { %><span class="font-11 text-soft" style="margin-inline-start:6px"><%= m.coach_note || m.reason %></span><% } %>
                      </div>
                    </div>
                  </div>
                </div>
                <% if (page.canSave) { %>
                  <div class="att-btns">
                    <button class="att-btn <%= (m.att_status || 'absent') === 'present' ? 'active-present' : '' %>" data-status="present" data-swimmer="<%= m.id %>" data-session="<%= s.id %>" title="حاضر"><i class="fas fa-check"></i> <span>حاضر</span></button>
                    <button class="att-btn <%= (m.att_status || 'absent') === 'absent' ? 'active-absent' : '' %>" data-status="absent" data-swimmer="<%= m.id %>" data-session="<%= s.id %>" title="غائب"><i class="fas fa-xmark"></i> <span>غائب</span></button>
                    <button class="att-btn <%= (m.att_status || 'absent') === 'excused' ? 'active-excused' : '' %>" data-status="excused" data-swimmer="<%= m.id %>" data-session="<%= s.id %>" title="معتذر"><i class="fas fa-book"></i> <span>معتذر</span></button>
                    <button class="att-btn <%= (m.att_status || 'absent') === 'late' ? 'active-late' : '' %>" data-status="late" data-swimmer="<%= m.id %>" data-session="<%= s.id %>" title="متأخر"><i class="fas fa-clock"></i> <span>متأخر</span></button>
                  </div>
                <% } %>
              </div>
            <% }); %>
            <% if (!g.members.length) { %>
              <div class="empty-state"><i class="fas fa-users-slash"></i><p>لا يوجد لاعبون في هذه المجموعة</p></div>
            <% } %>
          </div>
        </details>
      <% }); %>
      <% if (!groups.length) { %><div class="empty-state"><i class="fas fa-users-slash"></i><p>لا توجد مجموعات مرتبطة بهذه الحصة</p></div><% } %>
    </div>
  </div>
</div>

<% if (page.canDel) { %>
<form method="POST" action="/sessions/<%= s.id %>/delete" style="margin-top:12px">
  <button type="submit" class="btn btn-outline-danger" data-confirm="هل أنت متأكد من حذف هذه الحصة؟" data-action="submit"><i class="fas fa-trash"></i> حذف الحصة</button>
</form>
<% } %>
<%- include('partials/layout_bottom') %>
