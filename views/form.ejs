<%- include('partials/layout_top', { title: form.title, active: form.active }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas <%= form.icon || 'fa-pen-to-square' %>"></i> <%= form.title %></div>
    <div class="page-sub"><%= form.subtitle || '' %></div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <form method="POST" action="<%= form.action %>" <%- form.encType ? 'enctype="' + form.encType + '"' : '' %> novalidate>
      <input type="hidden" name="_csrf" value="<%= form.csrf || '' %>">
      <div class="form-grid">
        <% let lastSection = ''; %>
        <% form.fields.forEach(function (f) { %>
          <% if (f.section && f.section !== lastSection) { %>
            <div class="full form-section-title"><i class="fas <%= f.sectionIcon || 'fa-circle-info' %>"></i> <%= f.section %></div>
            <% lastSection = f.section; %>
          <% } %>
          <% if (f.type === 'hidden') { %>
            <input type="hidden" name="<%= f.key %>" value="<%= form.values[f.key] !== undefined ? form.values[f.key] : (f.value || '') %>">
          <% } else { %>
            <div class="form-group <%= f.full ? 'full' : '' %>">
              <label><%= f.label %><% if (f.required) { %> <span class="req">*</span><% } %></label>
              <% const v = form.values[f.key] !== undefined ? form.values[f.key] : (f.value !== undefined ? f.value : ''); %>
              <% if (f.type === 'textarea') { %>
                <textarea class="form-control" name="<%= f.key %>" rows="<%= f.rows || 3 %>" placeholder="<%= f.placeholder || '' %>" <%= f.required ? 'required' : '' %>><%= v %></textarea>
              <% } else if (f.type === 'select') { %>
                <select class="form-control" id="f_<%= f.key %>" name="<%= f.key %>" <%= f.required ? 'required' : '' %>>
                  <option value="">— اختر —</option>
                  <% (typeof f.options === 'function' ? f.options(form.values) : (f.options || [])).forEach(function (o) { %>
                    <option value="<%= o.value %>" <%- o.coach ? 'data-coach="' + o.coach + '"' : '' %> <%= String(v) === String(o.value) ? 'selected' : '' %>><%= o.label %></option>
                  <% }); %>
                </select>
              <% } else if (f.type === 'multiselect') { %>
                <% const selectedArr = Array.isArray(v) ? v.map(String) : (v ? [String(v)] : []); %>
                <% const opts = (typeof f.options === 'function' ? f.options(form.values) : (f.options || [])); %>
                <div class="multi-dropdown" data-multi-dropdown="<%= f.key %>">
                  <button type="button" class="form-control" data-toggle style="display:flex;align-items:center;justify-content:space-between;gap:8px">
                    <span data-label><%= selectedArr.length ? (selectedArr.length + ' محدد') : '— اختر من القائمة —' %></span>
                    <i class="fas fa-chevron-down font-12"></i>
                  </button>
                  <div class="multi-dropdown-menu" data-menu style="display:none">
                    <label class="check-chip w-full" style="margin-bottom:8px;border-bottom:1px solid var(--card-border);border-radius:0;padding-bottom:8px">
                      <input type="checkbox" data-select-all>
                      <div class="chip-box"><i class="fas fa-check-double"></i></div>
                      <span class="chip-label"><b>اختيار الكل</b></span>
                    </label>
                    <div class="flex flex-wrap gap-1">
                      <% opts.forEach(function (o) { %>
                        <label class="check-chip">
                          <input type="checkbox" name="<%= f.key %>[]" value="<%= o.value %>" <%= selectedArr.includes(String(o.value)) ? 'checked' : '' %>>
                          <div class="chip-box"><i class="fas fa-check"></i></div>
                          <span class="chip-label"><%= o.label %></span>
                        </label>
                      <% }); %>
                    </div>
                  </div>
                </div>
              <% } else if (f.type === 'checkbox') { %>
                <label class="flex items-center gap-1" style="cursor:pointer; padding-top:8px;">
                  <input type="hidden" name="<%= f.key %>" value="0">
                  <input type="checkbox" name="<%= f.key %>" value="1" style="width:18px;height:18px;accent-color:var(--primary)" <%= v == 1 ? 'checked' : '' %>> <%= f.checkLabel || '' %>
                </label>
              <% } else if (f.type === 'color') { %>
                <input type="color" class="form-control" name="<%= f.key %>" value="<%= v || '#0284c7' %>" style="height:42px;padding:4px">
              <% } else if (f.type === 'file') { %>
                <div class="camera-field" data-camera-field>
                  <% if (f.preview) { %>
                    <div class="file-preview">
                      <div class="avatar-preview <%= v ? 'has-img' : '' %>" data-avatar-preview>
                        <% if (v) { %><img src="<%= v %>" alt=""><% } else { %><span><%= f.initial || 'س' %></span><% } %>
                      </div>
                      <div class="file-preview-body">
                        <input type="file" class="form-control" name="<%= f.key %>" accept="<%= f.accept || '' %>" data-avatar-input data-camera-input>
                        <div class="form-hint"><%= f.hint || '' %></div>
                      </div>
                    </div>
                  <% } else { %>
                    <input type="file" class="form-control" name="<%= f.key %>" accept="<%= f.accept || '' %>" data-camera-input>
                    <% if (v) { %><div class="form-hint"><a href="<%= v %>" target="_blank" class="btn btn-ghost btn-sm" style="margin-top:6px"><i class="fas fa-paperclip"></i> الملف الحالي</a></div><% } %>
                    <% if (f.hint) { %><div class="form-hint"><%= f.hint %></div><% } %>
                  <% } %>
                  <% if (f.camera) { %>
                    <div class="camera-scan-row">
                      <button type="button" class="btn btn-outline btn-sm" data-camera-open><i class="fas fa-camera"></i> فتح الكاميرا والتقاط صورة</button>
                      <span class="form-hint camera-scan-status" data-camera-status>يمكنك التقاط صورة المستند بالكاميرا مباشرة، أو اختيار ملف من الجهاز.</span>
                    </div>
                    <div class="camera-photo" data-camera-photo hidden></div>
                  <% } %>
                </div>
              <% } else if (f.type === 'schedule-days') { %>
                <div class="form-grid" style="margin-top:2px">
                  <% const sdays = f.days || [['sunday','الأحد'],['monday','الإثنين'],['tuesday','الثلاثاء'],['wednesday','الأربعاء'],['thursday','الخميس'],['friday','الجمعة'],['saturday','السبت']]; %>
                  <% sdays.forEach(function (d) { %>
                    <div class="form-group" style="margin:0">
                      <label><%= d[1] %></label>
                      <div class="flex gap-1">
                        <input type="time" class="form-control" name="day_<%= d[0] %>_start" value="<%= form.values['day_' + d[0] + '_start'] || '' %>">
                        <span class="text-muted" style="align-self:center">إلى</span>
                        <input type="time" class="form-control" name="day_<%= d[0] %>_end" value="<%= form.values['day_' + d[0] + '_end'] || '' %>">
                      </div>
                    </div>
                  <% }); %>
                </div>
                <div class="form-hint">اترك الأيام غير المخصصة للتدريب فارغة.</div>
              <% } else if (f.type === 'info') { %>
                <div class="form-info"><%- typeof f.html === 'function' ? f.html(v, form.values) : (v || '—') %></div>
              <% } else if (f.type === 'coach_auto') { %>
                <input type="hidden" id="f_<%= f.key %>" name="<%= f.key %>" value="<%= v %>" data-orig="<%= v %>">
                <div class="coach-lock" data-coach-key="<%= f.key %>" data-group="<%= f.groupField %>">
                  <i class="fas fa-user-tie"></i>
                  <span class="coach-name">—</span>
                  <i class="fas fa-lock text-soft" title="الكابتن مرتبط بالمجموعة ولا يُعدَّل هنا"></i>
                </div>
                <div class="hint"><i class="fas fa-circle-info"></i> يظهر تلقائياً حسب المجموعة المختارة — لتغييره عدّل إعدادات المجموعة</div>
                <script>(function () { var m = {}; <% (f.coaches || []).forEach(function (c) { %>m[<%= c.value %>] = '<%- c.label.replace(/'/g, "\\'") %>'; <% }); %>window._coachMap = window._coachMap || {}; window._coachMap['<%= f.key %>'] = m; })();</script>
              <% } else { %>
                <input type="<%= f.type || 'text' %>" class="form-control" name="<%= f.key %>" value="<%= v %>" placeholder="<%= f.placeholder || '' %>" <%= f.required ? 'required' : '' %> <%= f.step ? 'step="' + f.step + '"' : '' %> <%= f.min !== undefined ? 'min="' + f.min + '"' : '' %> <%= f.max !== undefined ? 'max="' + f.max + '"' : '' %> <%= f.datalist ? 'list="dl_' + f.key + '"' : '' %>>
                <% if (f.datalist) { %><datalist id="dl_<%= f.key %>"><% f.datalist.forEach(function (o) { %><option value="<%= typeof o === 'object' ? o.value : o %>"><%= typeof o === 'object' ? (o.label || o.value) : o %></option><% }); %></datalist><% } %>
              <% } %>
              <% if (f.hint && f.type !== 'file') { %><div class="form-hint"><%= f.hint %></div><% } %>
            </div>
          <% } %>
        <% }); %>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-floppy-disk"></i> <%= form.submitLabel || 'حفظ' %></button>
        <a href="<%= form.cancelUrl || '/' %>" class="btn btn-outline btn-lg"><i class="fas fa-xmark"></i> إلغاء</a>
      </div>
    </form>
  </div>
</div>
<div class="camera-modal" id="cameraModal" aria-hidden="true">
  <div class="camera-dialog" role="dialog" aria-modal="true" aria-label="التقاط صورة بالكاميرا">
    <div class="camera-head">
      <b><i class="fas fa-camera"></i> التقاط صورة المستند</b>
      <button type="button" class="camera-close" data-camera-close aria-label="إغلاق">&times;</button>
    </div>
    <div class="camera-stage" id="cameraStage">
      <video id="cameraVideo" playsinline autoplay muted></video>
      <div class="camera-error" id="cameraError" hidden></div>
      <canvas id="cameraCanvas" hidden></canvas>
      <canvas id="cameraAdjust" hidden></canvas>
      <canvas id="cameraResult" hidden></canvas>
      <div class="camera-overlay-actions" id="cameraAdjustActions" hidden>
        <button type="button" class="btn btn-primary" id="cameraCrop"><i class="fas fa-crop-simple"></i> قص الصفحة</button>
        <button type="button" class="btn btn-outline" id="cameraUseOriginal"><i class="fas fa-image"></i> استخدام الصورة الأصلية</button>
        <button type="button" class="btn btn-ghost" data-camera-retake><i class="fas fa-rotate-left"></i> إعادة التقاط</button>
      </div>
      <div class="camera-overlay-actions" id="cameraResultActions" hidden>
        <button type="button" class="btn btn-primary" id="cameraUse"><i class="fas fa-check"></i> استخدام الصورة</button>
        <button type="button" class="btn btn-outline" data-camera-retake><i class="fas fa-rotate-left"></i> إعادة التقاط</button>
      </div>
    </div>
    <div class="camera-toolbar" id="cameraControls">
      <button type="button" class="btn btn-primary" id="cameraShoot" disabled><i class="fas fa-camera"></i> التقاط الصورة</button>
      <button type="button" class="btn btn-outline" id="cameraSwitch"><i class="fas fa-camera-rotate"></i> تحويل الكاميرا</button>
      <button type="button" class="btn btn-ghost" data-camera-close><i class="fas fa-xmark"></i> إلغاء</button>
      <label class="camera-mode" title="يحدّد حواف الصفحة تلقائياً ويسمح بتعديلها يدوياً"><input type="checkbox" id="cameraScanner" checked> <span>وضع الماسح (Scanner)</span></label>
    </div>
    <div class="form-hint camera-tip" id="cameraTip"><i class="fas fa-circle-info"></i> ضع المستند في الإطار، ثم اضغط «التقاط الصورة». بعدها اسحب النقاط الأربع لضبط الحدود ثم «قص الصفحة». الكاميرا تظهر بالكامل — الأزرار أسفل الصورة.</div>
  </div>
</div>
<% if (form.transfer) { %>
<div class="card mt-2">
  <div class="card-header"><h3><i class="fas fa-right-left"></i> نقل اللاعب من مجموعة إلى مجموعة</h3></div>
  <div class="card-body">
    <div class="transfer-summary">
      <div class="ts-box">
        <i class="fas fa-people-group"></i>
        <span>المجموعة الحالية</span>
        <b><%= form.transfer.current_group_name %></b>
        <em><i class="fas fa-user-tie"></i> الكابتن: <%= form.transfer.current_coach_name %></em>
      </div>
      <div class="ts-arrow"><i class="fas fa-arrow-left-long"></i></div>
      <div class="ts-box ts-to">
        <i class="fas fa-people-group"></i>
        <span>المجموعة الجديدة</span>
        <b id="transferToGroup">— اختر المجموعة —</b>
        <em><i class="fas fa-user-tie"></i> الكابتن: <span id="transferToCoach">—</span></em>
      </div>
    </div>
    <form method="post" action="<%= form.transfer.action %>" class="grid-2" style="align-items:end" data-confirm="تأكيد نقل اللاعب إلى المجموعة والكابتن الجديد؟ ستبقى كل بياناته (الحضور، التقييمات، الاشتراكات) كما هي.">
      <div class="field">
        <label>المجموعة الجديدة</label>
        <select name="group_id" id="transferGroup" required>
          <option value="">— اختر المجموعة —</option>
          <% form.transfer.groups.forEach(function (g) { %>
            <option value="<%= g.id %>" data-coach="<%= g.coach_id || '' %>" <%= form.transfer.current_group === g.id ? 'selected' : '' %>><%= g.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="field">
        <label>الكابتن <span class="text-soft font-11">(تلقائياً من المجموعة)</span></label>
        <input type="hidden" name="coach_id" id="transferCoach">
        <div class="coach-lock">
          <i class="fas fa-user-tie"></i>
          <span id="transferCoachName">— كابتن المجموعة —</span>
          <i class="fas fa-lock text-soft" title="الكابتن مرتبط بالمجموعة ولا يُعدَّل هنا"></i>
        </div>
        <div class="hint"><i class="fas fa-circle-info"></i> عند اختيار المجموعة يُحدَّد الكابتن تلقائياً — لتغييره عدّل إعدادات المجموعة</div>
      </div>
      <div class="field">
        <label>ملاحظة على النقل (اختياري)</label>
        <input type="text" name="note" placeholder="مثال: انتقال بسبب تغيير المستوى">
      </div>
      <div class="field">
        <button type="submit" class="btn btn-primary"><i class="fas fa-right-left"></i> نقل اللاعب</button>
      </div>
    </form>
    <script>
    (function () {
      var tg = document.getElementById('transferGroup');
      var tc = document.getElementById('transferCoach');
      var coachNames = { <% form.transfer.coaches.forEach(function (c) { %>'<%= c.id %>':'<%- c.full_name.replace(/'/g, "\\'") %>',<% }); %> };
      function syncCoach() {
        var opt = tg ? tg.options[tg.selectedIndex] : null;
        var cid = opt ? (opt.getAttribute('data-coach') || '') : '';
        if (tc) tc.value = cid;
        var view = document.getElementById('transferCoachName');
        var toG = document.getElementById('transferToGroup');
        var toC = document.getElementById('transferToCoach');
        if (opt && opt.value !== '') {
          if (view) view.textContent = (cid && coachNames[cid]) ? coachNames[cid] : '— كابتن المجموعة —';
          if (toG) toG.textContent = opt.textContent;
          if (toC) toC.textContent = (cid && coachNames[cid]) ? coachNames[cid] : '—';
        } else {
          if (view) view.textContent = '— كابتن المجموعة —';
          if (toG) toG.textContent = '— اختر المجموعة —';
          if (toC) toC.textContent = '—';
        }
      }
      if (tg) { tg.addEventListener('change', syncCoach); syncCoach(); }
    })();
    </script>
  </div>
</div>
<% } %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('[data-avatar-input]').forEach(function (input) {
    input.addEventListener('change', function () {
      if (!input.files || !input.files[0]) return;
      var reader = new FileReader();
      reader.onload = function (e) {
        var prev = input.closest('.file-preview').querySelector('[data-avatar-preview]');
        prev.classList.add('has-img');
        prev.innerHTML = '<img src="' + e.target.result + '" alt="">';
      };
      reader.readAsDataURL(input.files[0]);
    });
  });
  document.querySelectorAll('.coach-lock[data-coach-key]').forEach(function (lock) {
    var key = lock.getAttribute('data-coach-key');
    var hidden = document.getElementById('f_' + key);
    var groupSel = document.getElementById('f_' + lock.getAttribute('data-group'));
    if (!hidden || !groupSel) return;
    var map = (window._coachMap || {})[key] || {};
    var nameEl = lock.querySelector('.coach-name');
    function sync() {
      var opt = groupSel.options[groupSel.selectedIndex];
      var cid = opt ? (opt.getAttribute('data-coach') || '') : '';
      if (cid) {
        hidden.value = cid;
        nameEl.textContent = map[cid] || cid;
      } else if (opt && opt.value !== '') {
        hidden.value = '';
        nameEl.textContent = '— كابتن المجموعة —';
      } else {
        hidden.value = hidden.getAttribute('data-orig') || '';
        nameEl.textContent = map[hidden.value] ? map[hidden.value] : (hidden.value ? hidden.value : '— كابتن المجموعة —');
      }
    }
    groupSel.addEventListener('change', sync);
    sync();
  });
});

/* حساب اشتراك بالحصة دون التأثير على نماذج الاشتراكات القديمة */
(function () {
  var type = document.getElementById('f_subscription_type');
  if (!type) return;
  var unit = document.getElementById('f_price_per_session');
  var sessions = document.getElementById('f_sessions_total');
  var price = document.getElementById('f_price');
  var discount = document.getElementById('f_discount');
  var tax = document.getElementById('f_tax');
  var total = document.getElementById('f_total');
  var end = document.getElementById('f_end_date');
  var status = document.getElementById('f_status');
  function number(el) { return Number(el && el.value || 0) || 0; }
  /* حالة الاشتراك تتبع تاريخ النهاية تلقائياً (نشط ⟷ منتهي) */
  function syncStatus() {
    if (!end || !status || !end.value) return;
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var ed = new Date(end.value + 'T00:00:00');
    if (isNaN(ed.getTime())) return;
    var expired = ed < today;
    if (expired && status.value === 'نشط') status.value = 'منتهي';
    else if (!expired && status.value === 'منتهي') status.value = 'نشط';
  }
  function sync() {
    var perSession = type.value === 'per_session' || type.value === 'one_time';
    if (unit) unit.closest('.form-group').style.display = perSession ? '' : 'none';
    if (price) {
      price.readOnly = perSession;
      var label = price.closest('.form-group').querySelector('label');
      if (label) label.childNodes[0].textContent = perSession ? 'إجمالي السعر قبل الخصم والضريبة' : 'سعر الاشتراك (ج.م)';
    }
    if (perSession && price && total) {
      var base = number(unit) * number(sessions);
      var taxValue = number(tax) > 1 ? number(tax) : base * number(tax) / 100;
      price.value = base.toFixed(2);
      total.value = Math.max(0, base - number(discount) + taxValue).toFixed(2);
    }
  }
  [type, unit, sessions, discount, tax].forEach(function (el) { if (el) el.addEventListener('input', sync); if (el) el.addEventListener('change', sync); });
  if (end) { end.addEventListener('change', syncStatus); end.addEventListener('blur', syncStatus); }
  sync();
})();

/* ---------------- التقاط صورة المستند بالكاميرا ---------------- */
(function () {
  var modal = document.getElementById('cameraModal');
  if (!modal) return;
  var video = document.getElementById('cameraVideo');
  var canvas = document.getElementById('cameraCanvas');
  var errEl = document.getElementById('cameraError');
  var shoot = document.getElementById('cameraShoot');
  var switchBtn = document.getElementById('cameraSwitch');
  var currentInput = null;
  var stream = null;
  var facing = 'environment';

  function setError(msg) {
    errEl.textContent = msg || '';
    errEl.hidden = !msg;
    shoot.disabled = !!msg;
  }
  function stopStream() {
    if (stream) {
      stream.getTracks().forEach(function (t) { try { t.stop(); } catch (e) {} });
      stream = null;
    }
    try { video.srcObject = null; } catch (e) {}
  }
  function closeModal() {
    stopStream();
    modal.classList.remove('show');
    modal.setAttribute('aria-hidden', 'true');
    currentInput = null;
  }
  function startCamera() {
    stopStream();
    setError('');
    shoot.disabled = true;
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      setError('المتصفح لا يدعم تشغيل الكاميرا — يمكنك اختيار صورة من ملفات الجهاز بدلاً منها.');
      return;
    }
    var constraints = { video: { facingMode: { ideal: facing } }, audio: false };
    navigator.mediaDevices.getUserMedia(constraints).then(function (s) {
      stream = s;
      video.srcObject = s;
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
      shoot.disabled = false;
    }).catch(function (err) {
      var msg = 'تعذر تشغيل الكاميرا. تأكد من منح الإذن ومن أن الكاميرا غير مستخدمة في تطبيق آخر.';
      if (err && (err.name === 'NotAllowedError' || err.name === 'SecurityError')) msg = 'تم رفض إذن الكاميرا. اسمح بالوصول للكاميرا من إعدادات المتصفح ثم حاول مرة أخرى.';
      else if (err && (err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError')) msg = 'لا توجد كاميرا متاحة على هذا الجهاز — استخدم اختيار ملف من الجهاز.';
      else if (err && (err.name === 'NotReadableError' || err.name === 'TrackStartError')) msg = 'الكاميرا مستخدمة من تطبيق آخر. أغلق التطبيقات الأخرى ثم حاول مرة أخرى.';
      setError(msg);
    });
  }
  function openCamera(input) {
    currentInput = input;
    modal.classList.add('show');
    modal.setAttribute('aria-hidden', 'false');
    startCamera();
  }
  function attachFile(input, file) {
    if (!input) return;
    try {
      var dt = new DataTransfer();
      dt.items.add(file);
      input.files = dt.files;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    } catch (e) {
      var field = input.closest('[data-camera-field]');
      var status = field ? field.querySelector('[data-camera-status]') : null;
      if (status) status.textContent = 'تعذر إرفاق الصورة تلقائياً في هذا المتصفح — استخدم زر اختيار ملف من الجهاز.';
    }
  }

  var resultCanvas = document.getElementById('cameraResult');
  var resultActions = document.getElementById('cameraResultActions');
  var adjustCanvas = document.getElementById('cameraAdjust');
  var adjustActions = document.getElementById('cameraAdjustActions');
  var scannerCheck = document.getElementById('cameraScanner');
  var controls = document.getElementById('cameraControls');
  var cvReady = false;
  var loadingOpenCV = false;
  var cornerPoints = [];
  var draggingPoint = null;
  var adjustCtx = adjustCanvas ? adjustCanvas.getContext('2d') : null;

  function loadOpenCV() {
    return new Promise(function (resolve, reject) {
      if (window.cv && window.cv.getBuildInformation) { cvReady = true; return resolve(); }
      if (loadingOpenCV) { var iv = setInterval(function () { if (cvReady) { clearInterval(iv); resolve(); } }, 200); return; }
      loadingOpenCV = true;
      var script = document.createElement('script');
      script.src = 'https://docs.opencv.org/4.10.0/opencv.js';
      script.async = true;
      script.crossOrigin = 'anonymous';
      window.cv = window.cv || {};
      window.cv.onRuntimeInitialized = function () { cvReady = true; loadingOpenCV = false; resolve(); };
      script.onerror = function () { loadingOpenCV = false; reject(new Error('تعذر تحميل مكتبة الماسح')); };
      document.body.appendChild(script);
      setTimeout(function () { if (!cvReady) reject(new Error('انتهت مهلة تحميل الماسح')); }, 20000);
    });
  }

  function showScanningState(loading) {
    var tip = document.getElementById('cameraTip');
    if (tip) tip.innerHTML = loading ? '<i class="fas fa-spinner fa-spin"></i> جارٍ تحميل مكتبة الماسح...' : '<i class="fas fa-circle-info"></i> ضع المستند أمام الكاميرا في إضاءة جيدة، ثم اضغط «التقاط الصورة». بعدها اسحب النقاط الأربع لضبط الحواف، ثم اضغط «قص الصفحة».';
  }

  function distance(p1, p2) { return Math.sqrt(Math.pow(p1.x - p2.x, 2) + Math.pow(p1.y - p2.y, 2)); }
  function orderPoints(pts) {
    var arr = pts.slice(0);
    arr.sort(function (a, b) { return (a.y - b.y) || (a.x - b.x); });
    var top = arr.slice(0, 2).sort(function (a, b) { return a.x - b.x; });
    var bottom = arr.slice(2).sort(function (a, b) { return a.x - b.x; });
    return [top[0], top[1], bottom[1], bottom[0]]; // TL, TR, BR, BL
  }

  function detectCorners(src) {
    if (!window.cv || !cv.Mat) return null;
    try {
      var gray = new cv.Mat();
      cv.cvtColor(src, gray, cv.COLOR_RGBA2GRAY);
      var blurred = new cv.Mat();
      cv.GaussianBlur(gray, blurred, new cv.Size(5, 5), 0);
      var edges = new cv.Mat();
      cv.Canny(blurred, edges, 50, 150, 3);
      var contours = new cv.MatVector();
      var hierarchy = new cv.Mat();
      cv.findContours(edges, contours, hierarchy, cv.RETR_LIST, cv.CHAIN_APPROX_SIMPLE);
      var best = null;
      var maxArea = 0;
      var imgArea = src.cols * src.rows;
      for (var i = 0; i < contours.size(); i++) {
        var cnt = contours.get(i);
        var area = cv.contourArea(cnt);
        if (area < imgArea * 0.06) continue;
        var peri = cv.arcLength(cnt, true);
        var approx = new cv.Mat();
        cv.approxPolyDP(cnt, approx, 0.02 * peri, true);
        if (approx.rows === 4 && area > maxArea) {
          var pts = [];
          for (var j = 0; j < 4; j++) pts.push({ x: approx.data32S[j * 2], y: approx.data32S[j * 2 + 1] });
          best = pts;
          maxArea = area;
          approx.delete();
        } else { approx.delete(); }
        cnt.delete();
      }
      contours.delete(); hierarchy.delete(); edges.delete(); blurred.delete(); gray.delete();
      return best;
    } catch (e) { console.error('detectCorners', e); return null; }
  }

  function warpDocument(src, pts) {
    var ordered = orderPoints(pts);
    var tl = ordered[0], tr = ordered[1], br = ordered[2], bl = ordered[3];
    var widthA = distance(br, bl), widthB = distance(tr, tl);
    var maxW = Math.max(widthA, widthB);
    var heightA = distance(tr, br), heightB = distance(tl, bl);
    var maxH = Math.max(heightA, heightB);
    var dstW = Math.round(maxW), dstH = Math.round(maxH);
    if (dstW < 200 || dstH < 200) return null;
    var srcTri = cv.matFromArray(4, 1, cv.CV_32FC2, [tl.x, tl.y, tr.x, tr.y, br.x, br.y, bl.x, bl.y]);
    var dstTri = cv.matFromArray(4, 1, cv.CV_32FC2, [0, 0, dstW - 1, 0, dstW - 1, dstH - 1, 0, dstH - 1]);
    var M = cv.getPerspectiveTransform(srcTri, dstTri);
    var dst = new cv.Mat();
    cv.warpPerspective(src, dst, M, new cv.Size(dstW, dstH));
    srcTri.delete(); dstTri.delete(); M.delete();
    return { mat: dst, width: dstW, height: dstH };
  }

  function setCameraMode() {
    video.hidden = false;
    canvas.hidden = true;
    resultCanvas.hidden = true;
    resultActions.hidden = true;
    adjustCanvas.hidden = true;
    adjustActions.hidden = true;
    controls.style.display = 'flex';
  }
  function setAdjustMode() {
    video.hidden = true;
    canvas.hidden = true;
    resultCanvas.hidden = true;
    resultActions.hidden = true;
    adjustCanvas.hidden = false;
    adjustActions.hidden = false;
    controls.style.display = 'none';
  }
  function setResultMode() {
    video.hidden = true;
    canvas.hidden = true;
    resultCanvas.hidden = false;
    resultActions.hidden = false;
    adjustCanvas.hidden = true;
    adjustActions.hidden = true;
    controls.style.display = 'none';
  }

  function getAdjustPos(e) {
    var r = adjustCanvas.getBoundingClientRect();
    var cx, cy;
    if (e.touches && e.touches.length) { cx = e.touches[0].clientX; cy = e.touches[0].clientY; }
    else { cx = e.clientX; cy = e.clientY; }
    return {
      x: (cx - r.left) * (adjustCanvas.width / r.width),
      y: (cy - r.top) * (adjustCanvas.height / r.height)
    };
  }
  function clampPoint(p) {
    return {
      x: Math.max(0, Math.min(adjustCanvas.width, p.x)),
      y: Math.max(0, Math.min(adjustCanvas.height, p.y))
    };
  }
  function findNearest(p) {
    var r = adjustCanvas.getBoundingClientRect();
    var scale = adjustCanvas.width / r.width;
    var threshold = 34 * scale;
    var best = -1, bestD = threshold;
    for (var i = 0; i < cornerPoints.length; i++) {
      var d = distance(p, cornerPoints[i]);
      if (d < bestD) { bestD = d; best = i; }
    }
    return best;
  }
  function drawAdjust() {
    if (!adjustCtx) return;
    var w = adjustCanvas.width, h = adjustCanvas.height;
    adjustCtx.clearRect(0, 0, w, h);
    adjustCtx.drawImage(cameraCanvas, 0, 0, w, h);
    if (cornerPoints.length === 4) {
      adjustCtx.save();
      adjustCtx.strokeStyle = '#f59e0b';
      adjustCtx.lineWidth = Math.max(3, w / 350);
      adjustCtx.setLineDash([12, 8]);
      adjustCtx.beginPath();
      cornerPoints.forEach(function (p, i) { if (i === 0) adjustCtx.moveTo(p.x, p.y); else adjustCtx.lineTo(p.x, p.y); });
      adjustCtx.closePath();
      adjustCtx.stroke();
      adjustCtx.restore();
      cornerPoints.forEach(function (p, i) {
        adjustCtx.beginPath();
        adjustCtx.arc(p.x, p.y, Math.max(10, w / 90), 0, Math.PI * 2);
        adjustCtx.fillStyle = draggingPoint === i ? '#f59e0b' : '#0ea5e9';
        adjustCtx.fill();
        adjustCtx.lineWidth = 3;
        adjustCtx.strokeStyle = '#fff';
        adjustCtx.stroke();
      });
    }
  }

  function startAdjust() {
    if (!adjustCanvas) return;
    adjustCanvas.width = cameraCanvas.width;
    adjustCanvas.height = cameraCanvas.height;
    cornerPoints = [];
    var margin = Math.min(cameraCanvas.width, cameraCanvas.height) * 0.05;
    var defaults = [
      { x: margin, y: margin },
      { x: cameraCanvas.width - margin, y: margin },
      { x: cameraCanvas.width - margin, y: cameraCanvas.height - margin },
      { x: margin, y: cameraCanvas.height - margin }
    ];
    if (scannerCheck && scannerCheck.checked && cvReady) {
      try {
        var src = cv.imread(cameraCanvas);
        var corners = detectCorners(src);
        src.delete();
        if (corners) cornerPoints = orderPoints(corners);
      } catch (e) { console.error('auto detect failed', e); }
    }
    if (!cornerPoints.length) cornerPoints = defaults;
    setAdjustMode();
    drawAdjust();
  }

  function doCrop() {
    if (!cornerPoints.length || cornerPoints.length !== 4) return;
    if (!cvReady) {
      loadOpenCV().then(doCrop).catch(function () { useOriginal(); });
      return;
    }
    try {
      var src = cv.imread(cameraCanvas);
      var warped = warpDocument(src, cornerPoints);
      src.delete();
      if (warped && warped.mat) {
        cv.imshow(resultCanvas, warped.mat);
        warped.mat.delete();
        setResultMode();
        return;
      }
    } catch (e) { console.error('crop failed', e); }
    useOriginal();
  }

  function useOriginal() {
    resultCanvas.width = cameraCanvas.width;
    resultCanvas.height = cameraCanvas.height;
    resultCanvas.getContext('2d').drawImage(cameraCanvas, 0, 0);
    setResultMode();
  }

  function capture() {
    if (!stream || !video.videoWidth || !video.videoHeight) return;
    cameraCanvas.width = video.videoWidth;
    cameraCanvas.height = video.videoHeight;
    var ctx = cameraCanvas.getContext('2d');
    ctx.drawImage(video, 0, 0, cameraCanvas.width, cameraCanvas.height);
    stopStream();
    if (scannerCheck && scannerCheck.checked) {
      startAdjust();
    } else {
      useOriginal();
    }
  }

  function finishCapture() {
    var done = false;
    resultCanvas.toBlob(function (blob) {
      if (done) return;
      done = true;
      if (!blob) { setError('تعذر حفظ الصورة.'); return; }
      var file = new File([blob], 'scan-' + Date.now() + '.jpg', { type: 'image/jpeg' });
      attachFile(currentInput, file);
      closeModal();
      setTimeout(setCameraMode, 200);
    }, 'image/jpeg', 0.92);
  }

  function retake() {
    setCameraMode();
    startCamera();
  }

  function openCamera(input) {
    currentInput = input;
    modal.classList.add('show');
    modal.setAttribute('aria-hidden', 'false');
    setCameraMode();
    if (scannerCheck && scannerCheck.checked) {
      shoot.disabled = true;
      showScanningState(true);
      loadOpenCV().then(function () {
        shoot.disabled = false;
        showScanningState(false);
      }).catch(function (err) {
        showScanningState(false);
        console.warn('OpenCV load failed', err);
      });
    }
    startCamera();
  }

  if (adjustCanvas) {
    function onDown(e) {
      var p = getAdjustPos(e);
      var idx = findNearest(p);
      if (idx >= 0) { draggingPoint = idx; drawAdjust(); }
    }
    function onMove(e) {
      if (draggingPoint === null) return;
      if (e.touches) e.preventDefault();
      var p = clampPoint(getAdjustPos(e));
      cornerPoints[draggingPoint] = p;
      drawAdjust();
    }
    function onUp() { draggingPoint = null; drawAdjust(); }
    adjustCanvas.addEventListener('mousedown', onDown);
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup', onUp);
    adjustCanvas.addEventListener('touchstart', onDown, { passive: false });
    window.addEventListener('touchmove', onMove, { passive: false });
    window.addEventListener('touchend', onUp);
  }

  document.querySelectorAll('[data-camera-open]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var field = btn.closest('[data-camera-field]');
      var input = field ? field.querySelector('[data-camera-input]') : null;
      if (input) openCamera(input);
    });
  });
  shoot.addEventListener('click', capture);
  document.getElementById('cameraUse').addEventListener('click', finishCapture);
  document.getElementById('cameraCrop').addEventListener('click', doCrop);
  document.getElementById('cameraUseOriginal').addEventListener('click', useOriginal);
  document.querySelectorAll('[data-camera-retake]').forEach(function (btn) { btn.addEventListener('click', retake); });
  switchBtn.addEventListener('click', function () {
    facing = facing === 'environment' ? 'user' : 'environment';
    startCamera();
  });
  modal.querySelectorAll('[data-camera-close]').forEach(function (btn) {
    btn.addEventListener('click', closeModal);
  });
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal.classList.contains('show')) closeModal();
  });
  document.addEventListener('visibilitychange', function () {
    if (document.hidden && modal.classList.contains('show')) closeModal();
  });

  document.querySelectorAll('[data-camera-field] [data-camera-input]').forEach(function (input) {
    input.addEventListener('change', function () {
      if (!input.files || !input.files[0]) return;
      var field = input.closest('[data-camera-field]');
      if (!field) return;
      var file = input.files[0];
      var status = field.querySelector('[data-camera-status]');
      var box = field.querySelector('[data-camera-photo]');
      if (status) status.textContent = 'تم إرفاق: ' + file.name + ' (' + Math.max(1, Math.round(file.size / 1024)) + ' كيلوبايت).';
      if (box) {
        box.innerHTML = '';
        if (file.type && file.type.indexOf('image/') === 0 && window.URL && URL.createObjectURL) {
          var img = document.createElement('img');
          img.src = URL.createObjectURL(file);
          img.alt = file.name;
          box.appendChild(img);
          box.hidden = false;
        } else {
          box.hidden = true;
        }
      }
    });
  });
})();
</script>
<%- include('partials/layout_bottom') %>
