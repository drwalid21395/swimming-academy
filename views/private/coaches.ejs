<%- include('../partials/layout_top', { title: 'التدريب الخاص', active: 'privateTraining' }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-dumbbell"></i> التدريب الخاص</div>
    <div class="page-sub">مواعيد التدريب الخاص لكل مدرب مع شبكة الحجز الأسبوعية ومتابعة الباقات وحضور اللاعبين</div>
  </div>
</div>

<div class="card">
  <div class="card-header"><i class="fas fa-user-tie"></i> المدربون</div>
  <div class="card-body">
    <% if (!coaches.length) { %>
      <div class="empty-state text-center" style="padding:30px 10px">
        <i class="fas fa-user-slash fa-2x text-muted"></i>
        <p class="text-muted" style="margin-top:10px">لا يوجد مدربون. أضف مدربين أولاً من تبويب «المدربون».</p>
      </div>
    <% } else { %>
      <div class="grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px">
        <% coaches.forEach(function (c) { var st = stats[c.id] || {}; %>
          <div class="card" style="margin:0;border:1px solid var(--card-border)">
            <div class="card-body">
              <div class="flex" style="align-items:center;gap:10px">
                <div style="width:44px;height:44px;border-radius:50%;background:var(--primary-soft);color:var(--primary);display:flex;align-items:center;justify-content:center;font-weight:700">
                  <%= (c.full_name || '؟').trim().charAt(0) %>
                </div>
                <div style="min-width:0">
                  <div style="font-weight:700;overflow-wrap:anywhere"><%= c.full_name %></div>
                  <div class="text-muted font-11"><%= c.phone || '—' %></div>
                </div>
              </div>
              <div class="flex gap-1" style="flex-wrap:wrap;margin-top:12px">
                <span class="badge badge-info"><i class="fas fa-clock"></i> <%= st.slots || 0 %> موعد</span>
                <span class="badge badge-success"><i class="fas fa-ticket"></i> <%= st.packages || 0 %> باقة</span>
                <span class="badge badge-warning"><i class="fas fa-calendar-check"></i> <%= st.upcoming || 0 %> قادمة</span>
              </div>
              <a href="/private-training/coach/<%= c.id %>" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:12px">
                <i class="fas fa-calendar-days"></i> إدارة المواعيد والحجز
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/layout_bottom') %>
