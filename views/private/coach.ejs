<%- include('../partials/layout_top', { title: 'التدريب الخاص', active: 'privateTraining' }) %>
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-dumbbell"></i> التدريب الخاص — <%= coach.full_name %></div>
    <div class="page-sub">
      <a href="/private-training" class="text-muted"><i class="fas fa-arrow-right"></i> كل المدربين</a>
      <span class="text-muted"> • </span>
      <span class="text-muted"><%= coach.phone || 'لا يوجد هاتف' %></span>
    </div>
  </div>
  <div class="spacer"></div>
  <div class="flex gap-1" style="flex-wrap:wrap">
    <a class="btn btn-outline" href="?week=<%= prevWeek %>"><i class="fas fa-chevron-right"></i> الأسبوع السابق</a>
    <a class="btn btn-ghost" href="/private-training/coach/<%= coach.id %>"><i class="fas fa-calendar-day"></i> الأسبوع الحالي</a>
    <a class="btn btn-outline" href="?week=<%= nextWeek %>">الأسبوع التالي <i class="fas fa-chevron-left"></i></a>
  </div>
</div>

<div class="kpi-row">
  <div class="kpi"><div class="k-val text-primary"><%= kpi.slots %></div><div class="k-lbl">مواعيد أسبوعية</div></div>
  <div class="kpi"><div class="k-val text-success"><%= kpi.packages %></div><div class="k-lbl">باقات نشطة</div></div>
  <div class="kpi"><div class="k-val text-warning"><%= kpi.scheduled %></div><div class="k-lbl">حصص مجدولة</div></div>
  <div class="kpi"><div class="k-val"><%= kpi.used %></div><div class="k-lbl">حصص موثّقة (حضور)</div></div>
</div>

<div class="card">
  <div class="card-header">
    <i class="fas fa-calendar-week"></i> جدول الأسبوع
    <span class="text-muted font-11" style="margin-inline-start:auto"><%= weekStartISO %> ⇠ <%= weekEndISO %></span>
  </div>
  <div class="card-body">
    <div class="wk-grid">
      <% days.forEach(function (day) { %>
        <div class="wk-day <%= day.isToday ? 'today' : '' %>">
          <div class="wk-day-head">
            <span><%= day.label %></span>
            <span class="wk-date"><%= day.date %></span>
          </div>
          <div class="wk-day-body">
            <% if (!day.entries.length) { %>
              <div class="wk-empty">لا توجد مواعيد</div>
            <% } %>
            <% day.entries.forEach(function (e) { %>
              <% if (e.session) { var s = e.session; %>
                <div class="wk-slot booked <%= day.isPast ? 'past' : '' %>">
                  <div class="wk-time"><span><i class="fas fa-clock"></i> <%= s.start_time %> - <%= s.end_time %></span><%- statusBadge(s.status) %></div>
                  <div class="wk-name"><i class="fas fa-user"></i> <%= s.swimmer_name || '—' %></div>
                  <div class="wk-actions">
                    <% if (canEdit) { ['present','absent','late'].forEach(function (stt) { %>
                      <form method="post" action="/private-training/session/<%= s.id %>/attendance">
                        <input type="hidden" name="status" value="<%= stt %>">
                        <input type="hidden" name="coach_id" value="<%= coach.id %>">
                        <button class="btn <%= stt === 'present' ? 'btn-success' : (stt === 'absent' ? 'btn-danger' : 'btn-warning') %>" type="submit" title="<%= PRIV_STATUS[stt].label %>"><i class="fas <%= PRIV_STATUS[stt].icon %>"></i></button>
                      </form>
                    <% }); } %>
                    <% if (canDel) { %>
                      <form method="post" action="/private-training/session/<%= s.id %>/delete" data-confirm="حذف هذه الحصة؟">
                        <input type="hidden" name="coach_id" value="<%= coach.id %>">
                        <button class="btn btn-ghost" type="submit" title="حذف"><i class="fas fa-trash"></i></button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% } else if (canAdd && !day.isPast) { var activePkgs = packages.filter(function (p) { return p.status === 'نشط' && Number(p.sessions_left) > 0; }); %>
                <div class="wk-slot free">
                  <div class="wk-time"><span><i class="fas fa-clock"></i> <%= e.start %> - <%= e.end %></span><span class="text-muted font-11"><%= money(e.rate) %></span></div>
                  <% if (activePkgs.length) { %>
                    <form method="post" action="/private-training/coach/<%= coach.id %>/book">
                      <input type="hidden" name="date" value="<%= day.date %>">
                      <input type="hidden" name="start_time" value="<%= e.start %>">
                      <input type="hidden" name="end_time" value="<%= e.end %>">
                      <input type="hidden" name="availability_id" value="<%= e.availability_id || '' %>">
                      <input type="hidden" name="rate" value="<%= e.rate || 0 %>">
                      <select name="package_id" class="form-control" required>
                        <option value="">— اختر الباقة —</option>
                        <% activePkgs.forEach(function (p) { %>
                          <option value="<%= p.id %>"><%= p.swimmer_name %> (متبقي <%= p.sessions_left %>)</option>
                        <% }); %>
                      </select>
                      <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center;margin-top:4px"><i class="fas fa-plus"></i> حجز</button>
                    </form>
                  <% } else { %>
                    <div class="text-muted font-11" style="margin-top:4px">لا توجد باقات نشطة للحجز</div>
                  <% } %>
                </div>
              <% } else { %>
                <div class="wk-slot <%= day.isPast ? 'past' : '' %>">
                  <div class="wk-time"><span><i class="fas fa-clock"></i> <%= e.start %> - <%= e.end %></span></div>
                </div>
              <% } %>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</div>

<div class="grid-2" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px">
  <div class="card">
    <div class="card-header"><i class="fas fa-repeat"></i> المواعيد الأسبوعية المتاحة</div>
    <div class="card-body">
      <% if (canAdd) { %>
        <form method="post" action="/private-training/coach/<%= coach.id %>/availability" class="flex gap-1" style="flex-wrap:wrap;align-items:flex-end;margin-bottom:12px">
          <div class="form-group" style="margin:0">
            <label class="font-11 text-muted">اليوم</label>
            <select name="weekday" class="form-control" required>
              <% dayFull.forEach(function (d, i) { %><option value="<%= i %>"><%= d %></option><% }); %>
            </select>
          </div>
          <div class="form-group" style="margin:0">
            <label class="font-11 text-muted">من</label>
            <input type="time" name="start_time" class="form-control" required>
          </div>
          <div class="form-group" style="margin:0">
            <label class="font-11 text-muted">إلى</label>
            <input type="time" name="end_time" class="form-control" required>
          </div>
          <div class="form-group" style="margin:0">
            <label class="font-11 text-muted">مستحق المدرب</label>
            <input type="number" step="0.01" min="0" name="rate" class="form-control" style="width:110px">
          </div>
          <button class="btn btn-primary" type="submit"><i class="fas fa-plus"></i> إضافة موعد</button>
        </form>
      <% } %>
      <div class="table-wrap">
        <table class="data-table rtable">
          <thead><tr><th>اليوم</th><th>من</th><th>إلى</th><th>مستحق المدرب</th><th>حالة</th><th></th></tr></thead>
          <tbody>
            <% if (!availability.length) { %><tr><td colspan="6" class="text-center text-muted">لا توجد مواعيد بعد</td></tr><% } %>
            <% availability.forEach(function (a) { %>
              <tr>
                <td data-label="اليوم"><%= dayFull[Number(a.weekday)] || '—' %></td>
                <td data-label="من"><%= a.start_time %></td>
                <td data-label="إلى"><%= a.end_time %></td>
                <td data-label="مستحق المدرب"><%= money(a.rate) %></td>
                <td data-label="حالة"><span class="badge <%= a.status === 'نشط' ? 'badge-success' : 'badge-gray' %>"><%= a.status %></span></td>
                <td class="rt-actions">
                  <% if (canDel) { %>
                    <form method="post" action="/private-training/availability/<%= a.id %>/delete" data-confirm="حذف هذا الموعد الأسبوعي؟">
                      <button class="btn btn-ghost btn-sm" type="submit"><i class="fas fa-trash"></i></button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><i class="fas fa-ticket"></i> باقات التدريب الخاص</div>
    <div class="card-body">
      <% if (canAdd) { %>
        <form method="post" action="/private-training/coach/<%= coach.id %>/package" class="flex gap-1" style="flex-wrap:wrap;align-items:flex-end;margin-bottom:12px">
          <div class="form-group" style="margin:0;min-width:180px">
            <label class="font-11 text-muted">اللاعب</label>
            <select name="swimmer_id" class="form-control" required>
              <option value="">— اختر اللاعب —</option>
              <% swimmers.forEach(function (sw) { %><option value="<%= sw.id %>"><%= sw.full_name %></option><% }); %>
            </select>
          </div>
          <div class="form-group" style="margin:0">
            <label class="font-11 text-muted">عدد الحصص</label>
            <input type="number" min="1" name="sessions_total" class="form-control" style="width:90px" value="8" required>
          </div>
          <div class="form-group" style="margin:0">
            <label class="font-11 text-muted">سعر الحصة</label>
            <input type="number" step="0.01" min="0" name="price_per_session" class="form-control" style="width:110px">
          </div>
          <div class="form-group" style="margin:0">
            <label class="font-11 text-muted">المدفوع</label>
            <input type="number" step="0.01" min="0" name="paid_amount" class="form-control" style="width:110px">
          </div>
          <div class="form-group" style="margin:0">
            <label class="font-11 text-muted">تاريخ البداية</label>
            <input type="date" name="start_date" class="form-control" value="<%= today %>">
          </div>
          <button class="btn btn-primary" type="submit"><i class="fas fa-plus"></i> إنشاء باقة</button>
        </form>
      <% } %>
      <div class="table-wrap">
        <table class="data-table rtable">
          <thead><tr><th>اللاعب</th><th>الحصص</th><th>المستخدم</th><th>المتبقي</th><th>السعر</th><th>المدفوع</th><th>المتبقي ماليًا</th><th>حالة</th><th></th></tr></thead>
          <tbody>
            <% if (!packages.length) { %><tr><td colspan="9" class="text-center text-muted">لا توجد باقات بعد</td></tr><% } %>
            <% packages.forEach(function (p) { var pct = Number(p.sessions_total) > 0 ? Math.min(100, Math.round(Number(p.sessions_used) / Number(p.sessions_total) * 100)) : 0; %>
              <tr>
                <td data-label="اللاعب"><%= p.swimmer_name || '—' %></td>
                <td data-label="عدد الحصص"><%= p.sessions_total %></td>
                <td data-label="المستهلك">
                  <%= p.sessions_used %>
                  <div class="pk-bar"><span style="width:<%= pct %>%"></span></div>
                </td>
                <td data-label="المتبقي"><span class="badge <%= Number(p.sessions_left) > 0 ? 'badge-success' : 'badge-gray' %>"><%= p.sessions_left %></span></td>
                <td data-label="السعر"><%= money(p.price) %></td>
                <td data-label="المدفوع"><%= money(p.paid_amount) %></td>
                <td data-label="المتبقي"><%= money(p.remaining) %></td>
                <td data-label="حالة"><span class="badge <%= p.status === 'نشط' ? 'badge-success' : (p.status === 'منتهي' ? 'badge-gray' : 'badge-danger') %>"><%= p.status %></span></td>
                <td class="rt-actions">
                  <% if (canDel && Number(p.sessions_used) === 0) { %>
                    <form method="post" action="/private-training/package/<%= p.id %>/delete" data-confirm="حذف هذه الباقة؟">
                      <button class="btn btn-ghost" type="submit" title="حذف"><i class="fas fa-trash"></i></button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header"><i class="fas fa-list-check"></i> سجل حصص التدريب الخاص</div>
  <div class="card-body">
    <div class="table-wrap">
      <table class="data-table rtable">
        <thead><tr><th>التاريخ</th><th>الوقت</th><th>اللاعب</th><th>مستحق المدرب</th><th>الحالة</th><th>تسجيل الحضور</th></tr></thead>
        <tbody>
          <% if (!allSessions.length) { %><tr><td colspan="6" class="text-center text-muted">لا توجد حصص مسجلة</td></tr><% } %>
          <% allSessions.forEach(function (s) { %>
            <tr>
              <td data-label="التاريخ"><%= s.date %></td>
              <td data-label="الوقت"><%= s.start_time %> - <%= s.end_time %></td>
              <td data-label="اللاعب"><%= s.swimmer_name || '—' %></td>
              <td data-label="مستحق المدرب"><%= money(s.rate) %></td>
              <td data-label="الحالة"><%- statusBadge(s.status) %></td>
              <td data-label="تسجيل الحضور">
                <div class="table-actions flex gap-1" style="flex-wrap:wrap">
                  <% if (canEdit && ['present','absent','late'].indexOf(s.status) === -1) { %>
                    <form method="post" action="/private-training/session/<%= s.id %>/attendance"><input type="hidden" name="status" value="present"><input type="hidden" name="coach_id" value="<%= coach.id %>"><button class="btn btn-success btn-sm" type="submit"><i class="fas fa-check"></i> حاضر</button></form>
                    <form method="post" action="/private-training/session/<%= s.id %>/attendance"><input type="hidden" name="status" value="absent"><input type="hidden" name="coach_id" value="<%= coach.id %>"><button class="btn btn-danger btn-sm" type="submit"><i class="fas fa-xmark"></i> غائب</button></form>
                    <form method="post" action="/private-training/session/<%= s.id %>/attendance"><input type="hidden" name="status" value="excused"><input type="hidden" name="coach_id" value="<%= coach.id %>"><button class="btn btn-ghost btn-sm" type="submit"><i class="fas fa-hand"></i> معتذر</button></form>
                  <% } else if (canEdit) { %>
                    <form method="post" action="/private-training/session/<%= s.id %>/attendance"><input type="hidden" name="status" value="scheduled"><input type="hidden" name="coach_id" value="<%= coach.id %>"><button class="btn btn-outline btn-sm" type="submit"><i class="fas fa-rotate-left"></i> تراجع</button></form>
                  <% } %>
                  <% if (canDel) { %>
                    <form method="post" action="/private-training/session/<%= s.id %>/delete" data-confirm="حذف هذه الحصة؟"><input type="hidden" name="coach_id" value="<%= coach.id %>"><button class="btn btn-ghost btn-sm" type="submit" title="حذف"><i class="fas fa-trash"></i></button></form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/layout_bottom') %>
