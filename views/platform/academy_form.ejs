<%- include('../partials/layout_top', { title: title, active: active, pageCss: ['/css/platform.css'] }) %>
<div class="platform">
  <div class="pf-hero">
    <div>
      <div class="pf-hero-eyebrow"><i class="fas fa-building"></i> أكاديميات</div>
      <div class="pf-hero-title"><%= values && values.id ? 'تعديل أكاديمية' : 'إضافة أكاديمية جديدة' %></div>
      <div class="pf-hero-sub">بيانات الأكاديمية والاشتراك الأولي وحساب المدير</div>
    </div>
    <div class="pf-hero-actions"><a href="/platform/academies" class="btn-hero btn-hero-ghost"><i class="fas fa-arrow-right"></i> العودة</a></div>
  </div>

  <div class="pf-card">
    <div class="pf-card-body">
      <form method="POST" action="<%= action %>" enctype="multipart/form-data" onsubmit="return window.__validateAcademyForm && window.__validateAcademyForm(event)">

        <div class="pf-sec-title"><i class="fas fa-id-card"></i> البيانات الأساسية</div>
        <div class="pf-form-grid" style="margin-top:14px">
          <div class="pf-field"><label>اسم الأكاديمية <span class="req">*</span></label><input class="pf-input" name="name" value="<%= values ? values.name : '' %>" required></div>
          <div class="pf-field"><label>اسم المدير (المالك)</label><input class="pf-input" name="owner_name" value="<%= values ? values.owner_name : '' %>"></div>
          <div class="pf-field"><label>اسم مستخدم مدير الأكاديمية <span class="req">*</span></label><input class="pf-input" name="username" dir="ltr" value="<%= values ? values.username : '' %>" style="text-align:left" required <%= values && values.id ? 'readonly' : '' %>></div>
          <div class="pf-field"><label>الخطة</label>
            <select name="plan_id" class="pf-input">
              <option value="">بدون خطة</option>
              <% plans.forEach(function (pl) { %>
                <option value="<%= pl.id %>" <%= values && values.plan_id == pl.id ? 'selected' : '' %>><%= pl.name %> — <%= money(pl.monthly_price) %>/شهرياً</option>
              <% }); %>
            </select>
          </div>
          <div class="pf-field"><label>تاريخ بدء الاشتراك</label><input class="pf-input" name="start_date" dir="ltr" type="date" value="<%= values ? (values.start_date || today) : today %>"></div>
          <div class="pf-field"><label>الحالة</label>
            <select name="status" class="pf-input">
              <option value="active" <%= (values && values.status === 'suspended') ? '' : 'selected' %>>مفعلة</option>
              <option value="suspended" <%= (values && values.status === 'suspended') ? 'selected' : '' %>>موقوفة</option>
            </select>
          </div>
        </div>

        <% if (values && values.id) { %>
          <div class="pf-sec-title"><i class="fas fa-key"></i> كلمة مرور مدير الأكاديمية</div>
          <div class="pf-form-grid" style="margin-top:14px">
            <div class="pf-field"><label>كلمة مرور جديدة <span class="req">*</span></label><input class="pf-input" name="admin_password" dir="ltr" type="password" placeholder="اتركها فارغة للاحتفاظ بالحالية" style="text-align:left"></div>
            <div class="pf-field"><label>إعادة كتابة كلمة المرور</label><input class="pf-input" dir="ltr" type="password" placeholder="أعد كتابتها للتأكيد" style="text-align:left" oninput="this.setAttribute('data-cnf', this.value)"></div>
          </div>
        <% } %>

        <% if (!(values && values.id)) { %>
          <div class="pf-sec-title"><i class="fas fa-file-contract"></i> الاشتراك الأولي وحساب المدير</div>
          <div class="pf-form-grid" style="margin-top:14px">
            <div class="pf-field"><label>كلمة المرور المؤقتة للمدير</label><input class="pf-input" name="temp_password" dir="ltr" value="123456" style="text-align:left"></div>
            <div class="pf-field"><label>مدة الاشتراك الأولي (شهور)</label><input class="pf-input" name="duration_months" type="number" value="1" min="1"></div>
            <div class="pf-field"><label>سعر الاشتراك (اختياري)</label><input class="pf-input" name="monthly_price" type="number" step="0.01"></div>
            <div class="pf-field"><label>أيام السماح بعد الانتهاء</label><input class="pf-input" name="grace_days" type="number" value="7" min="0"></div>
          </div>
        <% } %>

        <div class="pf-sec-title"><i class="fas fa-address-book"></i> بيانات التواصل</div>
        <div class="pf-form-grid" style="margin-top:14px">
          <div class="pf-field"><label>الهاتف</label><input class="pf-input" name="phone" dir="ltr" value="<%= values ? values.phone : '' %>" style="text-align:left"></div>
          <div class="pf-field"><label>الواتساب</label><input class="pf-input" name="whatsapp" dir="ltr" value="<%= values ? values.whatsapp : '' %>" style="text-align:left"></div>
          <div class="pf-field"><label>البريد</label><input class="pf-input" name="email" dir="ltr" type="email" value="<%= values ? values.email : '' %>" style="text-align:left"></div>
          <div class="pf-field"><label>العنوان</label><input class="pf-input" name="address" value="<%= values ? values.address : '' %>"></div>
          <div class="pf-field" style="grid-column:1/-1">
            <label>شعار الأكاديمية</label>
            <div class="pf-logo-upload">
              <span class="pf-logo-box">
                <% if (values && values.logo) { %><img src="<%= values.logo %>" alt="logo"><% } else { %><i class="fas fa-building"></i><% } %>
              </span>
              <div class="pf-logo-input">
                <input type="file" name="logo" accept="image/*" class="pf-input" onchange="var p=this.closest('.pf-logo-upload').querySelector('.pf-logo-box');if(this.files&&this.files[0]){var r=new FileReader();r.onload=function(e){p.innerHTML='<img src=\"'+e.target.result+'\" alt=\"logo\">'};r.readAsDataURL(this.files[0]);}">
                <small class="pf-hint">اضغط لاختيار صورة من الكمبيوتر أو الموبايل (JPG / PNG / WebP — حتى 10MB)</small>
              </div>
            </div>
          </div>
        </div>

        <div class="pf-sec-title"><i class="fas fa-credit-card"></i> إعدادات الدفع</div>
        <div class="pf-form-grid" style="margin-top:14px">
          <div class="pf-field"><label>رقم فودافون كاش</label><input class="pf-input" name="vodafone_cash" dir="ltr" value="<%= sett.vodafone_cash || '' %>" style="text-align:left"></div>
          <div class="pf-field"><label>تعليمات الدفع</label><input class="pf-input" name="payment_instructions" value="<%= sett.payment_instructions || '' %>"></div>
        </div>

        <div class="pf-field" style="margin-top:20px"><label>ملاحظات</label><textarea class="pf-input" name="notes" rows="3"><%= values ? values.notes : '' %></textarea></div>

        <div class="pf-form-actions">
          <button class="pf-btn primary lg" type="submit"><i class="fas fa-save"></i> حفظ</button>
          <a href="/platform/academies" class="pf-btn lg"><i class="fas fa-xmark"></i> إلغاء</a>
        </div>
      </form>
      <script>
        window.__validateAcademyForm = function (e) {
          var f = e.target, pass = (f.admin_password || {}).value || '', cnf = f.querySelector('[data-cnf]');
          if (pass || (cnf && cnf.value)) {
            if (pass.length < 4) { alert('كلمة المرور يجب ألا تقل عن 4 أحرف'); e.preventDefault(); return false; }
            if (cnf && pass !== cnf.value) { alert('كلمتا المرور غير متطابقتين'); e.preventDefault(); return false; }
          }
          return true;
        };
      </script>
    </div>
  </div>
</div>
<%- include('../partials/layout_bottom') %>
