<%- include('../partials/layout_top', { title: 'الخصومات والإضافات', active: 'payroll' }) %>
<div class="deductions-page">
<div class="page-head">
  <div>
    <div class="page-title"><i class="fas fa-scale-balanced"></i> الخصومات والإضافات</div>
    <div class="page-sub">تسجيل خصومات أو إضافات (حافز/بدل) على مستحقات المدربين والموظفين</div>
  </div>
  <div class="spacer"></div>
  <div class="flex gap-1" style="flex-wrap:wrap">
    <form method="get" action="/deductions" class="flex gap-1 ded-filter">
      <input type="month" name="month" class="form-control" value="<%= month %>">
      <select name="type" class="form-control">
        <option value="all">الكل</option>
        <option value="deduction" <%= type === 'deduction' ? 'selected' : '' %>>الخصومات</option>
        <option value="bonus" <%= type === 'bonus' ? 'selected' : '' %>>الإضافات</option>
      </select>
      <button class="btn btn-outline" type="submit"><i class="fas fa-magnifying-glass"></i> عرض</button>
    </form>
  </div>
</div>

<div class="grid-2" style="align-items:start">
  <div class="card">
    <div class="card-header"><i class="fas fa-plus-circle"></i> إضافة قيد</div>
    <div class="card-body">
      <form id="adjForm" method="post" novalidate>
        <input type="hidden" name="id" value="">
        <div class="form-grid">
          <div class="form-group">
            <label>الفئة <span class="req">*</span></label>
            <select name="person_type" class="form-control" id="adjPersonType" required>
              <option value="trainer">مدرب</option>
              <option value="staff">موظف</option>
            </select>
          </div>
          <div class="form-group" id="adjCoachWrap">
            <label>المدرب <span class="req">*</span></label>
            <select name="coach_id" class="form-control">
              <option value="">— اختر المدرب —</option>
              <% coaches.forEach(function (c) { %><option value="<%= c.id %>"><%= c.full_name %></option><% }); %>
            </select>
          </div>
          <div class="form-group" id="adjStaffWrap" style="display:none">
            <label>الموظف <span class="req">*</span></label>
            <select name="staff_id" class="form-control">
              <option value="">— اختر الموظف —</option>
              <% staff.forEach(function (s) { %><option value="<%= s.id %>"><%= s.full_name %></option><% }); %>
            </select>
          </div>
          <div class="form-group">
            <label>النوع</label>
            <select name="kind" class="form-control" id="adjKind">
              <option value="deduction">خصم</option>
              <option value="bonus">إضافة / حافز</option>
            </select>
          </div>
          <div class="form-group">
            <label>التصنيف</label>
            <select name="cat" class="form-control" id="adjCat">
              <% D.forEach(function (d) { %><option value="<%= d %>"><%= d %></option><% }); %>
            </select>
          </div>
          <div class="form-group">
            <label>التاريخ</label>
            <input type="date" name="date" class="form-control" value="<%= today %>" required>
          </div>
          <div class="form-group">
            <label>المبلغ <span class="req">*</span></label>
            <input type="number" step="0.01" name="amount" class="form-control" required min="0">
          </div>
          <div class="form-group">
            <label>السبب</label>
            <input type="text" name="reason" class="form-control">
          </div>
          <div class="form-group full">
            <label>ملاحظات</label>
            <input type="text" name="notes" class="form-control">
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-floppy-disk"></i> حفظ</button>
          <button type="reset" class="btn btn-ghost" id="adjReset"><i class="fas fa-rotate-left"></i> إلغاء التعديل</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><i class="fas fa-list"></i> سجل قيود <%= month %></div>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th class="sortable">التاريخ<span class="sort-ind"></span></th><th>الشخص</th><th>النوع</th><th>التصنيف</th><th class="sortable">المبلغ<span class="sort-ind"></span></th><th>السبب</th><th></th></tr></thead>
        <tbody>
          <% if (rows.length) { %>
            <% rows.forEach(function (r) { %>
              <tr>
                <td><%= fmtDate(r.date) %></td>
                <td><b><%= r.coach_name || r.staff_name || '—' %></b></td>
                <td><% if (r.adj_type === 'bonus') { %><span class="badge badge-success"><i class="fas fa-arrow-up"></i> إضافة</span><% } else { %><span class="badge badge-danger"><i class="fas fa-arrow-down"></i> خصم</span><% } %></td>
                <td><%= r.adj_category || '—' %></td>
                <td class="<%= r.adj_type === 'bonus' ? 'text-success fw-700' : 'text-danger fw-700' %>"><%= money(r.amount) %></td>
                <td class="font-12"><%= r.reason || r.notes || '—' %></td>
                <td>
                  <div class="table-actions">
                    <button class="btn btn-ghost btn-sm" data-edit='<%= JSON.stringify(r).replace(/'/g, "&#39;") %>' title="تعديل"><i class="fas fa-pen"></i></button>
                    <form method="POST" action="/deductions/delete/<%= r.id %>" style="display:inline;margin:0"><button type="submit" class="btn btn-ghost btn-sm text-danger" data-confirm="حذف هذا القيد؟" title="حذف"><i class="fas fa-trash"></i></button></form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="7"><div class="empty-state"><i class="fas fa-scale-balanced"></i><p>لا توجد قيود في هذا الشهر</p></div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
(function () {
  var kindEl = document.getElementById('adjKind');
  var catEl = document.getElementById('adjCat');
  var D = <%= JSON.stringify(D) %>, B = <%= JSON.stringify(B) %>;
  function refreshCat() {
    catEl.innerHTML = '';
    (kindEl.value === 'bonus' ? B : D).forEach(function (c) {
      var o = document.createElement('option'); o.value = c; o.textContent = c; catEl.appendChild(o);
    });
  }
  kindEl.addEventListener('change', refreshCat);
  var ptypeEl = document.getElementById('adjPersonType');
  ptypeEl.addEventListener('change', function () {
    document.getElementById('adjCoachWrap').style.display = ptypeEl.value === 'trainer' ? '' : 'none';
    document.getElementById('adjStaffWrap').style.display = ptypeEl.value === 'staff' ? '' : 'none';
  });
  document.querySelectorAll('[data-edit]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var r;
      try { r = JSON.parse(btn.getAttribute('data-edit')); } catch (e) { return; }
      document.querySelector('#adjForm [name="id"]').value = r.id;
      ptypeEl.value = r.person_type || 'trainer'; ptypeEl.dispatchEvent(new Event('change'));
      document.querySelector('#adjForm [name="coach_id"]').value = r.coach_id || '';
      document.querySelector('#adjForm [name="staff_id"]').value = r.staff_id || '';
      kindEl.value = r.adj_type === 'bonus' ? 'bonus' : 'deduction'; refreshCat();
      catEl.value = r.adj_category || ''; if (!catEl.value) catEl.value = catEl.options[0].value;
      document.querySelector('#adjForm [name="date"]').value = String(r.date || '').slice(0, 10);
      document.querySelector('#adjForm [name="amount"]').value = r.amount;
      document.querySelector('#adjForm [name="reason"]').value = r.reason || '';
      document.querySelector('#adjForm [name="notes"]').value = r.notes || '';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
  document.getElementById('adjReset').addEventListener('click', function () {
    document.querySelector('#adjForm [name="id"]').value = '';
  });
  document.getElementById('adjForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var form = e.target;
    var fd = new FormData(form);
    var data = {};
    fd.forEach(function (v, k) { data[k] = v; });
    if (!data.coach_id && data.person_type === 'trainer') { App.showToast('اختر المدرب', 'error'); return; }
    if (!data.staff_id && data.person_type === 'staff') { App.showToast('اختر الموظف', 'error'); return; }
    if (!data.cat) data.cat = kindEl.value === 'bonus' ? 'Bonus' : 'خصم يدوي';
    var btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    fetch('/deductions/save', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data)
    }).then(function (r) { return r.json(); }).then(function (res) {
      btn.disabled = false;
      if (res.ok) { App.showToast('تم الحفظ', 'success'); setTimeout(function () { location.reload(); }, 600); }
      else { App.showToast(res.error || 'فشل الحفظ', 'error'); }
    }).catch(function () { btn.disabled = false; App.showToast('تعذر الاتصال بالخادم', 'error'); });
  });
})();
</script>
<%- include('../partials/layout_bottom') %>
