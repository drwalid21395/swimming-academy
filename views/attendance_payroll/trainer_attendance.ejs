<div class="card" id="trainerAttCard">
  <div class="card-header">
    <h3><i class="fas fa-users"></i> ┘é╪د╪خ┘à╪ر ╪ص╪╢┘ê╪▒ ┘è┘ê┘à <b class="text-primary"><%= fmtDate(date) %></b></h3>
