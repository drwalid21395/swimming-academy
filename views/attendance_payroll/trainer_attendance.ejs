                    <% if (s.time) { %> ┬╖ <i class="fas fa-clock"></i> <b dir="ltr"><%= s.time %></b><% } %>
                  </div>
                </div>
              </div>
            </div>
            <div class="att-btns">
              <% STATUS.forEach(function (st) { %>
                <button class="att-btn <%= (cur || '') === st.value ? clsFor(st.value) : '' %> trainer-status" data-status="<%= st.value %>" data-coach="<%= s.id %>" title="<%= st.label %>"><span><%= st.label %></span></button>
              <% }); %>
            </div>
          </div>
          <div class="flex gap-1" style="flex-wrap:wrap;align-items:center">
            <div class="form-group" style="margin:0"><label class="font-11 text-muted">┘é┘è┘à╪ر ╪د┘╪ص╪╡╪ر (╪ش.┘à)</label><input type="number" step="0.01" class="form-control t-rate" data-coach="<%= s.id %>" style="width:120px" value="<%= s.att && s.att.session_rate != null ? s.att.session_rate : '' %>" placeholder="╪ز┘┘é╪د╪خ┘è"></div>
            <div class="form-group" style="margin:0"><label class="font-11 text-muted">╪»┘é╪د╪خ┘é ╪د┘╪ز╪ث╪«┘è╪▒</label><input type="number" class="form-control t-late" data-coach="<%= s.id %>" style="width:90px" value="<%= s.att && s.att.late_minutes ? s.att.late_minutes : 0 %>"></div>
            <div class="form-group" style="margin:0;min-width:180px"><label class="font-11 text-muted">┘à┘╪د╪ص╪╕╪ر</label><input type="text" class="form-control t-note" data-coach="<%= s.id %>" value="<%= s.att && s.att.note ? s.att.note : '' %>" placeholder="╪د╪«╪ز┘è╪د╪▒┘è╪ر"></div>
          </div>
          <div class="flex gap-1 sub-wrap" data-coach="<%= s.id %>" style="display:<%= cur === '╪ذ╪»┘è┘' ? 'flex' : 'none' %>;flex-wrap:wrap;align-items:center;border-top:1px dashed var(--card-border);padding-top:6px">
            <div class="form-group" style="margin:0;min-width:230px">
              <label class="font-11 text-muted"><i class="fas fa-rotate text-purple"></i> ╪د┘┘à╪»╪▒╪ذ ╪د┘╪ذ╪»┘è┘ ظ¤ ╪ز┘╪╢╪د┘ ┘à╪│╪ز╪ص┘é╪د╪ز ╪د┘╪ص╪╡╪ر ╪╣┘┘è┘ç <span class="req">*</span></label>
              <select class="form-control t-sub" style="min-width:230px">
                <option value="">ظ¤ ╪د╪«╪ز┘╪▒ ╪د┘┘à╪»╪▒╪ذ ╪د┘╪ذ╪»┘è┘ ظ¤</option>
                <% coaches.forEach(function (c) { if (Number(c.id) !== Number(s.id)) { %><option value="<%= c.id %>" <%= s.att && Number(s.att.substitute_coach_id) === Number(c.id) ? 'selected' : '' %>><%= c.full_name %></option><% } }); %>
              </select>
            </div>
            <div class="form-hint" style="margin-top:18px"><i class="fas fa-circle-info"></i> ╪╣┘╪» "┘à╪»╪▒╪ذ ╪ذ╪»┘è┘" ╪ز┘╪│╪ش┘┘ّ┘ ╪د┘╪ص╪╡╪ر ╪ذ╪ز╪د╪▒┘è╪« ┘ê╪ز┘ê┘é┘è╪ز ╪د┘┘è┘ê┘à ┘ê╪ز┘╪╢╪د┘ ┘à╪│╪ز╪ص┘é╪د╪ز┘ç╪د ╪ح┘┘ë ╪▒╪╡┘è╪» ╪د┘┘à╪»╪▒╪ذ ╪د┘╪ذ╪»┘è┘.</div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="empty-state"><i class="fas fa-user-slash"></i><p>┘╪د ┘è┘ê╪ش╪» ┘à╪»╪▒╪ذ┘ê┘ ┘╪┤╪╖┘ê┘</p></div>
    <% } %>
  </div>
</div>

<div class="card">
  <div class="card-header"><i class="fas fa-list"></i> ╪│╪ش┘ ╪ص╪╢┘ê╪▒ ╪┤┘ç╪▒ <b><%= month %></b></div>
  <div class="table-wrap">
    <table class="data-table" id="trainerTable">
      <thead>
        <tr>
          <th class="sortable">╪د┘╪ز╪د╪▒┘è╪«<span class="sort-ind"></span></th>
          <th class="sortable">╪د┘┘à╪ش┘à┘ê╪╣╪ر<span class="sort-ind"></span></th>
          <th class="sortable">╪د┘┘à╪»╪▒╪ذ<span class="sort-ind"></span></th>
          <th>╪د┘┘ê┘é╪ز</th>
          <th class="sortable">╪د┘╪ص╪د┘╪ر<span class="sort-ind"></span></th>
          <th>┘é┘è┘à╪ر ╪د┘╪ص╪╡╪ر</th>
          <th>╪د┘┘à┘╪د╪ص╪╕╪ر</th>
        </tr>
      </thead>
      <tbody>
        <% if (rows.length) { %>
          <% rows.forEach(function (r) { %>
            <% var st = STATUS.find(function (s) { return s.value === r.status; }); %>
            <tr>
              <td><b><%= fmtDate(r.date) %></b></td>
              <td><%= r.group_name || ('╪ص╪╡╪ر #' + r.session_id) %></td>
              <td><b><%= r.coach_name || ('┘à╪»╪▒╪ذ #' + r.coach_id) %></b><% if (r.substitute_name) { %><br><span class="badge badge-purple"><i class="fas fa-rotate"></i> ╪ذ╪»┘è┘: <%= r.substitute_name %></span><% } %></td>
              <td dir="ltr"><%= r.start_time %> ظ¤ <%= r.end_time || '' %></td>
              <td>
                <% if (st) { %><span class="badge <%= st.cls %>"><i class="fas <%= st.icon %>"></i> <%= st.label %></span><% } else { %><span class="badge badge-gray"><%= r.status %></span><% } %>
                <% if (r.late_minutes > 0) { %><span class="badge badge-warning"><%= r.late_minutes %> ╪»</span><% } %>
              </td>
              <td><%= money(r.amount) %></td>
              <td class="text-muted font-12"><%= r.note || 'ظ¤' %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="7"><div class="empty-state"><i class="fas fa-clipboard-user"></i><p>┘╪د ┘è┘ê╪ش╪» ╪ص╪╢┘ê╪▒ ┘à╪│╪ش┘ ┘┘è ┘ç╪░╪د ╪د┘╪┤┘ç╪▒ ظ¤ ╪د╪ذ╪»╪ث ┘à┘ ┘é╪د╪خ┘à╪ر ╪ص╪╢┘ê╪▒ ╪د┘┘è┘ê┘à ╪ث╪╣┘┘ë ╪د┘╪╡┘╪ص╪ر</p></div></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
(function () {
  var card = document.getElementById('trainerAttCard');
  if (!card) return;

  function activeCls(status) {
    return status === '╪ص╪د╪╢╪▒' ? 'active-present' : status === '╪║╪د╪خ╪ذ' ? 'active-absent' : status === '┘à╪╣╪ز╪░╪▒' ? 'active-excused' : status === '┘à╪ز╪ث╪«╪▒' ? 'active-late' : status === '┘à┘╪║╪د╪ر' ? 'active-cancelled' : 'active-substitute';
  }
  function rowOf(btn) { return btn.closest('.att-row'); }

  card.addEventListener('click', function (e) {
    var btn = e.target.closest('.trainer-status');
    if (!btn) return;
    var row = rowOf(btn);
    var status = btn.getAttribute('data-status');
    row.querySelectorAll('.trainer-status').forEach(function (b) { b.className = 'att-btn trainer-status'; });
    btn.className = 'att-btn trainer-status ' + activeCls(status);
    // ╪ح╪╕┘ç╪د╪▒/╪ح╪«┘╪د╪ة ╪ص┘é┘ ╪د┘┘à╪»╪▒╪ذ ╪د┘╪ذ╪»┘è┘
    var coachId = btn.getAttribute('data-coach');
    row.querySelectorAll('.t-sub').forEach(function (sel) { sel.disabled = status !== '╪ذ╪»┘è┘'; });
    var wrap = row.querySelector('.sub-wrap');
    if (wrap && wrap.getAttribute('data-coach') === coachId) wrap.style.display = status === '╪ذ╪»┘è┘' ? 'flex' : 'none';
  });

  card.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-ma]');
    if (!btn) return;
    var st = btn.getAttribute('data-ma');
    var cls = activeCls(st);
    card.querySelectorAll('.att-row').forEach(function (row) {
      var b = row.querySelector('.trainer-status[data-status="' + st + '"]');
      if (!b) return;
      row.querySelectorAll('.trainer-status').forEach(function (x) { x.className = 'att-btn trainer-status'; });
      b.className = 'att-btn trainer-status ' + cls;
      row.querySelectorAll('.sub-wrap').forEach(function (w) { w.style.display = 'none'; });
      row.querySelectorAll('.t-sub').forEach(function (sel) { sel.disabled = true; });
    });
  });

  document.querySelectorAll('.trainer-save-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var statuses = {};
      var missingSub = false;
      card.querySelectorAll('.att-row').forEach(function (row) {
        var st = row.querySelector('.trainer-status');
        if (!st || !st.getAttribute('data-coach')) return;
        var id = st.getAttribute('data-coach');
        var active = row.querySelector('.trainer-status.active-present, .trainer-status.active-absent, .trainer-status.active-excused, .trainer-status.active-late, .trainer-status.active-cancelled, .trainer-status.active-substitute');
        var status = active ? active.getAttribute('data-status') : '╪ص╪د╪╢╪▒';
        var rateEl = row.querySelector('.t-rate');
        var lateEl = row.querySelector('.t-late');
        var noteEl = row.querySelector('.t-note');
        var rec = { status: status };
        if (rateEl) rec.session_rate = rateEl.value;
        if (lateEl) rec.late_minutes = lateEl.value || 0;
        if (noteEl) rec.note = noteEl.value;
        if (status === '╪ذ╪»┘è┘') {
          var sub = row.querySelector('.t-sub');
          if (!sub || !sub.value) { missingSub = true; return; }
          rec.substitute_coach_id = sub.value;
        }
        statuses[id] = rec;
      });
      if (missingSub) { App.showToast('╪د╪«╪ز╪▒ ╪د┘┘à╪»╪▒╪ذ ╪د┘╪ذ╪»┘è┘ ┘┘â┘ ┘à┘ ╪د╪«╪ز┘è╪▒╪ز ╪ص╪د┘╪ز┘ç "┘à╪»╪▒╪ذ ╪ذ╪»┘è┘"', 'error'); return; }
      btn.disabled = true;
      fetch('/trainer-attendance/save-day', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ date: btn.dataset.date, statuses: statuses })
      }).then(function (r) { return r.json(); }).then(function (res) {
        btn.disabled = false;
        if (res.ok) { App.showToast('╪ز┘à ╪ص┘╪╕ ╪ص╪╢┘ê╪▒ ╪د┘┘à╪»╪▒╪ذ┘è┘ (' + (res.count || 0) + ')', 'success'); setTimeout(function () { location.reload(); }, 600); }
        else { App.showToast(res.error || '┘╪┤┘ ╪د┘╪ص┘╪╕', 'error'); }
      }).catch(function () { btn.disabled = false; App.showToast('╪ز╪╣╪░╪▒ ╪د┘╪د╪ز╪╡╪د┘ ╪ذ╪د┘╪«╪د╪»┘à', 'error'); });
    });
  });
})();
</script>
