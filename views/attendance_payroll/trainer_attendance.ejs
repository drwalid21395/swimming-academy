      <div class="att-row" style="border-bottom-width:2px">
        <div class="att-name"><b>╪د┘┘à╪»╪▒╪ذ</b></div>
        <div class="att-btns">
          <% STATUS.forEach(function (st) { %><span class="att-btn att-head" title="<%= st.label %>" style="cursor:default"><span class="font-11"><%= st.label %></span></span><% }); %>
        </div>
      </div>
      <% sheet.forEach(function (s) { %>
        <% var cur = s.att ? s.att.status : ''; %>
        <% function clsFor(v) { return v === '╪ص╪د╪╢╪▒' ? 'active-present' : v === '╪║╪د╪خ╪ذ' ? 'active-absent' : v === '┘à╪╣╪ز╪░╪▒' ? 'active-excused' : v === '┘à╪ز╪ث╪«╪▒' ? 'active-late' : v === '┘à┘╪║╪د╪ر' ? 'active-cancelled' : v === '╪ذ╪»┘è┘' ? 'active-substitute' : ''; } %>
        <div class="att-row" style="flex-direction:column;align-items:stretch;gap:6px">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
            <div class="att-name" style="flex:1">
              <div class="flex items-center gap-1">
                <div class="avatar-sm"><%= (s.full_name || '┘à').trim().charAt(0) %></div>
                <div>
                  <b><%= s.full_name %></b>
                  <div class="font-11 text-muted">
