  <div class="card-body">
    <% if (sheet.length) { %>
      <div class="flex gap-1" style="margin-bottom:14px;flex-wrap:wrap">
        <% if (canAdd) { %>
          <button class="btn btn-success btn-sm" data-ma="╪ص╪د╪╢╪▒"><i class="fas fa-check"></i> ╪د┘┘â┘ ╪ص╪د╪╢╪▒</button>
          <button class="btn btn-outline-danger btn-sm" data-ma="╪║╪د╪خ╪ذ"><i class="fas fa-xmark"></i> ╪د┘┘â┘ ╪║╪د╪خ╪ذ</button>
          <button class="btn btn-outline-warning btn-sm" data-ma="┘à╪╣╪ز╪░╪▒"><i class="fas fa-book"></i> ╪د┘┘â┘ ┘à╪╣╪ز╪░╪▒</button>
          <button class="btn btn-outline-primary btn-sm" data-ma="┘à╪ز╪ث╪«╪▒"><i class="fas fa-clock"></i> ╪د┘┘â┘ ┘à╪ز╪ث╪«╪▒</button>
          <button class="btn btn-primary btn-sm trainer-save-btn" data-date="<%= date %>"><i class="fas fa-floppy-disk"></i> ╪ص┘╪╕ ╪د┘╪ص╪╢┘ê╪▒</button>
